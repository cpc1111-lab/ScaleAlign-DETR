+# ------------------------------------------------------------------------
+# RF-DETR
+# Copyright (c) 2025 Roboflow. All Rights Reserved.
+# Licensed under the Apache License, Version 2.0 [see LICENSE for details]
+# ------------------------------------------------------------------------
+"""Preflight and launch the local ScaleAlign RF-DETR-2XL Adapter-FT COCO run."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+from pathlib import Path
+from typing import TYPE_CHECKING
+
+import torch
+from rfdetr_plus.models import RFDETR2XLargeConfig
+from torch import nn
+
+from rfdetr.config import TrainConfig
+from scripts.run_equal_budget import _git_commit, load_run_config, validate_coco
+
+if TYPE_CHECKING:
+    from rfdetr.config import ModelConfig
+
+ROOT = Path(__file__).resolve().parents[1]
+CONFIG = ROOT / "configs/scalealign/rfdetr_2xl_esm_sgqg_coco_local.yaml"
+COCO_ROOT = Path("data/coco")
+CHECKPOINT = ROOT / "weights/rf-detr-xxlarge.pth"
+OUTPUT_DIR = ROOT / "experiments/scalealign_2xl/adapter_30k"
+OFFICIAL_CHECKPOINT_MD5 = "e3204689c1f0280427e4c33e6a2ac6cd"
+ADAPTER_TRAIN_SAMPLES = 30_000
+ADAPTER_TRAINABLE_MARKERS = ("scalealign", "class_embed", "bbox_embed")
+
+
+def load_training_configs(resume: Path | None = None) -> tuple[RFDETR2XLargeConfig, TrainConfig]:
+    """Materialize the fixed YAML through its concrete Pydantic config types."""
+    raw = load_run_config(CONFIG)["model"]
+    model = raw["model_config"]
+    train = raw["train_config"]
+    if model.get("class_path") != "rfdetr_plus.models.RFDETR2XLargeConfig":
+        raise ValueError("local config must use RFDETR2XLargeConfig")
+    if train.get("class_path") != "rfdetr.config.TrainConfig":
+        raise ValueError("local config must use TrainConfig")
+    train_args = dict(train["init_args"])
+    if resume is not None:
+        train_args["resume"] = str(resume)
+    return RFDETR2XLargeConfig(**model["init_args"]), TrainConfig(**train_args)
+
+
+def validate_checkpoint(path: Path) -> str:
+    """Require the registered official RF-DETR-2XL checkpoint and return its MD5."""
+    if not path.is_file():
+        raise ValueError(f"official checkpoint does not exist: {path}")
+    digest = hashlib.md5(usedforsecurity=False)
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    actual = digest.hexdigest()
+    if actual != OFFICIAL_CHECKPOINT_MD5:
+        raise ValueError(f"official checkpoint MD5 mismatch: expected {OFFICIAL_CHECKPOINT_MD5}, found {actual}")
+    return actual
+
+
+def require_cuda(*, cuda_available: bool, dry_run: bool, allow_no_cuda: bool) -> None:
+    """Reject CPU training while allowing an explicit dry-run-only bypass."""
+    if allow_no_cuda and not dry_run:
+        raise ValueError("--allow-no-cuda is valid only with --dry-run")
+    if not cuda_available and not (dry_run and allow_no_cuda):
+        raise RuntimeError("CUDA is required for RF-DETR-2XL training")
+
+
+def validate_coco_label_space(dataset_dir: Path, *, num_classes: int) -> dict[str, int]:
+    """Require native COCO category IDs to fit the model's sparse output slots."""
+    category_ids: set[int] = set()
+    for split in ("train", "val"):
+        path = dataset_dir / f"annotations/instances_{split}2017.json"
+        with path.open(encoding="utf-8") as stream:
+            annotation = json.load(stream)
+        category_ids.update(int(category["id"]) for category in annotation.get("categories", []))
+
+    if not category_ids:
+        raise ValueError("COCO annotations do not declare any categories")
+    minimum = min(category_ids)
+    maximum = max(category_ids)
+    if minimum < 0 or maximum > num_classes:
+        raise ValueError(
+            f"native COCO category ID {maximum} does not fit model num_classes={num_classes}; "
+            "use 90 slots for the official sparse COCO IDs"
+        )
+    return {"min": minimum, "max": maximum, "count": len(category_ids)}
+
+
+def resolve_resume_checkpoint(output_dir: Path, *, resume: bool) -> Path | None:
+    """Protect existing outputs and resolve the only valid resume checkpoint."""
+    if resume:
+        last = output_dir / "last.ckpt"
+        if not last.is_file():
+            raise ValueError(f"resume checkpoint does not exist: {last}")
+        return last
+    if output_dir.exists():
+        entries = {path.name for path in output_dir.iterdir()}
+        if entries - {"run_metadata.json"}:
+            raise ValueError(f"output exists; pass --resume explicitly: {output_dir}")
+    return None
+
+
+def configure_adapter_finetune(model: nn.Module) -> dict[str, int]:
+    """Freeze the pretrained detector except ScaleAlign and detection heads."""
+    total_parameters = 0
+    trainable_parameters = 0
+    trainable_tensors = 0
+    for name, parameter in model.named_parameters():
+        parameter.requires_grad = any(marker in name for marker in ADAPTER_TRAINABLE_MARKERS)
+        total_parameters += parameter.numel()
+        if parameter.requires_grad:
+            trainable_parameters += parameter.numel()
+            trainable_tensors += 1
+    if trainable_parameters == 0:
+        raise RuntimeError("Adapter-FT policy did not select any trainable parameters")
+    return {
+        "total_parameters": total_parameters,
+        "trainable_parameters": trainable_parameters,
+        "trainable_tensors": trainable_tensors,
+    }
+
+
+def run_training(model_config: ModelConfig, train_config: TrainConfig) -> None:
+    """Run the supported RF-DETR trainer stack with the fixed Adapter-FT budget."""
+    from rfdetr.training.module_data import RFDETRDataModule
+    from rfdetr.training.module_model import RFDETRModelModule
+    from rfdetr.training.trainer import build_trainer
+
+    module = RFDETRModelModule(model_config, train_config)
+    adapter_stats = configure_adapter_finetune(module.model)
+    if not isinstance(train_config.batch_size, int):
+        raise ValueError("Adapter-FT requires a concrete integer batch_size")
+    limit_train_batches = math.ceil(ADAPTER_TRAIN_SAMPLES / train_config.batch_size)
+    datamodule = RFDETRDataModule(model_config, train_config)
+    print(json.dumps({"adapter_finetune": adapter_stats, "train_samples": ADAPTER_TRAIN_SAMPLES}))
+    trainer = build_trainer(train_config, model_config, limit_train_batches=limit_train_batches)
+    trainer.fit(module, datamodule, ckpt_path=train_config.resume or None)
+
+
+def main() -> None:
+    """Validate fixed local inputs, record provenance, and start training."""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--allow-no-cuda", action="store_true")
+    parser.add_argument("--resume", action="store_true")
+    args = parser.parse_args()
+
+    require_cuda(
+        cuda_available=torch.cuda.is_available(),
+        dry_run=args.dry_run,
+        allow_no_cuda=args.allow_no_cuda,
+    )
+    counts = validate_coco(COCO_ROOT)
+    checkpoint_md5 = validate_checkpoint(CHECKPOINT)
+    resume_checkpoint = resolve_resume_checkpoint(OUTPUT_DIR, resume=args.resume)
+    model_config, train_config = load_training_configs(resume_checkpoint)
+    category_id_range = validate_coco_label_space(COCO_ROOT, num_classes=model_config.num_classes)
+    metadata = {
+        "command": [str(Path(__file__).resolve()), *(["--resume"] if args.resume else [])],
+        "config": load_run_config(CONFIG),
+        "dataset": str(COCO_ROOT),
+        "coco_image_counts": counts,
+        "coco_category_ids": category_id_range,
+        "checkpoint": str(CHECKPOINT),
+        "checkpoint_md5": checkpoint_md5,
+        "git_commit": _git_commit(),
+        "torch_version": torch.__version__,
+        "cuda_version": torch.version.cuda,
+        "cuda_available": torch.cuda.is_available(),
+        "cuda_device_count": torch.cuda.device_count(),
+    }
+    if torch.cuda.is_available():
+        metadata["cuda_device"] = torch.cuda.get_device_name(0)
+
+    if args.dry_run:
+        print(json.dumps(metadata, indent=2))
+        return
+
+    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
+    (OUTPUT_DIR / "run_metadata.json").write_text(json.dumps(metadata, indent=2), encoding="utf-8")
+    run_training(model_config, train_config)
+
+
+if __name__ == "__main__":
+    main()
