+def implementation_identity() -> dict[str, Any]:
+    """Fingerprint committed and local tracked-code state while ignoring run outputs."""
+    commit = _git_commit()
+    status = subprocess.check_output(
+        ["git", "status", "--porcelain=v1", "--untracked-files=all", "--", *_IMPLEMENTATION_PATHS],
+        cwd=ROOT,
+        text=True,
+    )
+    changed_paths = sorted(line[3:] for line in status.splitlines() if len(line) > 3)
+    digest = hashlib.sha256()
+    diff = subprocess.check_output(
+        ["git", "diff", "--binary", "HEAD", "--", *_IMPLEMENTATION_PATHS],
+        cwd=ROOT,
+    )
+    digest.update(diff)
+    for line in status.splitlines():
+        if not line.startswith("?? "):
+            continue
+        relative = line[3:]
+        path = ROOT / relative
+        if path.is_file():
+            digest.update(relative.encode("utf-8"))
+            digest.update(path.read_bytes())
+    return {
+        "commit": commit,
+        "dirty": bool(changed_paths),
+        "diff_sha256": digest.hexdigest(),
+        "changed_paths": changed_paths,
+    }
