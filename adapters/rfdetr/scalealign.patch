+        if not hasattr(source, "shape") or source.shape != target_base.shape:
+            source_shape = tuple(source.shape) if hasattr(source, "shape") else None
+            raise ValueError(
+                f"released P4 base-attention shape mismatch for {base_key!r}: "
+                f"checkpoint={source_shape}, target={tuple(target_base.shape)}"
+            )
+        auxiliary_target = model_state[auxiliary_key]
+        if source.ndim != auxiliary_target.ndim or source.shape[1:] != auxiliary_target.shape[1:]:
+            raise ValueError(
+                f"auxiliary attention shape incompatible for {auxiliary_key!r}: "
+                f"base={tuple(source.shape)}, target={tuple(auxiliary_target.shape)}"
+            )
+        point_width = 2 if ".aux_sampling_offsets." in auxiliary_key else 1
+        expected_base_rows = n_heads * n_points * point_width
+        if source.shape[0] != expected_base_rows:
+            raise ValueError(
+                f"base attention layout mismatch for {base_key!r}: rows={source.shape[0]}, "
+                f"expected n_heads={n_heads} * n_points={n_points} * width={point_width}"
+            )
+        if auxiliary_target.shape[0] % expected_base_rows != 0:
+            raise ValueError(
+                f"auxiliary attention leading dimension is not a whole-level repeat for {auxiliary_key!r}: "
+                f"base={tuple(source.shape)}, target={tuple(auxiliary_target.shape)}"
+            )
+        auxiliary_levels = auxiliary_target.shape[0] // expected_base_rows
+        trailing_shape = source.shape[1:]
