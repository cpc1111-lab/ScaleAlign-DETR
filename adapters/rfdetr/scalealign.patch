+++ b/scripts/run_equal_budget.py
@@ -0,0 +1,201 @@
+# ------------------------------------------------------------------------
+# RF-DETR
+# Copyright (c) 2025 Roboflow. All Rights Reserved.
+# Licensed under the Apache License, Version 2.0 [see LICENSE for details]
+# ------------------------------------------------------------------------
+"""Validate and launch matched RF-DETR-2XL COCO continuation runs."""
+
+from __future__ import annotations
+
+import argparse
+import copy
+import hashlib
+import importlib.metadata
+import json
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+import torch
+import yaml
+
+ROOT = Path(__file__).resolve().parents[1]
+CONFIGS = {
+    "baseline": ROOT / "configs/scalealign/rfdetr_2xl_baseline_coco.yaml",
+    "scalealign": ROOT / "configs/scalealign/rfdetr_2xl_esm_sgqg_coco.yaml",
+}
+EXPECTED_IMAGES = {"train": 118_287, "val": 5_000}
+
+
+def load_run_config(path: Path) -> dict[str, Any]:
+    """Load a Lightning YAML run definition.
+
+    Args:
+        path: Configuration file path.
+
+    Returns:
+        Parsed configuration mapping.
+    """
+    with path.open(encoding="utf-8") as stream:
+        value = yaml.safe_load(stream)
+    if not isinstance(value, dict):
+        raise ValueError(f"config must contain a mapping: {path}")
+    return value
+
+
+def assert_equal_budget(baseline: dict[str, Any], improved: dict[str, Any]) -> None:
+    """Reject paired configurations with non-treatment differences.
+
+    Args:
+        baseline: Official continuation configuration.
+        improved: ScaleAlign continuation configuration.
+
+    Raises:
+        ValueError: If anything besides ScaleAlign and output directory differs.
+    """
+    left = copy.deepcopy(baseline)
+    right = copy.deepcopy(improved)
+    for config in (left, right):
+        model_args = config["model"]["model_config"]["init_args"]
+        model_args.pop("scalealign", None)
+        train_args = config["model"]["train_config"]["init_args"]
+        train_args.pop("output_dir", None)
+    if left != right:
+        raise ValueError("equal-budget configs differ outside scalealign and output_dir")
+
+
+def validate_coco(dataset_dir: Path) -> dict[str, int]:
+    """Validate official COCO 2017 layout and annotation image counts.
+
+    Args:
+        dataset_dir: COCO root containing image directories and annotations.
+
+    Returns:
+        Validated train and validation image counts.
+
+    Raises:
+        ValueError: If paths are missing or JSON record counts are not official.
+    """
+    required = [
+        dataset_dir / "train2017",
+        dataset_dir / "val2017",
+        dataset_dir / "annotations/instances_train2017.json",
+        dataset_dir / "annotations/instances_val2017.json",
+    ]
+    missing = [str(path) for path in required if not path.exists()]
+    if missing:
+        raise ValueError("missing COCO 2017 paths: " + ", ".join(missing))
+
+    counts: dict[str, int] = {}
+    for split, expected in EXPECTED_IMAGES.items():
+        annotation_path = dataset_dir / f"annotations/instances_{split}2017.json"
+        with annotation_path.open(encoding="utf-8") as stream:
+            annotation = json.load(stream)
+        count = len(annotation.get("images", []))
+        if count != expected:
+            raise ValueError(f"COCO {split}2017 must contain {expected} image records, found {count}")
+        counts[split] = count
+    return counts
+
+
+def _sha256(path: Path) -> str:
+    """Compute a file SHA-256 without loading it fully into memory."""
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _git_commit() -> str:
+    """Return the checked-out RF-DETR commit."""
+    return subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
+
+
+def _command(
+    branch: str,
+    dataset_dir: Path,
+    checkpoint: Path,
+    output_dir: Path,
+    resume: Path | None = None,
+) -> list[str]:
+    """Build a shell-free Lightning CLI command for one treatment branch."""
+    command = [
+        sys.executable,
+        "-m",
+        "rfdetr",
+        "fit",
+        "--config",
+        str(CONFIGS[branch]),
+        "--model.model_config.init_args.pretrain_weights",
+        str(checkpoint),
+        "--model.train_config.init_args.dataset_dir",
+        str(dataset_dir),
+        "--model.train_config.init_args.output_dir",
+        str(output_dir),
+    ]
+    if resume is not None:
+        command.extend(["--model.train_config.init_args.resume", str(resume)])
+    return command
+
+
+def main() -> None:
+    """Parse arguments, run preflight, record provenance, and launch branches."""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--dataset-dir", type=Path, required=True)
+    parser.add_argument("--checkpoint", type=Path, required=True)
+    parser.add_argument("--branch", choices=("baseline", "scalealign", "both"), default="both")
+    parser.add_argument("--output-root", type=Path, default=ROOT / "experiments/scalealign_2xl")
+    parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--resume", action="store_true")
+    args = parser.parse_args()
+
+    counts = validate_coco(args.dataset_dir.resolve())
+    checkpoint = args.checkpoint.resolve()
+    if not checkpoint.is_file():
+        raise ValueError(f"checkpoint does not exist: {checkpoint}")
+    baseline = load_run_config(CONFIGS["baseline"])
+    improved = load_run_config(CONFIGS["scalealign"])
+    assert_equal_budget(baseline, improved)
+    checkpoint_hash = _sha256(checkpoint)
+    branches = ["baseline", "scalealign"] if args.branch == "both" else [args.branch]
+
+    for branch in branches:
+        output_dir = args.output_root.resolve() / branch
+        if output_dir.exists() and any(output_dir.iterdir()) and not args.resume:
+            raise ValueError(f"output exists; pass --resume explicitly: {output_dir}")
+        resume_checkpoint = output_dir / "last.ckpt" if args.resume else None
+        if resume_checkpoint is not None and not resume_checkpoint.is_file():
+            raise ValueError(f"resume checkpoint does not exist: {resume_checkpoint}")
+        command = _command(
+            branch,
+            args.dataset_dir.resolve(),
+            checkpoint,
+            output_dir,
+            resume=resume_checkpoint,
+        )
+        if args.dry_run:
+            print(json.dumps({"branch": branch, "command": command, "checkpoint_sha256": checkpoint_hash}))
+            continue
+
+        output_dir.mkdir(parents=True, exist_ok=True)
+        metadata = {
+            "branch": branch,
+            "command": command,
+            "checkpoint": str(checkpoint),
+            "checkpoint_sha256": checkpoint_hash,
+            "coco_image_counts": counts,
+            "git_commit": _git_commit(),
+            "rfdetr_plus_version": importlib.metadata.version("rfdetr-plus"),
+            "torch_version": torch.__version__,
+            "cuda_available": torch.cuda.is_available(),
+            "cuda_device_count": torch.cuda.device_count(),
+            "config": load_run_config(CONFIGS[branch]),
+        }
+        (output_dir / "run_metadata.json").write_text(json.dumps(metadata, indent=2), encoding="utf-8")
+        subprocess.run(command, cwd=ROOT, check=True)
+
+
+if __name__ == "__main__":
+    main()
