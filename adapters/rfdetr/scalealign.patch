+    scales_by_layer = decoder.scalealign_layer_log_scales
+    if len(boxes_by_layer) != len(decoder.layers) or len(scales_by_layer) != len(decoder.layers):
+        raise ValueError("latest forward did not retain refreshed state for every decoder layer")
+
+    attention_layers: list[dict[str, Tensor]] = []
+    for layer, boxes, log_scale in zip(decoder.layers, boxes_by_layer, scales_by_layer):
+        attention = layer.cross_attn
+        saa = layer.scalealign_attention
+        if (
+            attention.last_sampling_locations is None
+            or attention.last_attention_logits is None
+            or attention.last_attention_weights is None
+            or saa is None
+        ):
+            raise ValueError("latest forward did not retain complete SAA attention diagnostics")
+        attention_layers.append(
+            {
+                "boxes": _cpu(boxes),
+                "query_log_scale": _cpu(log_scale),
+                "sampling_locations": _cpu(attention.last_sampling_locations),
+                "pre_saa_logits": _cpu(attention.last_attention_logits),
+                "attention_weights": _cpu(attention.last_attention_weights),
+                "log_strides": _cpu(saa.log_strides),
+            }
+        )
+
+    target_boxes = [_cpu(target["boxes"]) for target in targets]
+    return {
+        "proposals": _cpu(diagnostics.selected_boxes),
+        "targets": target_boxes,
+        "qcd": _cpu(diagnostics.qcd),
+        "pre_sgqg_proposals": _cpu(diagnostics.official_boxes),
+        "post_sgqg_proposals": _cpu(diagnostics.selected_boxes),
+        "candidate_pool": _cpu(diagnostics.candidate_boxes),
+        "selected_sgqg_indices": _cpu(diagnostics.indices),
+        "pre_sgqg_qcd": _cpu(diagnostics.official_qcd),
+        "post_sgqg_qcd": _cpu(diagnostics.qcd),
+        "attention_layers": attention_layers,
+    }
+
+
+class ScaleAlignDiagnosticShardWriter(Callback):
+    """Write at most ``max_batches`` detached one-capture validation shards."""
+
+    def __init__(self, output_dir: Path, max_batches: int = 16) -> None:
+        super().__init__()
+        if max_batches < 1:
+            raise ValueError("max_batches must be positive")
+        self.output_dir = output_dir
+        self.max_batches = max_batches
+        self._written = 0
+        self._next_index = 0
+
+    def setup(self, trainer: Any, pl_module: Any, stage: str) -> None:
+        del pl_module
+        if stage not in {"fit", "validate"} or not getattr(trainer, "is_global_zero", True):
+            return
+        self.output_dir.mkdir(parents=True, exist_ok=True)
+        existing = sorted(self.output_dir.glob("capture-*.pt"))
+        self._written = len(existing)
+        if existing:
+            self._next_index = max(int(path.stem.rsplit("-", 1)[1]) for path in existing) + 1
+
+    def on_validation_batch_end(
+        self,
+        trainer: Any,
+        pl_module: Any,
+        outputs: Any,
+        batch: tuple[Any, list[dict[str, Tensor]]],
+        batch_idx: int,
+        dataloader_idx: int = 0,
+    ) -> None:
+        del outputs, batch_idx, dataloader_idx
+        if (
+            getattr(trainer, "sanity_checking", False)
+            or not getattr(trainer, "is_global_zero", True)
+            or self._written >= self.max_batches
+        ):
+            return
+        _, targets = batch
+        capture = build_scalealign_capture(pl_module.model, targets)
+        destination = self.output_dir / f"capture-{self._next_index:06d}.pt"
+        temporary = destination.with_name(f".{destination.name}.{os.getpid()}.tmp")
+        torch.save(capture, temporary)
+        temporary.replace(destination)
+        self._written += 1
+        self._next_index += 1
+        del capture
