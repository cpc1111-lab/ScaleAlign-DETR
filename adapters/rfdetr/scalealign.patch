+# ------------------------------------------------------------------------
+# RF-DETR
+# Copyright (c) 2025 Roboflow. All Rights Reserved.
+# Licensed under the Apache License, Version 2.0 [see LICENSE for details]
+# ------------------------------------------------------------------------
+"""Tests for scale-guided query selection."""
+
+import pytest
+import torch
+
+from rfdetr.scalealign import ScaleGuidedQueryGenerator
+
+
+def _make_boxes(scales: list[float]) -> torch.Tensor:
+    """Create centered square ``cxcywh`` boxes from normalized scales.
+
+    Examples:
+        >>> _make_boxes([0.1, 0.2]).shape
+        torch.Size([1, 2, 4])
+
+    Args:
+        scales: Normalized side lengths.
+
+    Returns:
+        Batched square boxes with one batch element.
+    """
+    scale = torch.tensor(scales)
+    centers = torch.full((len(scales), 2), 0.5)
+    return torch.cat((centers, scale[:, None].expand(-1, 2)), dim=-1).unsqueeze(0)
+
+
+def test_zero_coverage_matches_torch_topk_exactly() -> None:
+    """The zero-weight branch must preserve upstream selection exactly."""
+    scores = torch.tensor([[0.2, 0.9, 0.4, 0.8]])
+    boxes = _make_boxes([0.05, 0.10, 0.20, 0.40])
+
+    result = ScaleGuidedQueryGenerator(num_anchors=4, temperature=0.25)(scores, boxes, k=3, coverage_weight=0.0)
+
+    expected = torch.topk(scores, 3, dim=1).indices
+    torch.testing.assert_close(result.indices, expected)
+
+
+def test_selection_is_deterministic_and_keeps_requested_budget() -> None:
+    """Repeated greedy calls must return the same fixed-size selection."""
+    selector = ScaleGuidedQueryGenerator(num_anchors=4, temperature=0.2)
+    scores = torch.tensor([[0.9, 0.8, 0.7, 0.6, 0.5]])
+    boxes = _make_boxes([0.02, 0.04, 0.08, 0.2, 0.6])
+
+    first = selector(scores, boxes, k=3, coverage_weight=2.0)
+    second = selector(scores, boxes, k=3, coverage_weight=2.0)
+
+    torch.testing.assert_close(first.indices, second.indices)
+    assert first.indices.shape == (1, 3)
+    assert first.indices.unique().numel() == 3
+
+
+def test_scale_guidance_reduces_qcd_for_skewed_confidence() -> None:
+    """Coverage pressure should reduce divergence on a skewed proposal pool."""
+    scores = torch.tensor([[9.0, 8.0, 7.0, 6.0, 5.9, 5.8]])
+    boxes = _make_boxes([0.03, 0.03, 0.03, 0.03, 0.3, 0.6])
+    selector = ScaleGuidedQueryGenerator(num_anchors=4, temperature=0.1)
+
+    topk = selector(scores, boxes, k=3, coverage_weight=0.0)
+    guided = selector(scores, boxes, k=3, coverage_weight=4.0)
+
+    assert guided.qcd.item() < topk.qcd.item()
+
+
+@pytest.mark.parametrize("k", [0, 5])
+def test_invalid_query_budget_is_rejected(k: int) -> None:
+    """The selector must reject empty and oversized query budgets."""
+    selector = ScaleGuidedQueryGenerator(num_anchors=4, temperature=0.25)
+
+    with pytest.raises(ValueError, match="number of candidates"):
+        selector(torch.ones(1, 4), _make_boxes([0.1] * 4), k=k, coverage_weight=1.0)
