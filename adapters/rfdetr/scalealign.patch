+# ------------------------------------------------------------------------
+# RF-DETR
+# Copyright (c) 2025 Roboflow. All Rights Reserved.
+# Licensed under the Apache License, Version 2.0 [see LICENSE for details]
+# ------------------------------------------------------------------------
+"""Tests for ScaleAlign proposal and attention diagnostics."""
+
+import pytest
+import torch
+
+from rfdetr.models.ops.modules.ms_deform_attn import MSDeformAttn
+from rfdetr.scalealign import box_attention_misalignment, proposal_recall_at_k
+
+
+def test_proposal_recall_is_scale_stratified() -> None:
+    """Recall must expose correct overall, small, and large partitions."""
+    proposals = torch.tensor([[[0.3, 0.3, 0.02, 0.02], [0.7, 0.7, 0.2, 0.2]]])
+    targets = [torch.tensor([[0.3, 0.3, 0.02, 0.02], [0.7, 0.7, 0.2, 0.2]])]
+
+    recall = proposal_recall_at_k(proposals, targets, image_size=880, iou_threshold=0.5)
+
+    assert recall.overall == pytest.approx(1.0)
+    assert recall.small == pytest.approx(1.0)
+    assert recall.large == pytest.approx(1.0)
+    assert recall.small_count == 1
+    assert recall.large_count == 1
+
+
+def test_proposal_recall_counts_missed_target() -> None:
+    """An unmatched target must reduce recall without changing its denominator."""
+    proposals = torch.tensor([[[0.1, 0.1, 0.02, 0.02]]])
+    targets = [torch.tensor([[0.8, 0.8, 0.02, 0.02]])]
+
+    recall = proposal_recall_at_k(proposals, targets, image_size=880, iou_threshold=0.5)
+
+    assert recall.overall == pytest.approx(0.0)
+    assert recall.overall_count == 1
+
+
+def test_bam_is_zero_for_samples_inside_box() -> None:
+    """All attention mass inside the predicted box has zero misalignment."""
+    boxes = torch.tensor([[[0.5, 0.5, 0.4, 0.4]]])
+    samples = torch.tensor([[[[[[0.5, 0.5], [0.6, 0.6]]]]]])
+    weights = torch.tensor([[[[[0.4, 0.6]]]]])
+
+    assert box_attention_misalignment(boxes, samples, weights).item() == pytest.approx(0.0)
+
+
+def test_bam_returns_attention_mass_outside_box() -> None:
+    """BAM must equal normalized attention mass sampled outside the box."""
+    boxes = torch.tensor([[[0.5, 0.5, 0.2, 0.2]]])
+    samples = torch.tensor([[[[[[0.5, 0.5], [0.9, 0.9]]]]]])
