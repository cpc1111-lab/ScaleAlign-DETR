+    assert [name for name, _ in module._student_trainable_named_parameters()] == ["alpha", "zeta"]
+
+    def all_reduce(tensor):
+        collective_inputs.append(tensor.item())
+        call_index = len(collective_inputs) - 1
+        if call_index == 0:  # remote-only alpha participation
+            tensor.add_(1.0)
+        elif call_index == 1:
+            tensor.add_(8.0)
+        elif call_index == 2:  # both ranks participate for zeta
+            tensor.add_(1.0)
+        elif call_index == 3:
+            tensor.add_(4.0)
+
+    with (
+        patch("torch.distributed.is_available", return_value=True),
+        patch("torch.distributed.is_initialized", return_value=True),
+        patch("torch.distributed.get_world_size", return_value=2),
+        patch("torch.distributed.all_reduce", side_effect=all_reduce),
+    ):
+        module._merge_accumulated_distillation_gradients()
+
+    assert collective_inputs == [0.0, 0.0, 1.0, 2.0]
+    assert student.alpha.grad.item() == 4.0
+    assert student.zeta.grad.item() == 3.0
+
+
+def test_ddp_distillation_merge_ignores_captured_dict_insertion_order(tmp_path) -> None:
+    module, _, _, _ = _module(tmp_path, ScaleAlignConfig())
+    student = _TwoParameterModel()
+    module.model = student
+    module.train_config.grad_accum_steps = 1
+    module._accumulated_distillation_microbatches = 1
+    module._accumulated_distillation_gradients = {
+        student.zeta: torch.tensor(2.0),
+        student.alpha: torch.tensor(1.0),
+    }
+    collective_inputs = []
+    assert [name for name, _ in module._student_trainable_named_parameters()] == ["alpha", "zeta"]
+
+    with (
+        patch("torch.distributed.is_available", return_value=True),
+        patch("torch.distributed.is_initialized", return_value=True),
+        patch("torch.distributed.get_world_size", return_value=1),
+        patch("torch.distributed.all_reduce", side_effect=lambda tensor: collective_inputs.append(tensor.item())),
+    ):
+        module._merge_accumulated_distillation_gradients()
+
+    assert collective_inputs == [1.0, 1.0, 1.0, 2.0]
+
+
+def test_ddp_globally_absent_distillation_grad_preserves_none_and_optimizer_state(tmp_path) -> None:
+    module, _, _, _ = _module(tmp_path, ScaleAlignConfig())
+    student = _TwoParameterModel()
+    module.model = student
+    module.train_config.grad_accum_steps = 1
+    module._accumulated_distillation_microbatches = 1
+    module._accumulated_distillation_gradients = {}
+    initial = {name: parameter.detach().clone() for name, parameter in student.named_parameters()}
+    optimizer = torch.optim.AdamW(student.parameters(), lr=0.1, weight_decay=0.5)
+    collective_inputs = []
+
+    with (
+        patch("torch.distributed.is_available", return_value=True),
+        patch("torch.distributed.is_initialized", return_value=True),
+        patch("torch.distributed.get_world_size", return_value=2),
+        patch("torch.distributed.all_reduce", side_effect=lambda tensor: collective_inputs.append(tensor.item())),
+    ):
+        module._merge_accumulated_distillation_gradients()
+    optimizer.step()
+
+    assert collective_inputs == [0.0, 0.0, 0.0, 0.0]
+    assert all(parameter.grad is None for parameter in student.parameters())
+    assert not optimizer.state
+    for name, parameter in student.named_parameters():
+        torch.testing.assert_close(parameter, initial[name])
+
+
