+"""Tests for ScaleAlign optimizer and official-checkpoint compatibility."""
+
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+import torch
+from torch import nn
+
+from rfdetr.models.backbone import Joiner
+from rfdetr.models.transformer import Transformer
+from rfdetr.models.weights import _warn_on_partial_load
+from rfdetr.scalealign import ScaleAlignConfig
+from rfdetr.training.param_groups import get_param_dict
+
+
+class _BackboneStub(nn.Module):
+    """Minimal backbone exposing RF-DETR's parameter-group API."""
+
+    def __init__(self) -> None:
+        """Create one trainable backbone tensor."""
+        super().__init__()
+        self.weight = nn.Parameter(torch.ones(1))
+
+    def get_named_param_lr_pairs(self, args: SimpleNamespace, prefix: str) -> dict[str, dict[str, object]]:
+        """Return the single backbone parameter at encoder rate.
+
+        Args:
+            args: Optimizer arguments.
+            prefix: Namespace prefix assigned by the detector.
+
+        Returns:
+            Mapping compatible with ``get_param_dict``.
+        """
+        return {f"{prefix}.weight": {"params": self.weight, "lr": args.lr_encoder}}
+
+
+class _ModelStub(nn.Module):
+    """Small model containing backbone, decoder, and ScaleAlign parameters."""
+
+    def __init__(self, enabled: bool) -> None:
+        """Build the grouping fixture.
+
+        Args:
+            enabled: Whether to construct ScaleAlign parameters.
+        """
+        super().__init__()
+        self.backbone = Joiner(_BackboneStub(), nn.Identity())  # type: ignore[arg-type]
+        self.transformer = Transformer(
+            d_model=8,
+            sa_nhead=2,
+            ca_nhead=2,
+            num_queries=2,
+            num_decoder_layers=1,
+            num_feature_levels=1,
+            dec_n_points=1,
+            scalealign=ScaleAlignConfig(enabled=enabled),
+        )
+        self.head = nn.Linear(8, 1)
+
+
+def _optimizer_args() -> SimpleNamespace:
+    """Return optimizer rates used by grouping tests.
+
+    Examples:
+        >>> _optimizer_args().lr_component_decay
+        0.5
+
+    Returns:
+        Minimal optimizer namespace.
+    """
+    return SimpleNamespace(lr=1e-4, lr_encoder=1e-5, lr_component_decay=0.5)
+
+
+def test_scalealign_parameters_use_decoder_rate_once() -> None:
+    """Every ScaleAlign tensor must occur once at the decoder learning rate."""
+    model = _ModelStub(enabled=True)
+    args = _optimizer_args()
+
+    groups = get_param_dict(args, model)
+    flattened = [group["params"] for group in groups]
+    scale_ids = {id(parameter) for name, parameter in model.named_parameters() if "scalealign" in name}
+
+    assert len(flattened) == len({id(parameter) for parameter in flattened})
+    assert scale_ids
+    for group in groups:
+        if id(group["params"]) in scale_ids:
