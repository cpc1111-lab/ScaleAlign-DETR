+    output_dir.mkdir()
+    last = output_dir / "last.ckpt"
+    last.touch()
+
+    resume = resolve_resume_checkpoint(output_dir, resume=True)
+    _, train_config = load_training_configs(resume)
+
+    assert resume == last
+    assert train_config.resume == str(last)
