+# ------------------------------------------------------------------------
+# RF-DETR
+# Copyright (c) 2025 Roboflow. All Rights Reserved.
+# Licensed under the Apache License, Version 2.0 [see LICENSE for details]
+# ------------------------------------------------------------------------
+"""Benchmark matched RF-DETR-2XL checkpoints with synchronized PyTorch CUDA timing."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import statistics
+import time
+from pathlib import Path
+from typing import Any
+
+import torch
+
+
+def _percentile(values: list[float], probability: float) -> float:
+    """Return a linearly interpolated percentile for a nonempty sample."""
+    ordered = sorted(values)
+    position = probability * (len(ordered) - 1)
+    lower = int(position)
+    upper = min(lower + 1, len(ordered) - 1)
+    fraction = position - lower
+    return ordered[lower] * (1.0 - fraction) + ordered[upper] * fraction
+
+
+def latency_summary(milliseconds: list[float]) -> dict[str, float]:
+    """Summarize synchronized per-batch latency samples.
+
+    Args:
+        milliseconds: Nonempty latency samples in milliseconds.
+
+    Returns:
+        Mean, median, and 95th-percentile latency.
+
+    Raises:
+        ValueError: If no samples are supplied.
+    """
+    if not milliseconds:
+        raise ValueError("latency samples cannot be empty")
+    return {
+        "mean_ms": statistics.fmean(milliseconds),
+        "p50_ms": _percentile(milliseconds, 0.50),
+        "p95_ms": _percentile(milliseconds, 0.95),
+    }
+
+
+def validate_benchmark_pair(baseline: dict[str, int], scalealign: dict[str, int]) -> None:
+    """Require identical fixed-format inputs for a latency comparison.
+
+    Args:
+        baseline: Baseline shape metadata.
+        scalealign: Treatment shape metadata.
+
+    Raises:
+        ValueError: If resolution or batch size differs.
+    """
+    for key in ("resolution", "batch_size"):
+        if baseline[key] != scalealign[key]:
+            raise ValueError(f"benchmark {key} must match between branches")
+
+
+def _load_model(checkpoint: Path, enabled: bool) -> torch.nn.Module:
+    """Build fixed RF-DETR-2XL and load one trusted local checkpoint."""
+    from rfdetr_plus.models import RFDETR2XLargeConfig
+
+    from rfdetr.config import TrainConfig
+    from rfdetr.models.lwdetr import build_model_from_config
+    from rfdetr.models.weights import load_pretrain_weights
+
+    config = RFDETR2XLargeConfig(
+        pretrain_weights=str(checkpoint),
+        device="cuda",
+        scalealign={"enabled": enabled, "diagnostics": False, "saa_enabled": False},
+    )
+    model = build_model_from_config(config, TrainConfig(dataset_dir=".", output_dir="."))
+    load_pretrain_weights(model, config, trust=True)
+    return model.eval().cuda()
+
+
+@torch.inference_mode()
+def _benchmark(model: torch.nn.Module, warmups: int, iterations: int) -> dict[str, Any]:
+    """Measure one model with synchronized FP16 batch-one 880-square inference."""
+    inputs = torch.randn(1, 3, 880, 880, device="cuda")
+    for _ in range(warmups):
+        with torch.autocast("cuda", dtype=torch.float16):
+            model(inputs)
+    torch.cuda.synchronize()
+    torch.cuda.reset_peak_memory_stats()
+
+    samples: list[float] = []
+    for _ in range(iterations):
+        torch.cuda.synchronize()
+        start = time.perf_counter()
+        with torch.autocast("cuda", dtype=torch.float16):
+            model(inputs)
+        torch.cuda.synchronize()
+        samples.append((time.perf_counter() - start) * 1000.0)
+
+    return {
+        **latency_summary(samples),
+        "parameters": sum(parameter.numel() for parameter in model.parameters()),
+        "peak_memory_bytes": torch.cuda.max_memory_allocated(),
+        "warmups": warmups,
+        "iterations": iterations,
+        "batch_size": 1,
+        "resolution": 880,
+        "precision": "fp16-autocast",
+        "latency_kind": "PyTorch eager synchronized CUDA latency",
+    }
+
+
+def main() -> None:
+    """Benchmark baseline and ScaleAlign checkpoints and write JSON."""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--baseline-checkpoint", type=Path, required=True)
+    parser.add_argument("--scalealign-checkpoint", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--warmups", type=int, default=100)
+    parser.add_argument("--iterations", type=int, default=500)
+    args = parser.parse_args()
+    if not torch.cuda.is_available():
+        raise RuntimeError("CUDA is required; CPU latency is not comparable to the RF-DETR protocol")
+    if args.warmups < 0 or args.iterations <= 0:
+        raise ValueError("warmups must be nonnegative and iterations must be positive")
+
+    baseline = _benchmark(_load_model(args.baseline_checkpoint.resolve(), False), args.warmups, args.iterations)
+    scalealign = _benchmark(_load_model(args.scalealign_checkpoint.resolve(), True), args.warmups, args.iterations)
+    validate_benchmark_pair(baseline, scalealign)
+    result = {
+        "baseline": baseline,
+        "scalealign": scalealign,
+        "torch_version": torch.__version__,
+        "cuda_version": torch.version.cuda,
+        "device": torch.cuda.get_device_name(0),
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, indent=2), encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
