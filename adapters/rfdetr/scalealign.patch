+def test_backward_keeps_published_weights_frozen_and_reaches_adapters() -> None:
+    model = _CompactModel(include_scalealign=True)
+    configure_scalealign_ms_finetune(model, 1, True)
+    assert model.transformer.scalealign_query_gate is not None
+    assert model.transformer.scalealign_content_gate is not None
+    model.transformer.scalealign_query_gate.data.fill_(1.0)
+    model.transformer.scalealign_content_gate.data.fill_(1.0)
+
+    model.adapter_loss().backward()
+
+    frozen = [parameter for parameter in model.parameters() if not parameter.requires_grad]
+    trainable = [parameter for parameter in model.parameters() if parameter.requires_grad]
+    assert all(parameter.grad is None for parameter in frozen)
+    assert trainable and all(parameter.grad is not None for parameter in trainable)
