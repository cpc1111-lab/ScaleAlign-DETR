+        module.automatic_optimization = False
+        module.train_config.grad_accum_steps = 2
+        module.criterion = _ZeroBoxNormalizedCriterion()
+        module.manual_backward = lambda loss, **kwargs: loss.backward(**kwargs)
+        module.lr_schedulers = MagicMock(return_value=None)
+        module._trainer.gradient_clip_val = 0.0
+        module._trainer.gradient_clip_algorithm = "norm"
+        module._trainer.num_training_batches = 2
+        for batch_idx, (pixel_value, box_count) in enumerate(zip((0.0, 1.0), box_counts, strict=True)):
+            samples = NestedTensor(
+                torch.full((1, 3, 4, 4), pixel_value),
+                torch.zeros(1, 4, 4, dtype=torch.bool),
+            )
+            targets = [{"labels": torch.ones(box_count, dtype=torch.long)}]
+            module.training_step((samples, targets), batch_idx)
+        return student.weight.detach().clone()
