+            "attention_layers": [
+                {
+                    "boxes": boxes,
+                    "sampling_locations": torch.full((batch_size, 2, 1, 2, 1, 2), 0.5),
+                    "query_log_scale": torch.tensor([[-2.0, -1.0]]).expand(batch_size, -1),
+                    "pre_saa_logits": torch.zeros_like(weights),
