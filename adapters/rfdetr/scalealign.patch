+# ------------------------------------------------------------------------
+# RF-DETR
+# Copyright (c) 2025 Roboflow. All Rights Reserved.
+# Licensed under the Apache License, Version 2.0 [see LICENSE for details]
+# ------------------------------------------------------------------------
+"""Decoder integration tests for ScaleAlign state refresh and SAA routing."""
+
+import pytest
+import torch
+from torch import nn
+
+from rfdetr.models.math import inverse_sigmoid
+from rfdetr.models.transformer import Transformer, TransformerDecoder
+from rfdetr.scalealign import ExplicitScaleModel, ScaleAlignConfig, ScaleState
+
+
+def _config(*, bbox_reparam: bool = True) -> ScaleAlignConfig:
+    del bbox_reparam
+    return ScaleAlignConfig(
+        enabled=True,
+        query_injection=False,
+        content_injection=False,
+        saa_enabled=True,
+        scale_dim=8,
+        saa_rank=4,
+        saa_init_beta=-1.0,
+        feature_strides=[8.0, 16.0],
+        pretrained_level_index=0,
+    )
+
+
+def _build_decoder(*, layers: int = 3, bbox_reparam: bool = True) -> tuple[Transformer, nn.Linear]:
+    transformer = Transformer(
+        d_model=8,
+        num_queries=2,
+        num_decoder_layers=layers,
+        sa_nhead=2,
+        ca_nhead=2,
+        dim_feedforward=16,
+        num_feature_levels=2,
+        dec_n_points=1,
+        return_intermediate_dec=True,
+        lite_refpoint_refine=True,
+        two_stage=True,
+        bbox_reparam=bbox_reparam,
+        scalealign=_config(bbox_reparam=bbox_reparam),
+    )
+    box_head = nn.Linear(8, 4)
+    return transformer, box_head
+
+
+def _run_decoder(
+    decoder: TransformerDecoder,
+    esm: ExplicitScaleModel,
+    box_head: nn.Module,
+    boxes: torch.Tensor,
+) -> tuple[torch.Tensor, ScaleState]:
+    initial_state = esm(boxes)
+    output = decoder(
+        torch.randn(1, 2, 8, requires_grad=True),
+        torch.randn(1, 2, 8),
+        refpoints_unsigmoid=boxes.detach() if decoder.bbox_reparam else inverse_sigmoid(boxes.detach()),
+        spatial_shapes=torch.tensor([[1, 1], [1, 1]]),
+        spatial_shapes_hw=[(1, 1), (1, 1)],
+        level_start_index=torch.tensor([0, 1]),
+        valid_ratios=torch.ones(1, 2, 2),
+        initial_scale_state=initial_state,
+        initial_scale_boxes=boxes,
+        scale_state_model=esm,
+        scalealign_bbox_embed=box_head,
+    )
+    assert isinstance(output, tuple)
+    return output[0], initial_state
+
+
+def test_decoder_builds_layer_specific_saa_and_split_attention() -> None:
+    transformer, _ = _build_decoder()
+    saa_modules = [layer.scalealign_attention for layer in transformer.decoder.layers]
+
+    assert all(module is not None for module in saa_modules)
+    assert len({id(module) for module in saa_modules}) == 3
+    assert all(layer.cross_attn.pretrained_level_index == 0 for layer in transformer.decoder.layers)
+    assert transformer.scalealign_state is not None
+
+
+@pytest.mark.parametrize("bbox_reparam", [False, True])
+def test_each_layer_refreshes_state_against_fixed_initial_boxes(bbox_reparam: bool) -> None:
+    transformer, box_head = _build_decoder(bbox_reparam=bbox_reparam)
+    assert transformer.scalealign_state is not None
+    boxes = torch.tensor([[[0.4, 0.5, 0.2, 0.3], [0.6, 0.5, 0.4, 0.2]]])
+    saa_inputs: list[torch.Tensor] = []
+    refresh_boxes: list[torch.Tensor] = []
+    sampling_refs: list[torch.Tensor] = []
+    for layer in transformer.decoder.layers:
+        assert layer.scalealign_attention is not None
+        layer.scalealign_attention.register_forward_pre_hook(lambda _module, args: saa_inputs.append(args[0]))
+        layer.cross_attn.register_forward_pre_hook(lambda _module, args: sampling_refs.append(args[1]))
+    transformer.scalealign_state.register_forward_pre_hook(lambda _module, args: refresh_boxes.append(args[0]))
+
+    hs, initial_state = _run_decoder(transformer.decoder, transformer.scalealign_state, box_head, boxes)
+
+    assert len(saa_inputs) == 3
+    assert saa_inputs[0] is initial_state.embedding
+    assert len(refresh_boxes) == 3  # initial state plus one refresh after layers 0 and 1
+    for layer_id in range(2):
+        base = boxes
+        delta = box_head(hs[layer_id]).detach()
+        if bbox_reparam:
+            expected_xy = delta[..., :2] * base[..., 2:] + base[..., :2]
+            expected_wh = delta[..., 2:].exp() * base[..., 2:]
+            expected = torch.cat((expected_xy, expected_wh), -1)
+        else:
+            expected = (delta + inverse_sigmoid(base)).sigmoid()
+        torch.testing.assert_close(refresh_boxes[layer_id + 1], expected)
+    assert all(torch.equal(reference, sampling_refs[0]) for reference in sampling_refs[1:])
+
+
+def test_bbox_changes_affect_later_bias_and_route_has_no_geometry_or_head_gradients() -> None:
+    transformer, box_head = _build_decoder(layers=2)
+    assert transformer.scalealign_state is not None
+    boxes = torch.tensor([[[0.4, 0.5, 0.2, 0.3], [0.6, 0.5, 0.4, 0.2]]], requires_grad=True)
+    biases: list[torch.Tensor] = []
+    for layer in transformer.decoder.layers:
+        assert layer.scalealign_attention is not None
+        layer.scalealign_attention.register_forward_hook(lambda _module, _args, output: biases.append(output))
+
+    torch.manual_seed(101)
+    hs, _ = _run_decoder(transformer.decoder, transformer.scalealign_state, box_head, boxes)
+    hs.square().sum().backward()
+
+    assert len(biases) == 2
+    assert not torch.equal(biases[0], biases[1])
+    assert boxes.grad is None
+    assert all(parameter.grad is None for parameter in box_head.parameters())
+    assert any(parameter.grad is not None for parameter in transformer.scalealign_state.parameters())
+    saa_parameters = [
+        parameter for layer in transformer.decoder.layers for parameter in layer.scalealign_attention.parameters()
+    ]
+    assert any(parameter.grad is not None and parameter.grad.abs().sum() > 0 for parameter in saa_parameters)
+
+    original = biases[1].detach().clone()
+    with torch.no_grad():
+        box_head.bias[2:].add_(1.0)
+    biases.clear()
+    torch.manual_seed(101)
+    _run_decoder(transformer.decoder, transformer.scalealign_state, box_head, boxes)
+    assert not torch.equal(biases[1], original)
+
+
+def test_shared_bbox_head_is_not_registered_by_decoder() -> None:
+    transformer, box_head = _build_decoder(layers=2)
+
+    decoder_parameter_ids = {id(parameter) for parameter in transformer.decoder.parameters()}
+    assert all(id(parameter) not in decoder_parameter_ids for parameter in box_head.parameters())
+    assert not any("scalealign_bbox" in key for key in transformer.decoder.state_dict())
+
+
+def test_saa_dependencies_fail_before_attention() -> None:
+    transformer, _ = _build_decoder(layers=2)
+    called = False
+
+    def mark_called(_module: nn.Module, _args: tuple[torch.Tensor, ...]) -> None:
+        nonlocal called
+        called = True
+
+    transformer.decoder.layers[0].cross_attn.register_forward_pre_hook(mark_called)
+    boxes = torch.full((1, 2, 4), 0.25)
+    with pytest.raises(RuntimeError, match="SAA decoder requires.*scale state model.*bbox head"):
+        transformer.decoder(
+            torch.randn(1, 2, 8),
+            torch.randn(1, 2, 8),
+            refpoints_unsigmoid=boxes,
+            spatial_shapes=torch.tensor([[1, 1], [1, 1]]),
+            level_start_index=torch.tensor([0, 1]),
+            valid_ratios=torch.ones(1, 2, 2),
+        )
+    assert not called
+
+
+def test_disabled_path_has_no_saa_parameters_or_behavior_change() -> None:
+    torch.manual_seed(91)
+    baseline = Transformer(d_model=8, num_decoder_layers=2, sa_nhead=2, ca_nhead=2, num_feature_levels=2)
+    torch.manual_seed(91)
+    disabled = Transformer(
+        d_model=8,
+        num_decoder_layers=2,
+        sa_nhead=2,
+        ca_nhead=2,
+        num_feature_levels=2,
+        scalealign=ScaleAlignConfig(),
+    )
+
+    assert not any("scalealign_attention" in name for name, _ in disabled.named_parameters())
+    for key, value in baseline.state_dict().items():
+        assert torch.equal(value, disabled.state_dict()[key]), key
