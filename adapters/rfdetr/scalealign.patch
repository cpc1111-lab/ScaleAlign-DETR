+
+@pytest.mark.parametrize(
+    "feature_strides",
+    [
+        pytest.param([0.0, 20.0], id="zero"),
+        pytest.param([-10.0, 20.0], id="negative"),
+        pytest.param([10.0, 10.0], id="duplicate"),
+        pytest.param([20.0, 10.0], id="decreasing"),
+    ],
+)
+def test_saa_rejects_nonpositive_or_unordered_feature_strides(feature_strides: list[float]) -> None:
+    """SAA feature strides must be positive and strictly increasing."""
+    with pytest.raises(ValidationError, match="positive and strictly increasing"):
+        RFDETRSmallConfig(
+            projector_scale=["P3", "P5"],
+            scalealign={
+                "enabled": True,
+                "saa_enabled": True,
+                "feature_strides": feature_strides,
+            },
+        )
+
+
+def test_saa_rejects_pretrained_level_index_outside_projector_levels() -> None:
+    """The pretrained feature level must identify an existing projector level."""
+    with pytest.raises(ValidationError, match="pretrained_level_index must identify"):
+        RFDETRSmallConfig(
+            projector_scale=["P3", "P5"],
