+# ------------------------------------------------------------------------
+# RF-DETR
+# Copyright (c) 2025 Roboflow. All Rights Reserved.
+# Licensed under the Apache License, Version 2.0 [see LICENSE for details]
+# ------------------------------------------------------------------------
+"""Integration tests for ScaleAlign in RF-DETR's two-stage transformer."""
+
+import copy
+
+import pytest
+import torch
+from torch import nn
+
+from rfdetr.models.transformer import Transformer
+from rfdetr.scalealign import ScaleAlignConfig, ScaleState
+
+
+class _CaptureDecoder(nn.Module):
+    """Capture the decoder inputs while preserving the transformer's output contract."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.tgt: torch.Tensor | None = None
+        self.refpoints: torch.Tensor | None = None
+        self.initial_scale_state: ScaleState | None = None
+        self.initial_scale_boxes: torch.Tensor | None = None
+        self.scale_state_model: nn.Module | None = None
+        self.scalealign_bbox_embed: nn.Module | None = None
+
+    def forward(
+        self,
+        tgt: torch.Tensor,
+        memory: torch.Tensor,
+        **kwargs: object,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        del memory
+        self.tgt = tgt
+        initial_scale_state = kwargs.get("initial_scale_state")
+        assert initial_scale_state is None or isinstance(initial_scale_state, ScaleState)
+        self.initial_scale_state = initial_scale_state
+        initial_scale_boxes = kwargs.get("initial_scale_boxes")
+        assert initial_scale_boxes is None or isinstance(initial_scale_boxes, torch.Tensor)
+        self.initial_scale_boxes = initial_scale_boxes
+        scale_state_model = kwargs.get("scale_state_model")
+        assert scale_state_model is None or isinstance(scale_state_model, nn.Module)
+        object.__setattr__(self, "scale_state_model", scale_state_model)
+        scalealign_bbox_embed = kwargs.get("scalealign_bbox_embed")
+        assert scalealign_bbox_embed is None or isinstance(scalealign_bbox_embed, nn.Module)
+        object.__setattr__(self, "scalealign_bbox_embed", scalealign_bbox_embed)
+        refpoints = kwargs["refpoints_unsigmoid"]
+        assert isinstance(refpoints, torch.Tensor)
+        self.refpoints = refpoints
+        return tgt.unsqueeze(0), refpoints.unsqueeze(0)
+
+
+def _build_transformer(
+    config: ScaleAlignConfig,
+    *,
+    group_detr: int = 1,
+    num_feature_levels: int = 1,
+    num_registers: int = 0,
+    bbox_reparam: bool = True,
+) -> Transformer:
+    """Build a small two-stage transformer for CPU tests.
+
+    Examples:
+        >>> _build_transformer(ScaleAlignConfig()).num_queries
+        2
+
+    Args:
+        config: ScaleAlign configuration under test.
+
+    Returns:
+        Transformer with initialized encoder proposal heads.
+    """
+    transformer = Transformer(
+        d_model=8,
+        num_queries=2,
+        num_decoder_layers=1,
+        sa_nhead=2,
+        ca_nhead=2,
+        num_feature_levels=num_feature_levels,
+        dec_n_points=1,
+        return_intermediate_dec=True,
+        lite_refpoint_refine=True,
+        two_stage=True,
+        bbox_reparam=bbox_reparam,
+        group_detr=group_detr,
+        num_registers=num_registers,
+        scalealign=config,
+    )
+    transformer.enc_out_class_embed = nn.ModuleList([nn.Linear(8, 3) for _ in range(group_detr)])
+    transformer.enc_out_bbox_embed = nn.ModuleList([nn.Linear(8, 4) for _ in range(group_detr)])
+    return transformer
+
+
+def _configure_deterministic_selection(transformer: Transformer) -> _CaptureDecoder:
+    """Make candidate channel zero determine selection and capture initial queries."""
+    for projection in transformer.enc_output:
+        nn.init.eye_(projection.weight)
+        nn.init.zeros_(projection.bias)
+    transformer.enc_output_norm = nn.ModuleList([nn.Identity() for _ in transformer.enc_output])
+    assert transformer.enc_out_class_embed is not None
+    assert transformer.enc_out_bbox_embed is not None
+    for classifier in transformer.enc_out_class_embed:
+        assert isinstance(classifier, nn.Linear)
+        nn.init.zeros_(classifier.weight)
+        nn.init.zeros_(classifier.bias)
+        with torch.no_grad():
+            classifier.weight[0, 0] = 1.0
+    for box_head in transformer.enc_out_bbox_embed:
+        assert isinstance(box_head, nn.Linear)
+        nn.init.zeros_(box_head.weight)
+        nn.init.zeros_(box_head.bias)
+    decoder = _CaptureDecoder()
+    transformer.decoder = decoder
+    return decoder
+
+
+def _run_deterministic_forward(
+    transformer: Transformer,
+    src: torch.Tensor,
+    *,
+    query_count: int | None = None,
+    refpoint_residual: torch.Tensor | None = None,
+    scalealign_bbox_embed: nn.Module | None = None,
+) -> tuple[torch.Tensor | None, ...]:
+    count = query_count if query_count is not None else transformer.num_queries * transformer.group_detr
+    if refpoint_residual is None:
+        refpoint_residual = torch.zeros(count, 4)
+    srcs = [src]
+    for _ in range(1, transformer.num_feature_levels):
+        srcs.append(torch.zeros(src.shape[0], src.shape[1], 1, 1, dtype=src.dtype, device=src.device))
+    return transformer(
+        srcs,
+        [torch.zeros(level.shape[0], level.shape[2], level.shape[3], dtype=torch.bool) for level in srcs],
+        [torch.zeros_like(level) for level in srcs],
+        refpoint_residual,
+        torch.zeros(count, transformer.d_model),
+        scalealign_bbox_embed=scalealign_bbox_embed,
+    )
+
+
+def _assert_exact_nested(actual: object, expected: object) -> None:
+    """Assert exact equality for nested tensor output structures."""
+    assert type(actual) is type(expected)
+    if isinstance(actual, torch.Tensor):
+        assert isinstance(expected, torch.Tensor)
+        assert torch.equal(actual, expected)
+    elif isinstance(actual, tuple):
+        assert isinstance(expected, tuple)
+        assert len(actual) == len(expected)
+        for actual_item, expected_item in zip(actual, expected):
+            _assert_exact_nested(actual_item, expected_item)
+    else:
+        assert actual is expected
+
+
+def _run_forward(transformer: Transformer) -> tuple[torch.Tensor | None, ...]:
+    """Run a minimal single-level forward pass.
+
+    Examples:
+        >>> len(_run_forward(_build_transformer(ScaleAlignConfig())))
+        4
+
+    Args:
+        transformer: Initialized transformer under test.
+
+    Returns:
+        The transformer's unchanged output tuple.
+    """
+    return transformer(
+        [torch.randn(1, 8, 2, 2)],
+        [torch.zeros(1, 2, 2, dtype=torch.bool)],
+        [torch.randn(1, 8, 2, 2)],
+        torch.zeros(2, 4),
+        torch.randn(2, 8),
+    )
+
+
+def test_disabled_transformer_has_no_scalealign_parameters() -> None:
+    """Disabled ScaleAlign must preserve the upstream parameter set."""
+    transformer = _build_transformer(ScaleAlignConfig())
+
+    assert not any("scalealign" in name for name, _ in transformer.named_parameters())
+
+
+def test_content_parameters_only_exist_when_content_injection_is_enabled() -> None:
+    """Content projection and gate must follow both ScaleAlign feature switches."""
+    enabled = _build_transformer(ScaleAlignConfig(enabled=True, content_injection=True))
+    no_content = _build_transformer(ScaleAlignConfig(enabled=True, content_injection=False))
+
+    assert enabled.scalealign_content_projection is not None
+    assert enabled.scalealign_content_gate is not None
+    assert enabled.scalealign_content_gate.item() == 0.0
+    assert not any("scalealign_content" in name for name, _ in no_content.named_parameters())
+
+
+def test_enabled_transformer_starts_from_official_selection() -> None:
+    """Warmup progress zero must use official Top-K and a closed injection gate."""
+    transformer = _build_transformer(ScaleAlignConfig(enabled=True, diagnostics=True))
+    transformer.set_scalealign_progress(0.0)
+
+    outputs = _run_forward(transformer)
+    diagnostics = transformer.scalealign_diagnostics
+
+    assert diagnostics is not None
+    torch.testing.assert_close(diagnostics.indices, diagnostics.official_topk_indices)
+    assert outputs[0] is not None
+    assert outputs[0].shape[2] == transformer.num_queries
+    assert transformer.scalealign_query_gate is not None
+    assert transformer.scalealign_query_gate.item() == 0.0
+
+
+def test_decoder_layers_share_stride_encoder_but_keep_layer_specific_saa_heads() -> None:
+    transformer = Transformer(
+        d_model=8,
+        num_queries=2,
+        num_decoder_layers=3,
+        sa_nhead=2,
+        ca_nhead=2,
+        num_feature_levels=3,
+        dec_n_points=1,
+        return_intermediate_dec=True,
+        lite_refpoint_refine=True,
+        two_stage=True,
+        bbox_reparam=True,
+        scalealign=ScaleAlignConfig(
+            enabled=True,
+            saa_enabled=True,
+            feature_strides=[8.0, 16.0, 32.0],
+            pretrained_level_index=1,
+        ),
+    )
+    attentions = [layer.scalealign_attention for layer in transformer.decoder.layers]
+    assert all(attention is not None for attention in attentions)
+    shared = transformer.decoder.scalealign_stride_encoder
+
+    assert shared is not None
+    assert all(attention.stride_encoder is shared for attention in attentions if attention is not None)
+    assert len({id(attention.query_projection) for attention in attentions if attention is not None}) == 3
+    assert len({id(attention.level_projection) for attention in attentions if attention is not None}) == 3
+    assert len({id(attention.beta) for attention in attentions if attention is not None}) == 3
+    first = attentions[0]
+    assert first is not None
+    assert not torch.equal(first.query_projection.weight, first.level_projection.weight)
+    assert [name for name in transformer.state_dict() if "stride_encoder" in name] == [
+        "decoder.scalealign_stride_encoder.0.weight",
+        "decoder.scalealign_stride_encoder.0.bias",
+        "decoder.scalealign_stride_encoder.2.weight",
+        "decoder.scalealign_stride_encoder.2.bias",
+    ]
+
+    embeddings = [torch.randn(1, 2, 64, requires_grad=True) for _ in attentions]
+    sum(
+        attention(embedding).square().sum() for attention, embedding in zip(attentions, embeddings) if attention
+    ).backward()
+    assert all(parameter.grad is not None for parameter in shared.parameters())
+    assert all(torch.count_nonzero(parameter.grad) > 0 for parameter in shared.parameters())
+
+
+def test_matched_control_and_treatment_preserve_common_initialization_under_same_seed() -> None:
+    common = dict(
+        d_model=8,
+        num_queries=2,
+        num_decoder_layers=2,
+        sa_nhead=2,
+        ca_nhead=2,
+        num_feature_levels=3,
+        dec_n_points=1,
+        return_intermediate_dec=True,
+        lite_refpoint_refine=True,
+        two_stage=True,
+        bbox_reparam=True,
+    )
+    torch.manual_seed(123)
+    control = Transformer(
+        **common,
+        scalealign=ScaleAlignConfig(
+            enabled=False,
+            query_injection=False,
+            content_injection=False,
+            saa_enabled=False,
+            feature_strides=[8.0, 16.0, 32.0],
+            pretrained_level_index=1,
+        ),
+    )
+    torch.manual_seed(123)
+    treatment = Transformer(
+        **common,
+        scalealign=ScaleAlignConfig(
+            enabled=True,
+            query_injection=True,
+            content_injection=True,
+            saa_enabled=True,
+            feature_strides=[8.0, 16.0, 32.0],
+            pretrained_level_index=1,
+        ),
+    )
+
+    control_state = control.state_dict()
+    treatment_state = treatment.state_dict()
+    shared_names = sorted(name for name in control_state if name in treatment_state and "scalealign" not in name)
+    assert shared_names
+    for name in shared_names:
+        torch.testing.assert_close(treatment_state[name], control_state[name], rtol=0, atol=0, msg=name)
+
+
+def test_selected_content_is_injected_in_group_order_and_unselected_content_is_ignored() -> None:
+    """Each SGQG gather must bind to the corresponding group-local initial query."""
+    transformer = _build_transformer(
+        ScaleAlignConfig(enabled=True, query_injection=False, content_injection=True), group_detr=2
+    )
+    decoder = _configure_deterministic_selection(transformer)
+    assert transformer.scalealign_content_projection is not None
+    assert transformer.scalealign_content_gate is not None
+    nn.init.eye_(transformer.scalealign_content_projection.weight)
+    nn.init.zeros_(transformer.scalealign_content_projection.bias)
+    with torch.no_grad():
+        transformer.scalealign_content_gate.fill_(1.0)
+        transformer.enc_output[1].weight[1, 1] = 2.0
+    src = torch.zeros(1, 8, 2, 2)
+    src[0, 0] = torch.tensor([[1.0, 4.0], [3.0, 2.0]])
+    src[0, 1] = torch.tensor([[10.0, 40.0], [30.0, 20.0]])
+
+    _run_deterministic_forward(transformer, src)
+
+    assert decoder.tgt is not None
+    expected_group_zero = src.flatten(2).transpose(1, 2)[:, [1, 2]]
+    expected_group_one = expected_group_zero.clone()
+    expected_group_one[..., 1] *= 2.0
+    torch.testing.assert_close(decoder.tgt, torch.cat([expected_group_zero, expected_group_one], dim=1))
+
+    changed_unselected = src.clone()
+    changed_unselected[0, 1, 0, 0] = -1000.0
+    changed_unselected[0, 1, 1, 1] = 1000.0
+    _run_deterministic_forward(transformer, changed_unselected)
+    assert decoder.tgt is not None
+    torch.testing.assert_close(decoder.tgt, torch.cat([expected_group_zero, expected_group_one], dim=1))
+
+
+def test_selected_content_uses_one_group_during_inference() -> None:
+    transformer = _build_transformer(
+        ScaleAlignConfig(enabled=True, query_injection=False, content_injection=True), group_detr=2
+    )
+    decoder = _configure_deterministic_selection(transformer)
+    transformer.eval()
+    assert transformer.scalealign_content_projection is not None
+    assert transformer.scalealign_content_gate is not None
+    nn.init.eye_(transformer.scalealign_content_projection.weight)
+    nn.init.zeros_(transformer.scalealign_content_projection.bias)
+    with torch.no_grad():
+        transformer.scalealign_content_gate.fill_(1.0)
+    src = torch.zeros(1, 8, 2, 2)
+    src[0, 0] = torch.tensor([[1.0, 4.0], [3.0, 2.0]])
+
+    _run_deterministic_forward(transformer, src, query_count=transformer.num_queries)
+
+    assert decoder.tgt is not None
+    expected = src.flatten(2).transpose(1, 2)[:, [1, 2]]
+    torch.testing.assert_close(decoder.tgt, expected)
+
+
+def test_selected_content_change_only_updates_matching_initial_query() -> None:
+    transformer = _build_transformer(ScaleAlignConfig(enabled=True, query_injection=False))
+    decoder = _configure_deterministic_selection(transformer)
+    assert transformer.scalealign_content_projection is not None
+    assert transformer.scalealign_content_gate is not None
+    nn.init.eye_(transformer.scalealign_content_projection.weight)
+    nn.init.zeros_(transformer.scalealign_content_projection.bias)
+    with torch.no_grad():
+        transformer.scalealign_content_gate.fill_(1.0)
+    src = torch.zeros(1, 8, 2, 2)
+    src[0, 0] = torch.tensor([[1.0, 4.0], [3.0, 2.0]])
+    _run_deterministic_forward(transformer, src)
+    assert decoder.tgt is not None
+    baseline = decoder.tgt.detach().clone()
+
+    changed = src.clone()
+    changed[0, 1, 0, 1] = 7.0
+    _run_deterministic_forward(transformer, changed)
+
+    assert decoder.tgt is not None
+    torch.testing.assert_close(decoder.tgt[:, 1], baseline[:, 1])
+    assert decoder.tgt[0, 0, 1].item() == pytest.approx(7.0)
+
+
+def test_content_injection_rejects_too_few_initial_query_slots() -> None:
+    transformer = _build_transformer(ScaleAlignConfig(enabled=True, query_injection=False))
+    _configure_deterministic_selection(transformer)
+    src = torch.zeros(1, 8, 2, 2)
+    src[0, 0] = torch.tensor([[1.0, 4.0], [3.0, 2.0]])
+
+    with pytest.raises(ValueError, match="selected encoder content.*initial decoder queries"):
+        _run_deterministic_forward(transformer, src, query_count=1)
+
+
+def test_zero_content_gate_preserves_decoder_inputs_and_outputs() -> None:
+    torch.manual_seed(123)
+    transformer = _build_transformer(ScaleAlignConfig(enabled=True, query_injection=False, content_injection=True))
+    torch.manual_seed(123)
+    baseline = _build_transformer(ScaleAlignConfig(enabled=True, query_injection=False, content_injection=False))
+    transformer_state = transformer.state_dict()
+    baseline_state = baseline.state_dict()
+    common_keys = transformer_state.keys() & baseline_state.keys()
+    assert common_keys
+    for key in common_keys:
+        assert torch.equal(transformer_state[key], baseline_state[key]), key
+
+    decoder = _configure_deterministic_selection(transformer)
+    baseline_decoder = _configure_deterministic_selection(baseline)
+    src = torch.randn(1, 8, 2, 2)
+    outputs = _run_deterministic_forward(transformer, src)
+    baseline_outputs = _run_deterministic_forward(baseline, src)
+    assert decoder.tgt is not None
+    assert baseline_decoder.tgt is not None
+
+    assert torch.equal(decoder.tgt, baseline_decoder.tgt)
