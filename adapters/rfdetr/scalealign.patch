+def _resolve_released_2xl_checkpoint() -> Path | None:
+    """Resolve an optional released 2XL checkpoint across checkout layouts.
+
+    Examples:
+        >>> result = _resolve_released_2xl_checkpoint()
+        >>> result is None or result.is_file()
+        True
+    """
+    repository_root = Path(__file__).resolve().parents[2]
+    candidates: list[Path] = []
+    configured = os.environ.get("RFDETR_2XL_CHECKPOINT")
+    if configured:
+        candidates.append(Path(configured).expanduser())
+    candidates.append(repository_root / "weights" / "rf-detr-xxlarge.pth")
+
+    dot_git = repository_root / ".git"
+    if dot_git.is_file():
+        marker, separator, raw_git_dir = dot_git.read_text(encoding="utf-8").strip().partition(":")
+        if marker == "gitdir" and separator:
+            git_dir = Path(raw_git_dir.strip())
+            if not git_dir.is_absolute():
+                git_dir = (repository_root / git_dir).resolve()
+            common_dir = git_dir.parent.parent
+            candidates.append(common_dir.parent / "weights" / "rf-detr-xxlarge.pth")
+
+    for candidate in candidates:
+        if candidate.is_file():
+            return candidate.resolve()
+    return None
+
+
+def _synthetic_states(pretrained_level_index: int) -> tuple[dict[str, torch.Tensor], dict[str, torch.Tensor]]:
+    """Build minimal released and multi-scale state dictionaries.
+
+    Examples:
+        >>> checkpoint, model = _synthetic_states(1)
+        >>> checkpoint["backbone.0.projector.stages.0.0.weight"].shape
+        torch.Size([2, 2])
+        >>> "backbone.0.projector.stages.2.0.weight" in model
+        True
+    """
+    checkpoint = {
+        "backbone.0.projector.stages.0.0.weight": torch.arange(4.0).reshape(2, 2),
+        "backbone.0.projector.stages_sampling.0.0.0.weight": torch.arange(2.0).reshape(1, 2),
+        "transformer.decoder.layers.0.cross_attn.sampling_offsets.weight": torch.arange(16.0).reshape(8, 2),
+        "transformer.decoder.layers.0.cross_attn.sampling_offsets.bias": torch.arange(8.0),
+        "transformer.decoder.layers.0.cross_attn.attention_weights.weight": torch.arange(8.0).reshape(4, 2),
+        "transformer.decoder.layers.0.cross_attn.attention_weights.bias": torch.arange(4.0),
+        "unrelated.weight": torch.tensor([91.0]),
+    }
+    model: dict[str, torch.Tensor] = {"unrelated.weight": torch.zeros(1)}
+    for level in range(3):
+        model[f"backbone.0.projector.stages.{level}.0.weight"] = torch.full((2, 2), float(level + 10))
+        model[f"backbone.0.projector.stages_sampling.{level}.0.0.weight"] = torch.full((1, 2), float(level + 20))
