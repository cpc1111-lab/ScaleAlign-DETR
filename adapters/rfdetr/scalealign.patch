+
+def test_namespace_forwards_scalealign() -> None:
+    """The compatibility namespace must expose the validated nested config."""
+    config = RFDETRSmallConfig(scalealign={"enabled": True})
+
+    namespace = _namespace_from_configs(config, TrainConfig(dataset_dir="/tmp/coco"))
+
+    assert namespace.scalealign.enabled is True
