+
+
+def test_saa_requires_one_feature_stride_per_projector_level() -> None:
+    """Each projected feature level must have a corresponding spatial stride."""
+    with pytest.raises(ValidationError, match="one feature stride per projector level"):
+        RFDETRSmallConfig(
+            projector_scale=["P3", "P4", "P5"],
