+# ------------------------------------------------------------------------
+"""Tests for exact new-parameter-only ScaleAlign multi-scale tuning."""
+
+import json
+from dataclasses import FrozenInstanceError
+from types import SimpleNamespace
+
+import pytest
+import torch
+from torch import Tensor, nn
+
+from rfdetr.models.backbone import Joiner
+from rfdetr.models.backbone.projector import MultiScaleProjector
+from rfdetr.models.ops.modules import MSDeformAttn
+from rfdetr.models.transformer import Transformer
+from rfdetr.scalealign import ScaleAlignConfig, configure_scalealign_ms_finetune
+from rfdetr.training.param_groups import get_param_dict
+
+
+class _BackboneStub(nn.Module):
+    """Compact encoder/projector topology exposing the optimizer API."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.encoder = nn.Linear(4, 4)
+        self.projector = MultiScaleProjector(
+            in_channels=[4],
+            out_channels=4,
+            scale_factors=[2.0, 1.0, 0.5],
+            num_blocks=1,
+        )
+
+    def get_named_param_lr_pairs(self, args: SimpleNamespace, prefix: str) -> dict[str, dict[str, object]]:
+        return {
+            f"{prefix}.encoder.{name}": {"params": parameter, "lr": args.lr_encoder}
+            for name, parameter in self.encoder.named_parameters()
+            if parameter.requires_grad
+        }
+
+
+class _CompactModel(nn.Module):
+    """Small detector-shaped model with real multi-scale adapter modules."""
+
+    def __init__(self, *, include_scalealign: bool, pretrained_level_index: int | None = 1) -> None:
+        super().__init__()
+        self.backbone = Joiner(_BackboneStub(), nn.Identity())  # type: ignore[arg-type]
+        config = ScaleAlignConfig(
+            enabled=include_scalealign,
+            saa_enabled=include_scalealign,
+            feature_strides=[8.0, 16.0, 32.0],
+            pretrained_level_index=pretrained_level_index,
+        )
+        self.transformer = Transformer(
+            d_model=4,
+            sa_nhead=1,
+            ca_nhead=1,
+            dim_feedforward=8,
+            num_queries=2,
+            num_decoder_layers=1,
+            two_stage=True,
+            num_feature_levels=3,
+            dec_n_points=1,
+            scalealign=config,
+        )
+        self.query_embed = nn.Embedding(2, 4)
+        self.refpoint_embed = nn.Embedding(2, 4)
+        self.class_embed = nn.Linear(4, 2)
+        self.bbox_embed = nn.Linear(4, 4)
+
+    def adapter_loss(self) -> Tensor:
+        """Exercise the real trainable branches in a small CPU backward pass."""
+        projector = self.backbone[0].projector
+        features = projector([torch.randn(1, 4, 4, 4)])
+        loss = sum(feature.square().mean() for feature in features)
+
+        attention = self.transformer.decoder.layers[0].cross_attn
+        query = torch.randn(1, 2, 4)
+        memory = torch.randn(1, 21, 4)
+        shapes = torch.tensor([[4, 4], [2, 2], [1, 1]])
+        starts = torch.tensor([0, 16, 20])
+        references = torch.rand(1, 2, 3, 2)
+        loss = loss + attention(query, references, memory, shapes, starts).square().mean()
+
+        if self.transformer.scalealign_state is not None:
+            state = self.transformer.scalealign_state(torch.rand(1, 2, 4))
+            loss = loss + state.embedding.square().mean()
+            projection = self.transformer.scalealign_query_projection
+            content_projection = self.transformer.scalealign_content_projection
+            assert projection is not None and content_projection is not None
+            assert self.transformer.scalealign_query_gate is not None
+            assert self.transformer.scalealign_content_gate is not None
+            loss = loss + (self.transformer.scalealign_query_gate * projection(state.embedding)).square().mean()
+            loss = (
+                loss
+                + (self.transformer.scalealign_content_gate * content_projection(torch.randn(1, 2, 4))).square().mean()
+            )
+            saa = self.transformer.decoder.layers[0].scalealign_attention
+            assert saa is not None
+            loss = loss + saa(state.embedding).square().mean()
+        return loss
+
+
+class _GroupingBackboneStub(nn.Module):
+    """Minimal ordinary backbone with one explicitly policy-grouped tensor."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.weight = nn.Parameter(torch.ones(1))
+
+    def get_named_param_lr_pairs(self, args: SimpleNamespace, prefix: str) -> dict[str, dict[str, object]]:
+        """Return the backbone tensor at the encoder learning rate."""
+        return {f"{prefix}.weight": {"params": self.weight, "lr": args.lr_encoder}}
+
+
+class _OrdinaryGroupingModel(nn.Module):
+    """Small ordinary model with unambiguous optimizer policy membership."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.backbone = Joiner(_GroupingBackboneStub(), nn.Identity())  # type: ignore[arg-type]
+        self.transformer = nn.Module()
+        self.transformer.decoder = nn.Linear(2, 2)
+        self.transformer.encoder = nn.Linear(2, 2)
+        self.head = nn.Linear(2, 1)
+
+
+def _args() -> SimpleNamespace:
+    return SimpleNamespace(lr=1e-4, lr_encoder=1e-5, lr_component_decay=0.5)
+
+
+def _trainable_names(model: nn.Module) -> set[str]:
+    return {name for name, parameter in model.named_parameters() if parameter.requires_grad}
+
+
+def _expected_trainable_categories() -> dict[str, set[str]]:
+    """Return the complete compact-fixture adapter ownership contract."""
+    stage_suffixes = {
+        "0.cv1.conv.weight",
+        "0.cv1.bn.weight",
+        "0.cv1.bn.bias",
+        "0.cv2.conv.weight",
+        "0.cv2.bn.weight",
+        "0.cv2.bn.bias",
+        "0.m.0.cv1.conv.weight",
+        "0.m.0.cv1.bn.weight",
+        "0.m.0.cv1.bn.bias",
+        "0.m.0.cv2.conv.weight",
+        "0.m.0.cv2.bn.weight",
+        "0.m.0.cv2.bn.bias",
+        "1.weight",
+        "1.bias",
+    }
+    projector_names = {f"backbone.0.projector.stages.{level}.{suffix}" for level in (0, 2) for suffix in stage_suffixes}
+    projector_names |= {
+        "backbone.0.projector.stages_sampling.0.0.0.weight",
+        "backbone.0.projector.stages_sampling.0.0.0.bias",
+        "backbone.0.projector.stages_sampling.2.0.0.conv.weight",
+        "backbone.0.projector.stages_sampling.2.0.0.bn.weight",
+        "backbone.0.projector.stages_sampling.2.0.0.bn.bias",
+    }
+    auxiliary_names = {
+        f"transformer.decoder.layers.0.cross_attn.{projection}.{field}"
+        for projection in ("aux_sampling_offsets", "aux_attention_weights")
+        for field in ("weight", "bias")
+    }
+    scalealign_names = {
+        "transformer.scalealign_query_gate",
+        "transformer.scalealign_query_projection.weight",
+        "transformer.scalealign_query_projection.bias",
+        "transformer.scalealign_content_gate",
+        "transformer.scalealign_content_projection.weight",
+        "transformer.scalealign_content_projection.bias",
+        "transformer.scalealign_state.projection.0.weight",
+        "transformer.scalealign_state.projection.0.bias",
+        "transformer.scalealign_state.projection.2.weight",
+        "transformer.scalealign_state.projection.2.bias",
+        "transformer.scalealign_state.norm.weight",
+        "transformer.scalealign_state.norm.bias",
+        "transformer.decoder.layers.0.scalealign_attention.beta",
+        "transformer.decoder.scalealign_stride_encoder.0.weight",
+        "transformer.decoder.scalealign_stride_encoder.0.bias",
+        "transformer.decoder.scalealign_stride_encoder.2.weight",
+        "transformer.decoder.scalealign_stride_encoder.2.bias",
+        "transformer.decoder.layers.0.scalealign_attention.query_projection.weight",
+        "transformer.decoder.layers.0.scalealign_attention.query_projection.bias",
+        "transformer.decoder.layers.0.scalealign_attention.level_projection.weight",
+        "transformer.decoder.layers.0.scalealign_attention.level_projection.bias",
+    }
+    return {
+        "projector": projector_names,
+        "aux_deformable_attention": auxiliary_names,
+        "scalealign": scalealign_names,
+    }
+
+
+def test_exact_new_parameter_allowlist_and_report() -> None:
+    model = _CompactModel(include_scalealign=True)
+
+    report = configure_scalealign_ms_finetune(model, pretrained_level_index=1, include_scalealign=True)
+    trainable = _trainable_names(model)
+    expected_categories = _expected_trainable_categories()
+    expected = set().union(*expected_categories.values())
+
+    assert trainable == expected == set(report.trainable_names)
+    assert report.trainable_names == tuple(sorted(trainable))
+    assert all("backbone.0.projector.stages.1." not in name for name in trainable)
+    assert all("backbone.0.projector.stages_sampling.1." not in name for name in trainable)
+    assert any("backbone.0.projector.stages.0." in name for name in trainable)
+    assert any("backbone.0.projector.stages.2." in name for name in trainable)
+    assert any(".aux_sampling_offsets." in name for name in trainable)
+    assert any(".aux_attention_weights." in name for name in trainable)
+    forbidden = (
+        ".sampling_offsets.",
+        ".attention_weights.",
+        ".value_proj.",
+        ".output_proj.",
+        "query_embed",
+        "refpoint_embed",
+        "class_embed",
+        "bbox_embed",
+        ".self_attn.",
+        ".linear1.",
+        ".linear2.",
+        ".norm1.",
+        ".norm2.",
+        ".norm3.",
+        "transformer.decoder.norm.",
+        "backbone.0.encoder",
+    )
+    assert not any(any(marker in name for marker in forbidden) for name in trainable)
+    assert report.total_tensors == sum(1 for _ in model.parameters())
+    assert report.trainable_tensors == len(trainable)
+    assert report.total_parameters == sum(parameter.numel() for parameter in model.parameters())
+    assert report.trainable_parameters == sum(
+        parameter.numel() for parameter in model.parameters() if parameter.requires_grad
+    )
+    assert sum(report.category_tensor_counts.values()) == report.trainable_tensors
+    assert sum(report.category_parameter_counts.values()) == report.trainable_parameters
+    assert dict(report.category_tensor_counts) == {
+        category: len(names) for category, names in expected_categories.items()
+    }
+    parameters_by_name = dict(model.named_parameters())
+    assert dict(report.category_parameter_counts) == {
+        category: sum(parameters_by_name[name].numel() for name in names)
+        for category, names in expected_categories.items()
+    }
+    assert report.to_metadata()["trainable_names"] == list(report.trainable_names)
+    json.dumps(report.to_metadata())
+    with pytest.raises(FrozenInstanceError):
+        report.trainable_tensors = 0  # type: ignore[misc]
+    with pytest.raises(TypeError):
+        report.category_tensor_counts["projector"] = 0  # type: ignore[index]
+
+
+def test_control_and_treatment_differ_only_by_scalealign_parameters() -> None:
+    control = _CompactModel(include_scalealign=False)
+    treatment = _CompactModel(include_scalealign=True)
+
+    configure_scalealign_ms_finetune(control, 1, include_scalealign=False)
+    configure_scalealign_ms_finetune(treatment, 1, include_scalealign=True)
+    control_names = _trainable_names(control)
+    treatment_names = _trainable_names(treatment)
+
+    shared_architecture = {name for name in treatment_names if "scalealign" not in name}
+    assert control_names == shared_architecture
+    assert treatment_names - control_names
+    assert all("scalealign" in name for name in treatment_names - control_names)
+    assert not any("scalealign" in name for name, _ in control.named_parameters())
+
+
