+    trainer.fit.assert_called_once_with(
+        module_class.return_value,
+        data_class.return_value,
+        ckpt_path="/tmp/last.ckpt",
+    )
+
+
+def test_adapter_policy_trains_only_scalealign_and_detection_heads() -> None:
+    """Adapter-FT must freeze every pretrained parameter outside the detection heads."""
+
+    class ToyDetector(nn.Module):
+        def __init__(self) -> None:
+            super().__init__()
+            self.backbone = nn.Linear(2, 2)
+            self.decoder = nn.Linear(2, 2)
+            self.scalealign_query_projection = nn.Linear(2, 2)
+            self.class_embed = nn.Linear(2, 2)
+            self.bbox_embed = nn.Linear(2, 4)
+
+    model = ToyDetector()
+    configure = getattr(local_launcher, "configure_adapter_finetune", None)
+    assert configure is not None
+    stats = configure(model)
+    trainable_names = {name for name, parameter in model.named_parameters() if parameter.requires_grad}
+
+    assert trainable_names == {
+        "scalealign_query_projection.weight",
+        "scalealign_query_projection.bias",
+        "class_embed.weight",
+        "class_embed.bias",
+        "bbox_embed.weight",
+        "bbox_embed.bias",
+    }
+    assert stats["trainable_parameters"] < stats["total_parameters"]
+
