+def test_optimizer_contains_each_trainable_once_at_component_policy() -> None:
+    model = _CompactModel(include_scalealign=True)
+    configure_scalealign_ms_finetune(model, 1, True)
+
+    groups = get_param_dict(_args(), model)
+    grouped = [group["params"] for group in groups]
+    trainable = [parameter for parameter in model.parameters() if parameter.requires_grad]
+    assert {id(parameter) for parameter in grouped} == {id(parameter) for parameter in trainable}
+    assert len(grouped) == len({id(parameter) for parameter in grouped})
+    assert all(parameter.requires_grad for parameter in grouped)
