+def test_mid_epoch_step_checkpoint_has_fresh_manifest_and_resumes_remaining_steps(tmp_path: Path) -> None:
+    class TinyModule(LightningModule):
+        def __init__(self) -> None:
+            super().__init__()
+            self.weight = nn.Parameter(torch.tensor(1.0))
+
+        def training_step(self, batch, batch_idx):
+            del batch_idx
+            return (self.weight * batch[0]).square().mean()
+
+        def configure_optimizers(self):
+            return torch.optim.SGD(self.parameters(), lr=0.01)
+
+    provenance = _provenance()
+    checkpoint = ModelCheckpoint(
+        dirpath=tmp_path,
+        filename="last",
+        every_n_train_steps=2,
+        every_n_epochs=None,
+        save_top_k=1,
+        enable_version_counter=False,
+        auto_insert_metric_name=False,
+    )
+    manifest = CheckpointManifestCallback(tmp_path, provenance)
+    loader = DataLoader(TensorDataset(torch.ones(4, 1)), batch_size=1)
+    first = Trainer(
+        accelerator="cpu",
+        max_epochs=1,
+        max_steps=2,
+        callbacks=[checkpoint, manifest],
+        logger=False,
+        enable_progress_bar=False,
+        enable_model_summary=False,
+        num_sanity_val_steps=0,
+    )
+    first.fit(TinyModule(), train_dataloaders=loader)
+    last = tmp_path / "last.ckpt"
+    assert last.is_file()
+    validate_checkpoint_manifest(last, provenance)
+
+    resumed = Trainer(
+        accelerator="cpu",
+        max_epochs=1,
+        max_steps=4,
+        callbacks=[],
+        logger=False,
+        enable_checkpointing=False,
+        enable_progress_bar=False,
+        enable_model_summary=False,
+        num_sanity_val_steps=0,
+    )
+    resumed.fit(TinyModule(), train_dataloaders=loader, ckpt_path=str(last))
+
+    assert resumed.global_step == 4
+
