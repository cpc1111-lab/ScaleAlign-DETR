+# ------------------------------------------------------------------------
+# RF-DETR
+# Copyright (c) 2025 Roboflow. All Rights Reserved.
+# Licensed under the Apache License, Version 2.0 [see LICENSE for details]
+# ------------------------------------------------------------------------
+"""Validated configuration for ScaleAlign query routing."""
+
+import math
+from typing import Any
+
+from pydantic import (
+    BaseModel,
+    ConfigDict,
+    Field,
+    PrivateAttr,
+    TypeAdapter,
+    ValidationError,
+    ValidationInfo,
+    field_validator,
+    model_validator,
+)
+
+_SAA_ENABLED_ADAPTER = TypeAdapter(bool)
+_FEATURE_STRIDES_ADAPTER = TypeAdapter(list[float])
+_PRETRAINED_LEVEL_INDEX_ADAPTER = TypeAdapter(int | None)
+_DISTILL_VALUE_ADAPTER = TypeAdapter(float)
+
+
+def _validate_distillation_contract(
+    enabled: bool,
+    class_weight: float,
+    box_weight: float,
+    warmup_epochs: float,
+) -> None:
+    """Validate complete proposed distillation state before assignment."""
+    values = (class_weight, box_weight, warmup_epochs)
+    if any(not math.isfinite(value) for value in values):
+        raise ValueError("distillation values must be finite")
+    if any(value < 0.0 for value in values):
+        raise ValueError("distillation values must be non-negative")
+    active = class_weight > 0.0 or box_weight > 0.0
+    if active and not enabled:
+        raise ValueError("distillation requires ScaleAlign to be enabled")
+    if active and warmup_epochs <= 0.0:
+        raise ValueError("distillation requires distill_warmup_epochs > 0")
+
+
+def _validate_saa_local_contract(
+    saa_enabled: bool,
+    feature_strides: list[float],
+    pretrained_level_index: int | None,
+    expected_feature_levels: int | None = None,
+) -> None:
+    """Validate SAA state that does not depend on the parent model config."""
+    if not saa_enabled:
+        return
+    if expected_feature_levels is not None and expected_feature_levels < 2:
+        raise ValueError("saa_enabled requires at least two projector levels")
+    if expected_feature_levels is not None and len(feature_strides) != expected_feature_levels:
+        raise ValueError("saa_enabled requires one feature stride per projector level")
+    if expected_feature_levels is None and len(feature_strides) < 2:
+        raise ValueError("saa_enabled requires at least two feature strides")
+    if any(not math.isfinite(stride) for stride in feature_strides):
+        raise ValueError("feature_strides must be finite")
+    if any(stride <= 0.0 for stride in feature_strides) or any(
+        current <= previous for previous, current in zip(feature_strides, feature_strides[1:])
+    ):
+        raise ValueError("feature_strides must be positive and strictly increasing")
+    if pretrained_level_index is not None:
+        level_count = expected_feature_levels if expected_feature_levels is not None else len(feature_strides)
+        if pretrained_level_index >= level_count:
+            raise ValueError("pretrained_level_index must identify a feature stride")
+
+
+class ScaleAlignConfig(BaseModel):
+    """Configure explicit scale state and scale-guided query selection.
+
+    Attributes:
+        enabled: Construct and use ScaleAlign components when true.
+        scale_dim: Width of the learned explicit-scale embedding.
+        num_scale_anchors: Number of ordered anchors in continuous log-scale space.
+        temperature: Gaussian membership temperature for scale anchors.
+        coverage_weight: Target SGQG coverage penalty multiplier.
+        coverage_warmup_epochs: Epochs used to ramp the coverage penalty from zero.
+        min_scale: Minimum normalized geometric-mean box scale represented by anchors.
+        max_scale: Maximum normalized geometric-mean box scale represented by anchors.
+        epsilon: Numerical floor for box geometry and probability calculations.
+        query_injection: Add gated ESM embeddings to initial decoder queries.
+        diagnostics: Retain detached query-routing diagnostics from the latest forward pass.
+        saa_enabled: Request cross-level Scale-Aligned Attention.
+        feature_strides: Spatial stride of each projected feature level, in ascending order.
+        saa_rank: Low-rank width used by Scale-Aligned Attention projections.
+        saa_init_beta: Initial scale-alignment bias for attention routing.
+        new_level_logit_prior: Initial attention-logit prior for newly added feature levels.
+        new_level_prior_warmup_epochs: Epochs used to warm up new-level attention priors.
+        content_injection: Inject projected feature content into SAA outputs.
+        pretrained_level_index: Projector level that retains pretrained attention behavior.
+        distill_class_weight: Weight of rank-matched teacher classification distillation.
+        distill_box_weight: Weight of rank-matched teacher box distillation.
+        distill_warmup_epochs: Epochs over which teacher distillation decays to zero.
+    """
+
+    model_config = ConfigDict(extra="forbid", validate_assignment=True)
+
+    _expected_feature_levels: int | None = PrivateAttr(default=None)
+
+    enabled: bool = False
+    scale_dim: int = Field(default=64, ge=1)
+    num_scale_anchors: int = Field(default=8, ge=2)
+    temperature: float = Field(default=0.25, gt=0.0)
+    coverage_weight: float = Field(default=0.5, ge=0.0)
+    coverage_warmup_epochs: float = Field(default=0.5, ge=0.0)
+    min_scale: float = Field(default=1.0 / 880.0, gt=0.0, le=1.0)
+    max_scale: float = Field(default=1.0, gt=0.0, le=1.0)
+    epsilon: float = Field(default=1e-6, gt=0.0)
+    query_injection: bool = True
+    diagnostics: bool = False
+    saa_enabled: bool = False
+    feature_strides: list[float] = Field(default_factory=list)
+    saa_rank: int = Field(default=32, ge=1)
+    saa_init_beta: float = -8.0
+    new_level_logit_prior: float = Field(default=-6.0, le=0.0)
+    new_level_prior_warmup_epochs: float = Field(default=0.5, ge=0.0)
+    content_injection: bool = True
+    pretrained_level_index: int | None = Field(default=None, ge=0)
+    distill_class_weight: float = Field(default=0.0, ge=0.0)
+    distill_box_weight: float = Field(default=0.0, ge=0.0)
+    distill_warmup_epochs: float = Field(default=0.0, ge=0.0)
+
+    def __eq__(self, other: object) -> bool:
+        """Compare public configuration state, excluding the private parent binding."""
+        if not isinstance(other, ScaleAlignConfig):
+            return super().__eq__(other)
+        return self.model_dump() == other.model_dump()
+
+    def _bind_expected_feature_levels(self, expected_feature_levels: int) -> None:
+        """Bind the parent model's projector-level count after parent validation."""
+        self._expected_feature_levels = expected_feature_levels
+
+    def _validate_expected_feature_levels(self, expected_feature_levels: int) -> None:
+        """Validate active SAA against a proposed parent projector-level count."""
+        _validate_saa_local_contract(
+            self.saa_enabled,
+            self.feature_strides,
+            self.pretrained_level_index,
+            expected_feature_levels,
+        )
+
+    def __setattr__(self, name: str, value: Any) -> None:
+        """Reject invalid proposed dependency state before Pydantic stores it."""
+        if name in {"enabled", "distill_class_weight", "distill_box_weight", "distill_warmup_epochs"}:
+            try:
+                enabled = _SAA_ENABLED_ADAPTER.validate_python(value if name == "enabled" else self.enabled)
+                class_weight = _DISTILL_VALUE_ADAPTER.validate_python(
+                    value if name == "distill_class_weight" else self.distill_class_weight
+                )
+                box_weight = _DISTILL_VALUE_ADAPTER.validate_python(
+                    value if name == "distill_box_weight" else self.distill_box_weight
+                )
+                warmup_epochs = _DISTILL_VALUE_ADAPTER.validate_python(
+                    value if name == "distill_warmup_epochs" else self.distill_warmup_epochs
+                )
+            except ValidationError:
+                super().__setattr__(name, value)
+                return
+            try:
+                _validate_distillation_contract(enabled, class_weight, box_weight, warmup_epochs)
+            except ValueError as error:
+                raise ValidationError.from_exception_data(
+                    type(self).__name__,
+                    [
+                        {
+                            "type": "value_error",
+                            "loc": (name,),
+                            "input": value,
+                            "ctx": {"error": error},
+                        }
+                    ],
+                ) from error
+        if name in {"saa_enabled", "feature_strides", "pretrained_level_index"}:
+            expected_feature_levels = self._expected_feature_levels
+            if expected_feature_levels is not None:
+                saa_enabled = value if name == "saa_enabled" else self.saa_enabled
+                feature_strides = value if name == "feature_strides" else self.feature_strides
+                pretrained_level_index = value if name == "pretrained_level_index" else self.pretrained_level_index
+                try:
+                    saa_enabled = _SAA_ENABLED_ADAPTER.validate_python(saa_enabled)
+                    feature_strides = _FEATURE_STRIDES_ADAPTER.validate_python(feature_strides)
+                    pretrained_level_index = _PRETRAINED_LEVEL_INDEX_ADAPTER.validate_python(pretrained_level_index)
+                except ValidationError:
+                    super().__setattr__(name, value)
+                    return
+                try:
+                    _validate_saa_local_contract(
+                        saa_enabled,
+                        feature_strides,
+                        pretrained_level_index,
+                        expected_feature_levels,
+                    )
+                except ValueError as error:
+                    raise ValidationError.from_exception_data(
+                        type(self).__name__,
+                        [
+                            {
+                                "type": "value_error",
+                                "loc": (name,),
+                                "input": value,
+                                "ctx": {"error": error},
+                            }
+                        ],
+                    ) from error
+        super().__setattr__(name, value)
+
+    @field_validator("enabled")
+    @classmethod
+    def validate_enabled_assignment(cls, enabled: bool, info: ValidationInfo) -> bool:
+        """Prevent assignment from disabling state required by active SAA."""
+        if not enabled and info.data.get("saa_enabled", False):
+            raise ValueError("saa_enabled requires ScaleAlign to be enabled")
+        return enabled
+
+    @field_validator("distill_class_weight", "distill_box_weight", "distill_warmup_epochs")
+    @classmethod
+    def validate_finite_distillation_value(cls, value: float) -> float:
+        """Require finite distillation weights and duration."""
+        if not math.isfinite(value):
+            raise ValueError("distillation values must be finite")
+        return value
+
+    @field_validator("saa_enabled")
+    @classmethod
+    def validate_saa_enabled_assignment(cls, saa_enabled: bool, info: ValidationInfo) -> bool:
+        """Validate SAA activation against already validated sibling fields."""
+        if saa_enabled and not info.data.get("enabled", False):
+            raise ValueError("saa_enabled requires ScaleAlign to be enabled")
+        if "feature_strides" in info.data:
+            _validate_saa_local_contract(
+                saa_enabled,
+                info.data["feature_strides"],
+                info.data.get("pretrained_level_index"),
+            )
+        return saa_enabled
+
+    @field_validator("feature_strides")
+    @classmethod
+    def validate_feature_strides_assignment(cls, feature_strides: list[float], info: ValidationInfo) -> list[float]:
+        """Reject an assigned stride list that would invalidate active SAA."""
+        _validate_saa_local_contract(
+            info.data.get("saa_enabled", False),
+            feature_strides,
+            info.data.get("pretrained_level_index"),
+        )
+        return feature_strides
+
+    @field_validator("pretrained_level_index")
+    @classmethod
+    def validate_pretrained_level_assignment(
+        cls,
+        pretrained_level_index: int | None,
+        info: ValidationInfo,
+    ) -> int | None:
+        """Reject an assigned pretrained level outside the local stride range."""
+        _validate_saa_local_contract(
+            info.data.get("saa_enabled", False),
+            info.data.get("feature_strides", []),
+            pretrained_level_index,
+        )
+        return pretrained_level_index
+
+    @model_validator(mode="after")
+    def validate_dependencies(self) -> "ScaleAlignConfig":
+        """Validate the scale interval and shared-state dependency.
+
+        Returns:
+            The validated configuration.
+
+        Raises:
+            ValueError: If the scale interval is empty or SAA lacks ScaleAlign state.
+        """
+        if self.min_scale >= self.max_scale:
+            raise ValueError("min_scale must be smaller than max_scale")
+        if self.saa_enabled and not self.enabled:
+            raise ValueError("saa_enabled requires ScaleAlign to be enabled")
+        _validate_distillation_contract(
+            self.enabled,
+            self.distill_class_weight,
+            self.distill_box_weight,
+            self.distill_warmup_epochs,
+        )
+        _validate_saa_local_contract(
+            self.saa_enabled,
+            self.feature_strides,
+            self.pretrained_level_index,
+        )
+        return self
