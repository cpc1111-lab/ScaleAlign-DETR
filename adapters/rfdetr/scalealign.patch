+)
+
+ROOT = Path(__file__).resolve().parents[2]
+CONFIG = ROOT / "configs/scalealign/rfdetr_2xl_esm_sgqg_coco_local.yaml"
+COCO_ROOT = "data/coco"
+
+
+def test_local_config_fixes_scalealign_training_contract() -> None:
+    """The direct-run YAML must encode the approved host paths and budget."""
+    config = load_run_config(CONFIG)
+    model = config["model"]["model_config"]
+    model_args = model["init_args"]
+    train = config["model"]["train_config"]
+    train_args = train["init_args"]
+
+    assert model["class_path"] == "rfdetr_plus.models.RFDETR2XLargeConfig"
+    assert train["class_path"] == "rfdetr.config.TrainConfig"
+    assert model_args["num_classes"] == 90
+    assert model_args["pretrain_weights"] == "weights/rf-detr-xxlarge.pth"
+    assert model_args["scalealign"]["enabled"] is True
+    assert model_args["scalealign"]["query_injection"] is True
+    assert model_args["scalealign"]["saa_enabled"] is False
+    assert train_args["dataset_dir"] == COCO_ROOT
+    assert train_args["output_dir"] == "experiments/scalealign_2xl/adapter_30k"
+    assert train_args["epochs"] == 1
+    assert train_args["seed"] == 0
+    assert train_args["batch_size"] == 2
+    assert train_args["grad_accum_steps"] == 8
+    assert train_args["devices"] == 1
+    assert train_args["multi_scale"] is False
+    assert train_args["expanded_scales"] is False
+    assert train_args["progress_bar"] == "tqdm"
+    assert train_args["use_ema"] is False
+    assert train_args["compute_val_loss"] is False
+
+
+def test_local_config_materializes_supported_training_types() -> None:
+    """The launcher must validate config through the concrete 2XL and train types."""
+    model_config, train_config = load_training_configs()
+
+    assert isinstance(model_config, RFDETR2XLargeConfig)
+    assert isinstance(train_config, TrainConfig)
+    assert model_config.resolution == 880
+    assert model_config.num_queries == 300
+    assert model_config.num_classes == 90
+    assert train_config.epochs == 1
+
+
