+class _PredictionModel(nn.Module):
+    def __init__(self, value: float = 0.0) -> None:
+        super().__init__()
+        self.weight = nn.Parameter(torch.tensor(value))
+        self.calls = 0
+
+    def forward(self, samples, targets=None):
+        self.calls += 1
+        batch = samples.tensors.shape[0]
+        logits = self.weight.expand(batch, 3, 2)
+        boxes = self.weight.sigmoid().expand(batch, 3, 4)
+        return _outputs(logits, boxes)
+
+
+class _InputTeacher(nn.Module):
+    def forward(self, samples):
+        value = samples.tensors.mean(dim=(1, 2, 3)).reshape(-1, 1, 1)
+        return _outputs(value.expand(-1, 3, 2), value.sigmoid().expand(-1, 3, 4))
+
+
+class _StatefulPredictionModel(nn.Module):
+    def __init__(self) -> None:
+        super().__init__()
+        self.projection = nn.Linear(1, 1, bias=False)
+
+    def forward(self, samples, targets=None):
+        pooled = samples.tensors.mean(dim=(1, 2, 3), keepdim=False).unsqueeze(-1)
+        value = torch.tanh(self.projection(pooled)).reshape(-1, 1, 1)
+        return _outputs(value.expand(-1, 3, 2), value.sigmoid().expand(-1, 3, 4))
+
+
+class _TwoParameterModel(nn.Module):
+    def __init__(self) -> None:
+        super().__init__()
+        self.alpha = nn.Parameter(torch.tensor(0.0))
+        self.zeta = nn.Parameter(torch.tensor(0.0))
+
+
+class _ZeroBoxNormalizedCriterion:
+    supports_loss_normalizer_override = True
+    weight_dict = {"loss_ce": 1.0}
+
+    def num_boxes_for_targets(self, outputs, targets):
+        return torch.tensor(float(sum(len(target["labels"]) for target in targets)))
+
+    def __call__(self, outputs, targets, num_boxes=None):
+        return {"loss_ce": outputs["pred_logits"].sum() * 0.0}
+
+
+def _module(tmp_path, scalealign: ScaleAlignConfig, teacher_factory=MagicMock()):
+    student = _PredictionModel()
+    criterion = MagicMock()
+    criterion.weight_dict = {"loss_ce": 2.0}
+    criterion.return_value = {"loss_ce": student.weight.square() + 1.0}
+    config = RFDETRBaseConfig(pretrain_weights=None, device="cpu", num_classes=2, scalealign=scalealign)
+    train = TrainConfig(
+        dataset_dir=str(tmp_path / "dataset"),
+        output_dir=str(tmp_path / "output"),
+        epochs=3,
+        tensorboard=False,
+        multi_scale=False,
+    )
+    with (
+        patch("rfdetr.training.module_model.build_model_from_config", return_value=student),
+        patch("rfdetr.training.module_model.build_criterion_from_config", return_value=(criterion, MagicMock())),
+    ):
+        module = RFDETRModelModule(config, train, distillation_teacher_factory=teacher_factory)
+    module._trainer = SimpleNamespace(
+        current_epoch=0,
+        num_training_batches=4,
+        accumulate_grad_batches=1,
+        global_step=0,
+    )
+    optimizer = torch.optim.SGD(student.parameters(), lr=0.1)
+    module.optimizers = MagicMock(return_value=optimizer)
+    module.log = MagicMock()
+    module.log_dict = MagicMock()
+    module._log_train_progress_metrics = MagicMock()
+    samples = NestedTensor(torch.zeros(1, 3, 4, 4), torch.zeros(1, 4, 4, dtype=torch.bool))
+    return module, student, criterion, (samples, [{}])
