+def test_reducer_labels_layer_head_and_level_axes_and_reports_head_bam() -> None:
+    tensors = _routing_tensors()
+    boxes = torch.tensor([[[0.25, 0.25, math.exp(-3.0), math.exp(-3.0)], [0.75, 0.75, math.exp(-1.0), math.exp(-1.0)]]])
