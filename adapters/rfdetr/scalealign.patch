+            id="instance",
+        ),
+    ],
+)
+def test_scalealign_replacement_rolls_back_projector_count_mismatch(replacement: object) -> None:
+    """Whole-child assignment rejects mismatches before replacing valid state."""
+    config = RFDETRSmallConfig(
+        projector_scale=["P3", "P5"],
