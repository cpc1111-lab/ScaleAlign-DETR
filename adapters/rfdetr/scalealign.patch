+
+def test_coco_label_space_must_fit_native_model_slots(tmp_path: Path) -> None:
+    """Sparse native COCO IDs require model slots through category ID 90."""
+    annotations = tmp_path / "annotations"
+    annotations.mkdir()
+    payload = {"categories": [{"id": 1}, {"id": 90}]}
+    for split in ("train", "val"):
