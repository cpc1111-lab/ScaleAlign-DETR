+def test_reducer_releases_each_capture_before_loading_next_shard(tmp_path) -> None:
+    for name in ("batch-0002.pt", "batch-0001.pt"):
+        (tmp_path / name).touch()
+    loaded: list[str] = []
+    released: list[str] = []
+
+    class TrackedCapture(dict[str, object]):
+        def __init__(self, capture: dict[str, object], name: str) -> None:
+            super().__init__(capture)
+            self.name = name
+
+        def __del__(self) -> None:
+            released.append(self.name)
+
+    def load_shard(path, **_kwargs):
+        if loaded:
+            assert released == loaded
+        name = path.stem
+        loaded.append(name)
+        return TrackedCapture(_capture(1, len(loaded) - 1), name)
+
+    with patch("tools.analyze_scalealign.torch.load", side_effect=load_shard):
+        result = reduce_captures(_iter_captures(tmp_path), image_size=100, iou_threshold=0.5)
+
+    assert loaded == ["batch-0001", "batch-0002"]
+    assert released == loaded
+    assert result["capture_batches"] == 2
+
