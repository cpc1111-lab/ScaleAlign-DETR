+# ------------------------------------------------------------------------
+# RF-DETR
+# Copyright (c) 2025 Roboflow. All Rights Reserved.
+# Licensed under the Apache License, Version 2.0 [see LICENSE for details]
+# ------------------------------------------------------------------------
+"""Scale-Aligned Attention compatibility over feature-pyramid levels."""
+
+import math
+from collections.abc import Sequence
+
+import torch
+import torch.nn.functional as functional
+from torch import Tensor, nn
+
+
+def _linear(input: Tensor, layer: nn.Linear) -> Tensor:
+    """Apply a linear layer in the floating dtype and device of its input."""
+    weight = layer.weight.to(dtype=input.dtype, device=input.device)
+    bias = None if layer.bias is None else layer.bias.to(dtype=input.dtype, device=input.device)
+    return functional.linear(input, weight, bias)
+
+
+class ScaleAlignedAttention(nn.Module):
+    """Compute learned query-to-feature-level compatibility biases."""
+
+    def __init__(
+        self,
+        scale_dim: int,
+        rank: int,
+        num_heads: int,
+        feature_strides: Sequence[float],
+        init_beta: float = -8.0,
+    ) -> None:
+        """Initialize low-rank scale compatibility projections.
+
+        Args:
+            scale_dim: Width of each explicit-scale query embedding.
+            rank: Width of the low-rank compatibility space.
+            num_heads: Number of attention heads receiving compatibility biases.
+            feature_strides: Positive, strictly increasing feature-map strides.
+            init_beta: Initial unconstrained per-head compatibility gain.
+
+        Raises:
+            ValueError: If dimensions, strides, or ``init_beta`` are invalid.
+        """
+        super().__init__()
+        for name, value in (("scale_dim", scale_dim), ("rank", rank), ("num_heads", num_heads)):
+            if not isinstance(value, int) or isinstance(value, bool) or value < 1:
+                raise ValueError(f"{name} must be a positive integer")
+
+        try:
+            strides = tuple(float(stride) for stride in feature_strides)
+        except (TypeError, ValueError) as error:
+            raise ValueError("feature_strides must contain finite numbers") from error
+        if len(strides) < 2:
+            raise ValueError("feature_strides must contain at least two values")
+        if any(not math.isfinite(stride) for stride in strides):
+            raise ValueError("feature_strides must contain only finite values")
+        if any(stride <= 0.0 for stride in strides) or any(
+            current <= previous for previous, current in zip(strides, strides[1:])
+        ):
+            raise ValueError("feature_strides must be positive and strictly increasing")
+        try:
+            beta = float(init_beta)
+        except (TypeError, ValueError) as error:
+            raise ValueError("init_beta must be finite") from error
+        if not math.isfinite(beta):
+            raise ValueError("init_beta must be finite")
+
+        self.scale_dim = scale_dim
+        self.rank = rank
+        self.num_heads = num_heads
+        self.register_buffer("log_strides", torch.tensor(strides).log(), persistent=True)
+        self.stride_encoder = nn.Sequential(
+            nn.Linear(1, scale_dim),
+            nn.GELU(),
+            nn.Linear(scale_dim, scale_dim),
+        )
+        self.query_projection = nn.Linear(scale_dim, rank)
+        self.level_projection = nn.Linear(scale_dim, rank)
+        self.beta = nn.Parameter(torch.full((num_heads,), beta))
+
+    def forward(self, scale_embedding: Tensor) -> Tensor:
+        """Return query-level compatibility with shape ``(B, Q, H, L)``.
+
+        Args:
+            scale_embedding: Floating tensor with shape ``(B, Q, scale_dim)``.
+
+        Returns:
+            Per-query, per-head compatibility for every configured feature level.
+
+        Raises:
+            ValueError: If the input shape or dtype does not satisfy the contract.
+        """
+        if scale_embedding.ndim != 3:
+            raise ValueError("scale_embedding must have shape (batch, queries, scale_dim)")
+        if scale_embedding.shape[-1] != self.scale_dim:
+            raise ValueError("scale_embedding last dimension must equal scale_dim")
+        if not scale_embedding.is_floating_point():
+            raise ValueError("scale_embedding must have a floating-point dtype")
+
+        query = _linear(scale_embedding, self.query_projection)
+        log_strides = self.log_strides.to(dtype=scale_embedding.dtype, device=scale_embedding.device)
+        level = _linear(log_strides[:, None], self.stride_encoder[0])
+        level = functional.gelu(level)
+        level = _linear(level, self.stride_encoder[2])
+        level = _linear(level, self.level_projection)
+        compatibility = torch.einsum("bqr,lr->bql", query, level) / math.sqrt(self.rank)
+        gamma = functional.softplus(self.beta).to(dtype=compatibility.dtype, device=compatibility.device)
+        return compatibility[:, :, None, :] * gamma[None, None, :, None]
