+def test_nonempty_output_requires_explicit_resume(tmp_path: Path) -> None:
+    """An existing run must not be overwritten accidentally."""
+    output_dir = tmp_path / "output"
+    output_dir.mkdir()
+    (output_dir / "metrics.csv").touch()
