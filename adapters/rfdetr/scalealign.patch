+        scalealign = _metadata_field(candidate, "scalealign")
+        if scalealign is _MISSING_METADATA:
+            continue
+        value = _metadata_field(scalealign, "pretrained_level_index")
+        if value is _MISSING_METADATA or value is None:
+            continue
+        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+            raise ValueError(
+                "Checkpoint model_config.scalealign.pretrained_level_index must be a non-negative integer; "
+                f"{path}.scalealign.pretrained_level_index={value!r}."
+            )
+        values.append((f"{path}.scalealign.pretrained_level_index", value))
+
+    distinct_values = {value for _, value in values}
+    if len(distinct_values) > 1:
+        details = ", ".join(f"{path}={value}" for path, value in values)
+        raise ValueError(f"Checkpoint has ambiguous pretrained_level_index metadata: {details}.")
+    return values[0][1] if values else None
+
+
+def _classify_multiscale_source(
+    checkpoint_state: Mapping[str, Any],
+    model_state: Mapping[str, Any],
+    checkpoint_args: Any,
+    *,
+    checkpoint_metadata: Mapping[str, Any] | None = None,
+    target_pretrained_level_index: int | None = None,
+) -> str:
+    """Classify a checkpoint as released single-P4 or matching multi-scale."""
+    source_projector_levels = _projector_levels(checkpoint_state)
+    target_projector_levels = _projector_levels(model_state)
+    source_aux_keys = _aux_attention_keys(checkpoint_state)
+    target_aux_keys = _aux_attention_keys(model_state)
+    declared_projector_count = _declared_projector_count(checkpoint_args)
+    if source_projector_levels == frozenset({0}) and not source_aux_keys and declared_projector_count in {None, 1}:
+        return "released-single-p4"
+    if (
+        source_projector_levels == target_projector_levels
+        and source_aux_keys == target_aux_keys
+        and declared_projector_count in {None, len(target_projector_levels)}
+    ):
+        source_projector_keys = _projector_keys(checkpoint_state)
+        target_projector_keys = _projector_keys(model_state)
+        missing_projector_keys = tuple(sorted(target_projector_keys - source_projector_keys))
+        extra_projector_keys = tuple(sorted(source_projector_keys - target_projector_keys))
+        shape_mismatched_projector_keys = tuple(
+            sorted(
+                key
+                for key in source_projector_keys & target_projector_keys
+                if getattr(checkpoint_state[key], "shape", None) != getattr(model_state[key], "shape", None)
+            )
+        )
+        if missing_projector_keys or extra_projector_keys or shape_mismatched_projector_keys:
+            raise ValueError(
+                "Matching multi-scale checkpoint has an incomplete or incompatible projector state: "
+                f"missing_projector_keys={missing_projector_keys}, "
+                f"extra_projector_keys={extra_projector_keys}, "
+                f"shape_mismatched_projector_keys={shape_mismatched_projector_keys}."
+            )
+        source_pretrained_level_index = _checkpoint_pretrained_level_index(checkpoint_metadata or {})
+        if source_pretrained_level_index is None:
+            raise ValueError(
+                "Matching multi-scale checkpoint is missing model_config.scalealign.pretrained_level_index metadata."
+            )
+        if source_pretrained_level_index != target_pretrained_level_index:
+            raise ValueError(
+                "Matching multi-scale checkpoint pretrained_level_index does not match the target: "
+                f"source={source_pretrained_level_index}, target={target_pretrained_level_index}."
+            )
+        return "matching-multiscale"
+    raise ValueError(
+        "Checkpoint projector/attention topology is neither released single-P4 nor a match for the target: "
+        f"source_levels={sorted(source_projector_levels)}, "
+        f"target_levels={sorted(target_projector_levels)}, "
+        f"source_aux_keys={len(source_aux_keys)}, target_aux_keys={len(target_aux_keys)}, "
+        f"args.projector_scale_count={declared_projector_count}."
+    )
+
+
+def remap_single_p4_to_multiscale(
