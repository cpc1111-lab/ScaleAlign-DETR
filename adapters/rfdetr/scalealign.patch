+def test_aligned_attention_scores_better_than_reversed_attention() -> None:
+    aligned = compute_saa_diagnostics(**_routing_tensors())
+    reversed_routing = compute_saa_diagnostics(**_routing_tensors(reversed_attention=True))
+
+    assert aligned.scale_mismatch_rate.mean().item() < reversed_routing.scale_mismatch_rate.mean().item()
+    assert aligned.scale_stride_correlation.mean().item() > reversed_routing.scale_stride_correlation.mean().item()
+    torch.testing.assert_close(reversed_routing.scale_mismatch_rate, torch.ones(2, dtype=torch.float64))
+    torch.testing.assert_close(reversed_routing.scale_stride_correlation, -torch.ones(2, dtype=torch.float64))
+
