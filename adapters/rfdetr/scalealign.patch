+# ------------------------------------------------------------------------
+"""Tests for explicit continuous scale state."""
+
+import math
+
+import torch
+
+from rfdetr.scalealign import ExplicitScaleModel
+
+
+def test_uniform_resize_translates_scale_and_preserves_aspect() -> None:
+    """Uniform box resizing must become translation in log-scale space."""
+    model = ExplicitScaleModel(scale_dim=8)
+    boxes = torch.tensor([[[0.5, 0.5, 0.1, 0.2]]], requires_grad=True)
+    resized = boxes.detach().clone()
+    resized[..., 2:] *= 2
+
+    state = model(boxes)
+    resized_state = model(resized)
+
+    torch.testing.assert_close(resized_state.log_scale - state.log_scale, torch.full((1, 1), math.log(2)))
+    torch.testing.assert_close(resized_state.log_aspect, state.log_aspect)
+
+
+def test_geometry_is_stopped_but_esm_parameters_receive_gradients() -> None:
+    """ESM learns from losses without steering the detector's box geometry."""
+    model = ExplicitScaleModel(scale_dim=8)
+    boxes = torch.tensor([[[0.5, 0.5, 0.1, 0.2]]], requires_grad=True)
+
+    model(boxes).embedding.sum().backward()
+
+    assert boxes.grad is None
+    assert all(parameter.grad is not None for parameter in model.parameters())
+
+
+def test_degenerate_boxes_remain_finite() -> None:
+    """Zero-sized proposals must not introduce logarithmic infinities."""
+    state = ExplicitScaleModel(scale_dim=8)(torch.zeros(1, 2, 4))
+
+    assert torch.isfinite(state.descriptor).all()
+    assert torch.isfinite(state.embedding).all()
