+
+def test_parent_assignment_rejects_projector_count_mismatching_active_saa() -> None:
+    """A projector assignment is rejected transactionally when SAA uses two levels."""
+    config = RFDETRSmallConfig(
+        projector_scale=["P3", "P5"],
+        scalealign={
+            "enabled": True,
+            "saa_enabled": True,
+            "feature_strides": [10.0, 20.0],
