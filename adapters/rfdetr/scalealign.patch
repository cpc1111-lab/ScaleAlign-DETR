+def test_split_branch_torch_export_keeps_every_tensor_at_rank_five_or_less() -> None:
+    class ExportWrapper(torch.nn.Module):
+        def __init__(self) -> None:
+            super().__init__()
+            self.attention = MSDeformAttn(d_model=8, n_levels=3, n_heads=2, n_points=2, pretrained_level_index=1)
+            self.attention.export()
+
+        def forward(
+            self,
+            query: Tensor,
+            reference_points: Tensor,
+            input_flatten: Tensor,
+            spatial_shapes: Tensor,
+            level_start_index: Tensor,
+            level_bias: Tensor,
+        ) -> Tensor:
+            return self.attention(
+                query,
+                reference_points,
+                input_flatten,
+                spatial_shapes,
+                level_start_index,
+                input_spatial_shapes_hw=[(2, 2), (2, 2), (2, 2)],
+                level_bias=level_bias,
+            )
+
+    inputs = _inputs()
+    exported = torch.export.export(
+        ExportWrapper(),
+        args=(*inputs[:5], torch.randn(1, 3, 2, 3)),
+    )
+
+    tensor_ranks = [value.ndim for node in exported.graph.nodes if isinstance((value := node.meta.get("val")), Tensor)]
+    assert tensor_ranks
+    assert max(tensor_ranks) <= 5
