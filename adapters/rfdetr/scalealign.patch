+
+def test_compatible_parent_and_nested_assignments_remain_mutable() -> None:
+    """Compatible updates remain mutable and successful parent changes rebind the child."""
+    config = RFDETRSmallConfig(
+        projector_scale=["P3", "P5"],
+        scalealign={
+            "enabled": True,
+            "saa_enabled": True,
+            "feature_strides": [10.0, 20.0],
