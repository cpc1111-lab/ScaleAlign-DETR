@@ -0,0 +1,458 @@
+# ------------------------------------------------------------------------
+# RF-DETR
+# Copyright (c) 2025 Roboflow. All Rights Reserved.
+# Licensed under the Apache License, Version 2.0 [see LICENSE for details]
+# ------------------------------------------------------------------------
+"""Reduce saved ScaleAlign validation captures into QCD, R@K, and BAM JSON."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+import subprocess
+import warnings
+from collections.abc import Iterable, Iterator
+from pathlib import Path
+from typing import Any
+
+import torch
+from torch import Tensor
+
+from rfdetr.scalealign import proposal_recall_at_k
+from rfdetr.scalealign.diagnostics import (
+    box_attention_misalignment_statistics,
+    compute_saa_diagnostics,
+    correlation_from_moments,
+)
+
+
+def _sha256(path: Path) -> str:
+    """Return the SHA-256 of a capture file or ordered capture directory."""
+    digest = hashlib.sha256()
+    paths = (
+        sorted(item for item in path.iterdir() if item.is_file() and item.suffix == ".pt") if path.is_dir() else [path]
+    )
+    for item in paths:
+        if path.is_dir():
+            digest.update(item.name.encode("utf-8"))
+        with item.open("rb") as stream:
+            for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+                digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _load_capture_shard(path: Path) -> dict[str, Any]:
+    """Load and validate one capture shard."""
+    capture = torch.load(path, map_location="cpu", weights_only=True)
+    if not isinstance(capture, dict):
+        raise ValueError("each capture shard must contain exactly one capture dictionary")
+    return capture
+
+
+def _iter_captures(path: Path, *, allow_legacy_monolith: bool = False) -> Iterator[dict[str, Any]]:
+    """Yield lexically ordered one-capture shards, releasing each before the next load.
+
+    A directory of ``.pt`` files is the bounded-memory input contract. A monolithic file is accepted only through the
+    explicit legacy opt-in because ``torch.load`` materializes the entire file before yielding its first capture.
+    """
+    if path.is_dir():
+        shards = sorted(item for item in path.iterdir() if item.is_file() and item.suffix == ".pt")
+        if not shards:
+            raise ValueError("sharded capture directory must contain at least one .pt file")
+        for shard in shards:
+            capture = _load_capture_shard(shard)
+            yield capture
+            del capture
+        return
+
+    if not allow_legacy_monolith:
+        raise ValueError(
+            "--captures must name a sharded capture directory; use --allow-legacy-monolith to load a legacy file"
+        )
+    warnings.warn(
+        "legacy monolithic input loads the entire capture file into memory before reduction",
+        RuntimeWarning,
+        stacklevel=2,
+    )
+    loaded = torch.load(path, map_location="cpu", weights_only=True)
+    if isinstance(loaded, dict):
+        yield loaded
+        return
+    if not isinstance(loaded, list) or not all(isinstance(capture, dict) for capture in loaded):
+        raise ValueError("legacy capture file must contain a dictionary or list of dictionaries")
+    yield from loaded
+
+
+def _finite_float(value: float | Tensor) -> float:
+    """Convert a scalar to a finite JSON-safe Python float."""
+    number = float(value.item()) if isinstance(value, Tensor) else float(value)
+    if not math.isfinite(number):
+        raise ValueError("diagnostic metrics must be finite")
+    return number
+
+
+def _query_log_scale(layer: dict[str, Any]) -> Tensor:
+    """Read the current scale state while accepting earlier capture spelling."""
+    for key in ("query_log_scale", "current_log_scale", "log_scale"):
+        value = layer.get(key)
+        if isinstance(value, Tensor):
+            return value
+    raise ValueError("SAA attention layers must contain the current query log scale")
+
+
+def _saa_capture_state(layer: dict[str, Any]) -> bool:
+    """Validate all-or-none SAA capture fields and return whether they exist."""
+    query_keys = [key for key in ("query_log_scale", "current_log_scale", "log_scale") if key in layer]
+    present = (bool(query_keys), "pre_saa_logits" in layer, "log_strides" in layer)
+    if any(present) and not all(present):
+        raise ValueError("attention layer must contain all SAA fields or none")
+    if len(query_keys) > 1:
+        raise ValueError("attention layer must contain exactly one query log-scale field")
+    return all(present)
+
+
+def _validate_current_stage(layer: dict[str, Any], query_log_scale: Tensor) -> None:
+    """Ensure the captured scale state was derived from this layer's current boxes."""
+    boxes = layer["boxes"]
+    if not isinstance(boxes, Tensor) or not boxes.is_floating_point() or not query_log_scale.is_floating_point():
+        raise ValueError("boxes and query_log_scale must be floating-point tensors")
+    geometry = boxes.detach().to(dtype=query_log_scale.dtype, device=query_log_scale.device)
+    width, height = geometry[..., 2:].clamp(1e-6, 1.0).unbind(-1)
+    expected = 0.5 * (torch.log(width) + torch.log(height))
+    if query_log_scale.shape != expected.shape:
+        raise ValueError("query_log_scale does not agree with the attention layer's current boxes")
+    lower = torch.nextafter(expected, torch.full_like(expected, -torch.inf))
+    upper = torch.nextafter(expected, torch.full_like(expected, torch.inf))
+    one_ulp = torch.maximum(expected - lower, upper - expected)
+    agrees = (query_log_scale.detach() - expected).abs() <= one_ulp
+    if not bool(agrees.all()):
+        raise ValueError("query_log_scale does not agree with the attention layer's current boxes")
+
+
+def _add_tensor(statistics: dict[str, Tensor], key: str, value: Tensor) -> None:
+    """Merge one small sufficient-statistic tensor on CPU."""
+    value = value.detach().cpu()
+    if key not in statistics:
+        statistics[key] = value.clone()
+    else:
+        if statistics[key].shape != value.shape:
+            raise ValueError(f"diagnostic statistic shape changed for {key}")
+        statistics[key] += value
+
+
+def _ratio(numerator: Tensor | float, denominator: Tensor | float) -> float | None:
+    """Return a finite ratio, or null when its support is zero."""
+    denominator_value = _finite_float(denominator)
+    return _finite_float(numerator) / denominator_value if denominator_value > 0.0 else None
+
+
+def _metric_record(layer: int, head: int, value: float | None, support_count: int) -> dict[str, Any]:
+    """Build an explicitly supported per-layer/head JSON record."""
+    return {
+        "layer": layer,
+        "head": head,
+        "value": value,
+        "defined": value is not None,
+        "support_count": support_count,
+    }
+
+
+def reduce_captures(captures: Iterable[dict[str, Any]], image_size: int, iou_threshold: float) -> dict[str, Any]:
+    """Aggregate detached validation capture dictionaries.
+
+    Each capture contains ``proposals`` (B,K,4), ``targets`` (list of tensors), optional ``qcd``, and optional
+    ``attention_layers`` entries with ``boxes``, ``sampling_locations``, and ``attention_weights`` tensors.
+
+    Args:
+        captures: Detached per-batch capture dictionaries.
+        image_size: Square input side used for COCO area bins.
+        iou_threshold: Proposal recall IoU threshold.
+
+    Returns:
+        JSON-serializable QCD, recall, and BAM summary.
+    """
+    recall_matches = {key: 0.0 for key in ("overall", "small", "medium", "large")}
+    recall_counts = {key: 0 for key in recall_matches}
+    staged_recall_matches = {stage: {key: 0.0 for key in recall_matches} for stage in ("pre_sgqg", "post_sgqg")}
+    staged_recall_counts = {stage: {key: 0 for key in recall_matches} for stage in staged_recall_matches}
+    staged_qcd_sum = {stage: 0.0 for stage in staged_recall_matches}
+    staged_qcd_count = {stage: 0 for stage in staged_recall_matches}
+    qcd_sum = 0.0
+    qcd_count = 0
+    capture_batches = 0
+    qcd_capture_batches = 0
+    attention_capture_batches = 0
+    saa_capture_batches = 0
+    capture_schema: bool | None = None
+    bam_layers: dict[int, dict[str, Tensor]] = {}
+    saa_layers: dict[int, dict[str, Tensor]] = {}
+
+    def merge_capture(capture: dict[str, Any]) -> None:
+        """Reduce one capture without retaining aliases to its full tensors."""
+        nonlocal capture_batches
+        nonlocal qcd_sum, qcd_count, qcd_capture_batches
+        nonlocal attention_capture_batches, saa_capture_batches, capture_schema
+        capture_batches += 1
+        recall = proposal_recall_at_k(
+            capture["proposals"], capture["targets"], image_size=image_size, iou_threshold=iou_threshold
+        )
+        for key in recall_matches:
+            count = int(getattr(recall, f"{key}_count"))
+            recall_matches[key] += float(getattr(recall, key)) * count
+            recall_counts[key] += count
+        for stage in staged_recall_matches:
+            proposals = capture.get(f"{stage}_proposals")
+            if proposals is not None:
+                staged_recall = proposal_recall_at_k(
+                    proposals, capture["targets"], image_size=image_size, iou_threshold=iou_threshold
+                )
+                for key in recall_matches:
+                    count = int(getattr(staged_recall, f"{key}_count"))
+                    staged_recall_matches[stage][key] += float(getattr(staged_recall, key)) * count
+                    staged_recall_counts[stage][key] += count
+            qcd = capture.get(f"{stage}_qcd")
+            if qcd is not None:
+                values = qcd.detach().to(torch.float64).flatten()
+                if not bool(torch.isfinite(values).all()):
+                    raise ValueError("diagnostic metrics must be finite")
+                staged_qcd_sum[stage] += _finite_float(values.sum())
+                staged_qcd_count[stage] += values.numel()
+        if "qcd" in capture:
+            values = capture["qcd"].detach().to(torch.float64).flatten()
+            if not bool(torch.isfinite(values).all()):
+                raise ValueError("diagnostic metrics must be finite")
+            qcd_sum += _finite_float(values.sum())
+            qcd_count += values.numel()
+            qcd_capture_batches += 1
+        layers = capture.get("attention_layers", [])
+        if not isinstance(layers, list):
+            raise ValueError("attention_layers must be a list")
+        if not layers:
+            return
+        attention_capture_batches += 1
+        layer_schema: bool | None = None
+        for layer_index, layer in enumerate(layers):
+            required = {"boxes", "sampling_locations", "attention_weights"}
+            if not required <= set(layer):
+                raise ValueError("attention layer must contain boxes, sampling_locations, and attention_weights")
+            is_saa = _saa_capture_state(layer)
+            if layer_schema is None:
+                layer_schema = is_saa
+            elif layer_schema != is_saa:
+                raise ValueError("attention capture mixes legacy and SAA layers")
+
+            bam = box_attention_misalignment_statistics(
+                layer["boxes"], layer["sampling_locations"], layer["attention_weights"]
+            )
+            bam_stats = bam_layers.setdefault(layer_index, {})
+            _add_tensor(bam_stats, "outside_mass", bam.outside_mass)
+            _add_tensor(bam_stats, "total_mass", bam.total_mass)
+            _add_tensor(bam_stats, "support_count", bam.support_count)
+
+            if not is_saa:
+                continue
+            query_log_scale = _query_log_scale(layer)
+            _validate_current_stage(layer, query_log_scale)
+            diagnostics = compute_saa_diagnostics(
+                query_log_scale, layer["pre_saa_logits"], layer["attention_weights"], layer["log_strides"]
+            )
+            stats = saa_layers.setdefault(layer_index, {})
+            log_strides = diagnostics.log_strides.detach().to(torch.float64).cpu()
+            if "log_strides" in stats and not torch.equal(stats["log_strides"], log_strides):
+                raise ValueError("log_strides must remain constant for each layer and level")
+            stats.setdefault("log_strides", log_strides.clone())
+            for name in (
+                "pre_saa_level_mass_sum",
+                "post_saa_level_mass_sum",
+                "pre_saa_level_mass_support",
+                "post_saa_level_mass_support",
+                "scale_mismatch_count",
+                "scale_mismatch_support",
+                "correlation_count",
+                "correlation_sum_scale",
+                "correlation_sum_stride",
+                "correlation_sum_scale_squared",
+                "correlation_sum_stride_squared",
+                "correlation_sum_product",
+            ):
+                _add_tensor(stats, name, getattr(diagnostics, name))
+        assert layer_schema is not None
+        if capture_schema is None:
+            capture_schema = layer_schema
+        elif capture_schema != layer_schema:
+            raise ValueError("captures contain mixed legacy and SAA attention schemas")
+        if layer_schema:
+            saa_capture_batches += 1
+
+    capture_iterator = iter(captures)
+    while True:
+        try:
+            capture = next(capture_iterator)
+        except StopIteration:
+            break
+        merge_capture(capture)
+        del capture
+
+    bam_per_layer: dict[str, float | None] = {}
+    bam_per_layer_support: dict[str, int] = {}
+    bam_per_head: list[dict[str, Any]] = []
+    bam_outside_total = 0.0
+    bam_mass_total = 0.0
+    bam_support_total = 0
+    for layer_index, statistics in sorted(bam_layers.items()):
+        outside = statistics["outside_mass"]
+        mass = statistics["total_mass"]
+        support = statistics["support_count"]
+        bam_per_layer[str(layer_index)] = _ratio(outside.sum(), mass.sum())
+        bam_per_layer_support[str(layer_index)] = int(support.sum().item())
+        bam_outside_total += _finite_float(outside.sum())
+        bam_mass_total += _finite_float(mass.sum())
+        bam_support_total += int(support.sum().item())
+        for head_index in range(outside.shape[0]):
+            bam_per_head.append(
+                _metric_record(
+                    layer_index,
+                    head_index,
+                    _ratio(outside[head_index], mass[head_index]),
+                    int(support[head_index].item()),
+                )
+            )
+
+    result = {
+        "diagnostic_schema_version": 2,
+        "capture_batches": capture_batches,
+        "qcd_capture_batches": qcd_capture_batches,
+        "attention_capture_batches": attention_capture_batches,
+        "saa_capture_batches": saa_capture_batches,
+        "qcd_mean": qcd_sum / qcd_count if qcd_count else None,
+        "qcd_support_count": qcd_count,
+        "proposal_recall_at_k": {
+            key: recall_matches[key] / recall_counts[key] if recall_counts[key] else None for key in recall_matches
+        },
+        "proposal_target_counts": recall_counts,
+        "bam_mean": bam_outside_total / bam_mass_total if bam_mass_total > 0.0 else None,
+        "bam_support_count": bam_support_total,
+        "bam_per_layer": bam_per_layer,
+        "bam_per_layer_support": bam_per_layer_support,
+        "bam_per_head": bam_per_head,
+        "iou_threshold": iou_threshold,
+        "image_size": image_size,
+    }
+    for stage in staged_recall_matches:
+        result[f"{stage}_qcd_mean"] = (
+            staged_qcd_sum[stage] / staged_qcd_count[stage] if staged_qcd_count[stage] else None
+        )
+        result[f"{stage}_qcd_support_count"] = staged_qcd_count[stage]
+        result[f"{stage}_proposal_recall_at_k"] = {
+            key: (
+                staged_recall_matches[stage][key] / staged_recall_counts[stage][key]
+                if staged_recall_counts[stage][key]
+                else None
+            )
+            for key in recall_matches
+        }
+        result[f"{stage}_proposal_target_counts"] = staged_recall_counts[stage]
+    for metric_name in ("pre_saa_level_mass", "post_saa_level_mass"):
+        records: list[dict[str, Any]] = []
+        prefix = metric_name.split("_", maxsplit=1)[0]
+        for layer_index, statistics in sorted(saa_layers.items()):
+            mass_sum = statistics[f"{prefix}_saa_level_mass_sum"]
+            support = statistics[f"{prefix}_saa_level_mass_support"]
+            for head_index in range(mass_sum.shape[0]):
+                count = int(support[head_index].item())
+                for level_index in range(mass_sum.shape[1]):
+                    mass = _finite_float(mass_sum[head_index, level_index]) / count if count else None
+                    records.append(
+                        {
+                            "layer": layer_index,
+                            "head": head_index,
+                            "level": level_index,
+                            "log_stride": _finite_float(statistics["log_strides"][level_index]),
+                            "mass": mass,
+                            "defined": mass is not None,
+                            "support_count": count,
+                        }
+                    )
+        result[metric_name] = records
+
+    mismatch_records: list[dict[str, Any]] = []
+    correlation_records: list[dict[str, Any]] = []
+    for layer_index, statistics in sorted(saa_layers.items()):
+        correlation = correlation_from_moments(
+            statistics["correlation_count"],
+            statistics["correlation_sum_scale"],
+            statistics["correlation_sum_stride"],
+            statistics["correlation_sum_scale_squared"],
+            statistics["correlation_sum_stride_squared"],
+            statistics["correlation_sum_product"],
+        )
+        for head_index in range(correlation.shape[0]):
+            mismatch_support = int(statistics["scale_mismatch_support"][head_index].item())
+            mismatch_records.append(
+                _metric_record(
+                    layer_index,
+                    head_index,
+                    _ratio(statistics["scale_mismatch_count"][head_index], mismatch_support),
+                    mismatch_support,
+                )
+            )
+            correlation_value = (
+                _finite_float(correlation[head_index]) if bool(torch.isfinite(correlation[head_index])) else None
+            )
+            correlation_records.append(
+                _metric_record(
+                    layer_index,
+                    head_index,
+                    correlation_value,
+                    int(statistics["correlation_count"][head_index].item()),
+                )
+            )
+    result["scale_mismatch_rate"] = mismatch_records
+    result["scale_stride_correlation"] = correlation_records
+    return result
+
+
+def main() -> None:
+    """Load trusted local tensor captures and write a provenance-rich JSON report."""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--captures",
+        type=Path,
+        required=True,
+        help="Directory of lexically ordered .pt shards, with exactly one capture dictionary per file.",
+    )
+    parser.add_argument(
+        "--allow-legacy-monolith",
+        action="store_true",
+        help="Allow a legacy .pt file that is loaded entirely into memory (unbounded; not recommended).",
+    )
+    parser.add_argument("--checkpoint", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--image-size", type=int, default=880)
+    parser.add_argument("--iou-threshold", type=float, default=0.5)
+    args = parser.parse_args()
+    legacy_monolith = not args.captures.is_dir()
+    result = reduce_captures(
+        _iter_captures(args.captures, allow_legacy_monolith=args.allow_legacy_monolith),
+        args.image_size,
+        args.iou_threshold,
+    )
+    result.update(
+        {
+            "capture_storage": "legacy_monolith" if legacy_monolith else "sharded_directory",
+            "bounded_memory_capture_loading": not legacy_monolith,
+            "legacy_monolith_opt_in": bool(args.allow_legacy_monolith),
+            "checkpoint": str(args.checkpoint.resolve()),
+            "checkpoint_sha256": _sha256(args.checkpoint.resolve()),
+            "captures_sha256": _sha256(args.captures.resolve()),
+            "git_commit": subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip(),
+        }
+    )
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, indent=2, allow_nan=False), encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
