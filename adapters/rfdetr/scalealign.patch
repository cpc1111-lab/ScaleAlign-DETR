+# ------------------------------------------------------------------------
+# RF-DETR
+# Copyright (c) 2025 Roboflow. All Rights Reserved.
+# Licensed under the Apache License, Version 2.0 [see LICENSE for details]
+# ------------------------------------------------------------------------
+"""Tests for ScaleAlign bias injection in multi-scale deformable attention."""
+
+from __future__ import annotations
+
+import copy
+
+import pytest
+import torch
+from torch import Tensor
+
+from rfdetr.models.ops.modules.ms_deform_attn import MSDeformAttn
+
+
+def _inputs(
+    *, batch_size: int = 1, num_queries: int = 3, d_model: int = 8, n_levels: int = 3
+) -> tuple[Tensor, Tensor, Tensor, Tensor, Tensor, list[tuple[int, int]]]:
+    spatial_shapes_hw = [(2, 2)] * n_levels
+    input_length = sum(height * width for height, width in spatial_shapes_hw)
+    query = torch.randn(batch_size, num_queries, d_model)
+    reference_points = torch.full((batch_size, num_queries, n_levels, 2), 0.5)
+    input_flatten = torch.randn(batch_size, input_length, d_model)
+    spatial_shapes = torch.tensor(spatial_shapes_hw, dtype=torch.long)
+    level_start_index = torch.arange(n_levels, dtype=torch.long) * 4
+    return query, reference_points, input_flatten, spatial_shapes, level_start_index, spatial_shapes_hw
+
+
+def _run(attention: MSDeformAttn, *, level_bias: Tensor | None = None) -> Tensor:
+    query, reference_points, input_flatten, spatial_shapes, level_start_index, spatial_shapes_hw = _inputs(
+        d_model=attention.d_model, n_levels=attention.n_levels
+    )
+    return attention(
+        query,
+        reference_points,
+        input_flatten,
+        spatial_shapes,
+        level_start_index,
+        input_spatial_shapes_hw=spatial_shapes_hw,
+        level_bias=level_bias,
+    )
+
+
+@pytest.mark.parametrize("pretrained_level_index", [-1, 3])
+def test_pretrained_level_index_must_be_in_range(pretrained_level_index: int) -> None:
+    with pytest.raises(ValueError, match="pretrained_level_index"):
+        MSDeformAttn(d_model=8, n_levels=3, n_heads=2, n_points=2, pretrained_level_index=pretrained_level_index)
+
+
+def test_pretrained_level_index_requires_multiple_levels() -> None:
+    with pytest.raises(ValueError, match="n_levels.*at least 2"):
+        MSDeformAttn(d_model=8, n_levels=1, n_heads=2, n_points=2, pretrained_level_index=0)
+
+
+def test_default_parameter_names_and_shapes_are_unchanged() -> None:
+    attention = MSDeformAttn(d_model=8, n_levels=3, n_heads=2, n_points=2)
+
