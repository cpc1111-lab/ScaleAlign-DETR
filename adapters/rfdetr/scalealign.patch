+        if "scalealign" in name or ".aux_sampling_offsets." in name or ".aux_attention_weights." in name:
+            assert group["lr"] == pytest.approx(_args().lr * _args().lr_component_decay)
+        if "backbone.0.projector." in name:
+            assert group["lr"] == pytest.approx(_args().lr)
