+    assert isinstance(copied_decoder, _CaptureDecoder)
+    assert copied.transformer.scalealign_state is not owner.transformer.scalealign_state
+    assert copied_decoder.scale_state_model is copied.transformer.scalealign_state
+    assert copied_decoder.scalealign_bbox_embed is copied.bbox_embed
+    state_keys = copied.state_dict().keys()
+    assert sum(key.startswith("transformer.scalealign_state.") for key in state_keys) > 0
+    assert not any("decoder.scalealign_state" in key or "decoder.scalealign_bbox" in key for key in state_keys)
