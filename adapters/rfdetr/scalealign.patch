+# ------------------------------------------------------------------------
+"""Tests for complete Scale-Aligned Attention routing diagnostics."""
+
+import math
+from unittest.mock import patch
+
+import pytest
+import torch
+from torch import nn
+
+from rfdetr.models.transformer import Transformer
+from rfdetr.scalealign import ScaleAlignConfig
+from rfdetr.scalealign.capture import ScaleAlignDiagnosticShardWriter
+from rfdetr.scalealign.diagnostics import compute_saa_diagnostics
+from tools.analyze_scalealign import _iter_captures, reduce_captures
+
+
+def _routing_tensors(
+    *, reversed_attention: bool = False, dtype: torch.dtype = torch.float32
+) -> dict[str, torch.Tensor]:
+    query_log_scale = torch.tensor([[-3.0, -1.0]], dtype=dtype, requires_grad=True)
+    pre_saa_logits = torch.zeros((1, 2, 2, 3, 1), dtype=dtype, requires_grad=True)
+    attention_weights = torch.zeros((1, 2, 2, 3, 1), dtype=dtype, requires_grad=True)
+    selected_levels = (2, 0) if reversed_attention else (0, 2)
+    with torch.no_grad():
+        for query, level in enumerate(selected_levels):
+            attention_weights[0, query, :, level, 0] = 1.0
+    return {
+        "query_log_scale": query_log_scale,
+        "pre_saa_logits": pre_saa_logits,
+        "attention_weights": attention_weights,
+        "log_strides": torch.tensor([math.log(8.0), math.log(16.0), math.log(32.0)], dtype=dtype, requires_grad=True),
+    }
+
+
+def test_saa_diagnostics_store_detached_inputs_and_per_head_metrics() -> None:
+    tensors = _routing_tensors()
+
+    diagnostics = compute_saa_diagnostics(**tensors)
+
+    assert diagnostics.query_log_scale.shape == (1, 2)
+    assert diagnostics.pre_saa_logits.shape == (1, 2, 2, 3, 1)
+    assert diagnostics.attention_weights.shape == (1, 2, 2, 3, 1)
+    assert diagnostics.log_strides.shape == (3,)
+    assert all(
+        not value.requires_grad
+        for value in (
+            diagnostics.query_log_scale,
+            diagnostics.pre_saa_logits,
+            diagnostics.attention_weights,
+            diagnostics.log_strides,
+        )
+    )
+    torch.testing.assert_close(diagnostics.pre_saa_level_mass, torch.full((2, 3), 1.0 / 3.0, dtype=torch.float64))
+    torch.testing.assert_close(
+        diagnostics.post_saa_level_mass,
+        torch.tensor([[0.5, 0.0, 0.5], [0.5, 0.0, 0.5]], dtype=torch.float64),
+    )
+    torch.testing.assert_close(diagnostics.scale_mismatch_rate, torch.zeros(2, dtype=torch.float64))
+    torch.testing.assert_close(diagnostics.scale_stride_correlation, torch.ones(2, dtype=torch.float64))
+
+
+def test_real_multilevel_forward_writes_analyzable_bounded_shard(tmp_path) -> None:
+    transformer = Transformer(
+        d_model=8,
+        num_queries=2,
+        num_decoder_layers=2,
+        sa_nhead=2,
+        ca_nhead=2,
+        num_feature_levels=3,
+        dec_n_points=1,
+        return_intermediate_dec=True,
+        lite_refpoint_refine=True,
+        two_stage=True,
+        bbox_reparam=True,
+        scalealign=ScaleAlignConfig(
+            enabled=True,
+            diagnostics=True,
+            saa_enabled=True,
+            feature_strides=[8.0, 16.0, 32.0],
+            pretrained_level_index=1,
+        ),
+    ).eval()
+    transformer.enc_out_class_embed = nn.ModuleList([nn.Linear(8, 3)])
+    transformer.enc_out_bbox_embed = nn.ModuleList([nn.Linear(8, 4)])
+    bbox_head = nn.Linear(8, 4)
+    srcs = [torch.randn(1, 8, size, size) for size in (2, 1, 1)]
+    masks = [torch.zeros(1, size, size, dtype=torch.bool) for size in (2, 1, 1)]
+    transformer(
+        srcs,
+        masks,
+        [torch.zeros_like(src) for src in srcs],
+        torch.zeros(2, 4),
+        torch.randn(2, 8),
+        scalealign_bbox_embed=bbox_head,
+    )
+    diagnostics = transformer.scalealign_diagnostics
+    assert diagnostics is not None
+    target = {"boxes": diagnostics.selected_boxes[0, :1].detach()}
+    wrapper = nn.Module()
+    wrapper.transformer = transformer
+    module = type("Module", (), {"model": wrapper})()
+    trainer = type("Trainer", (), {"is_global_zero": True, "sanity_checking": True})()
+    writer = ScaleAlignDiagnosticShardWriter(tmp_path, max_batches=1)
+    writer.setup(trainer, module, "fit")
+
+    writer.on_validation_batch_end(trainer, module, None, (None, [target]), 0)
+    assert writer._written == 0
+    assert not list(tmp_path.glob("*.pt"))
+
+    trainer.sanity_checking = False
+    writer.on_validation_batch_end(trainer, module, None, (None, [target]), 0)
+    writer.on_validation_batch_end(trainer, module, None, (None, [target]), 1)
+
+    shards = list(tmp_path.glob("*.pt"))
+    assert len(shards) == 1
+    capture = torch.load(shards[0], map_location="cpu", weights_only=True)
+    assert capture["candidate_pool"].shape[1] > capture["post_sgqg_proposals"].shape[1]
+    assert capture["selected_sgqg_indices"].shape[1] == 2
+    assert len(capture["attention_layers"]) == 2
+    assert not any(
+        tensor.requires_grad
+        for layer in capture["attention_layers"]
+        for tensor in layer.values()
+        if isinstance(tensor, torch.Tensor)
+    )
+    result = reduce_captures(_iter_captures(tmp_path), image_size=100, iou_threshold=0.5)
+    assert result["pre_sgqg_qcd_support_count"] == 1
+    assert result["post_sgqg_qcd_support_count"] == 1
+    assert result["pre_sgqg_proposal_recall_at_k"]["overall"] is not None
+    assert result["post_sgqg_proposal_recall_at_k"]["overall"] == pytest.approx(1.0)
+    assert result["saa_capture_batches"] == 1
+
+
+def test_diagnostic_writer_preserves_existing_shards_across_validation_resume(tmp_path) -> None:
+    existing = tmp_path / "capture-000000.pt"
+    torch.save({"existing": True}, existing)
+    trainer = type("Trainer", (), {"is_global_zero": True})()
+    writer = ScaleAlignDiagnosticShardWriter(tmp_path, max_batches=2)
+
+    writer.setup(trainer, object(), "validate")
+
+    assert writer._written == 1
+    assert torch.load(existing, weights_only=True) == {"existing": True}
+
