+def test_manual_accumulation_distillation_is_uniform_across_different_box_counts(tmp_path) -> None:
+    def run(box_counts):
+        config = ScaleAlignConfig(enabled=True, distill_class_weight=2.0, distill_warmup_epochs=2.0)
+        module, student, _, _ = _module(tmp_path, config, MagicMock(return_value=_InputTeacher()))
