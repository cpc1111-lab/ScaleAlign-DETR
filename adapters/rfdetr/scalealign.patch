+"""Tests for deterministic single-level to multi-level checkpoint remapping."""
+
+import json
+import os
+import re
+from dataclasses import FrozenInstanceError, asdict
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+import rfdetr.models.weights as weights_module
+from rfdetr.models.weights import MultiScaleLoadReport, load_pretrain_weights, remap_single_p4_to_multiscale
