+    provenance = _provenance()
+    callback = _write_checkpoint_manifest(output, provenance)
+
+    manifest = validate_checkpoint_manifest(last, provenance)
+
+    assert manifest["checkpoint"]["size"] == last.stat().st_size
+    assert len(manifest["checkpoint"]["sha256"]) == 64
+    assert manifest["run_id"]
+    assert manifest["run_contract_sha256"]
+    assert manifest["implementation_sha256"] == provenance["run_contract"]["implementation_sha256"]
+
+    original_sha256 = manifest["checkpoint"]["sha256"]
+    last.write_bytes(b"valid next-epoch lightning checkpoint")
+    callback.on_validation_end(MagicMock(), MagicMock())
+    refreshed = validate_checkpoint_manifest(last, provenance)
+    assert refreshed["checkpoint"]["sha256"] != original_sha256
