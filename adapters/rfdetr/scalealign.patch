+
+def test_training_uses_supported_builder_and_resume_contract() -> None:
+    """The launcher must route budgets and resume state through build_trainer."""
+    model_config, train_config = load_training_configs(Path("/tmp/last.ckpt"))
+    trainer = MagicMock()
+
+    with (
+        patch("rfdetr.training.module_model.RFDETRModelModule") as module_class,
+        patch("rfdetr.training.module_data.RFDETRDataModule") as data_class,
+        patch("rfdetr.training.trainer.build_trainer", return_value=trainer) as build_trainer,
