+class CheckpointManifestCallback(Checkpoint):
+    """Atomically bind completed ``last.ckpt`` bytes to immutable run provenance.
+
+    The callback is a Lightning checkpoint-monitoring callback appended after Trainer construction, behind RF-DETR's
+    checkpoint callbacks. It hashes only stable bytes after epoch/validation checkpoint hooks. The checkpoint is written
+    first and the sidecar is atomically replaced second; therefore a crash in between leaves a missing or stale manifest
+    and resume fails closed instead of accepting unaudited checkpoint bytes.
+    """
+
+    def __init__(self, output_dir: Path, provenance: dict[str, Any]) -> None:
+        super().__init__()
+        self.checkpoint_path = output_dir / "last.ckpt"
+        self.manifest_path = output_dir / "last.ckpt.manifest.json"
+        self.run_id = _json_sha256(provenance)
+        self.run_contract_sha256 = _json_sha256(provenance["run_contract"])
+        self.implementation_sha256 = str(provenance["run_contract"]["implementation_sha256"])
+        self._last_checkpoint_stat: tuple[int, int] | None = None
+
+    def _refresh(self) -> None:
+        if not self.checkpoint_path.is_file():
+            return
+        before = self.checkpoint_path.stat()
+        checkpoint_stat = (before.st_size, before.st_mtime_ns)
+        if checkpoint_stat == self._last_checkpoint_stat:
+            return
+        checkpoint_sha256 = _file_sha256(self.checkpoint_path)
+        after = self.checkpoint_path.stat()
+        if (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
+            raise RuntimeError("last.ckpt changed while its provenance manifest was being computed")
+        manifest = {
+            "schema_version": 1,
+            "run_id": self.run_id,
+            "run_contract_sha256": self.run_contract_sha256,
+            "implementation_sha256": self.implementation_sha256,
+            "checkpoint": {
+                "name": self.checkpoint_path.name,
+                "size": after.st_size,
+                "sha256": checkpoint_sha256,
+            },
+        }
+        _atomic_write_json(self.manifest_path, manifest)
+        self._last_checkpoint_stat = checkpoint_stat
+
+    def on_train_batch_end(self, trainer: Any, pl_module: Any, outputs: Any, batch: Any, batch_idx: int) -> None:
+        """Refresh immediately after a step-cadence ``last.ckpt`` save."""
+        self._refresh()
+
+    def on_validation_end(self, trainer: Any, pl_module: Any) -> None:
+        """Refresh after validation-driven checkpoint saves."""
+        self._refresh()
+
+    def on_train_epoch_end(self, trainer: Any, pl_module: Any) -> None:
+        """Refresh after train-epoch-driven checkpoint saves."""
+        self._refresh()
+
+    def on_train_end(self, trainer: Any, pl_module: Any) -> None:
+        """Refresh once more after the final checkpoint save."""
+        self._refresh()
+
+
+def validate_checkpoint_manifest(checkpoint_path: Path, provenance: dict[str, Any]) -> dict[str, Any]:
+    """Verify actual resume checkpoint bytes against their trusted atomic sidecar."""
+    manifest_path = checkpoint_path.with_name(f"{checkpoint_path.name}.manifest.json")
+    if not manifest_path.is_file():
+        raise ValueError(f"checkpoint sidecar manifest does not exist: {manifest_path}")
+    try:
+        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError) as error:
+        raise ValueError(f"cannot read checkpoint sidecar manifest: {manifest_path}: {error}") from error
+    if not isinstance(manifest, dict) or not isinstance(manifest.get("checkpoint"), dict):
+        raise ValueError(f"checkpoint sidecar manifest is malformed: {manifest_path}")
+    checkpoint = manifest["checkpoint"]
+    expected = {
+        "schema_version": 1,
+        "run_id": _json_sha256(provenance),
+        "run_contract_sha256": _json_sha256(provenance["run_contract"]),
+        "implementation_sha256": provenance["run_contract"]["implementation_sha256"],
+        "checkpoint_name": checkpoint_path.name,
+        "checkpoint_size": checkpoint_path.stat().st_size,
+        "checkpoint_sha256": _file_sha256(checkpoint_path),
+    }
+    actual = {
+        "schema_version": manifest.get("schema_version"),
+        "run_id": manifest.get("run_id"),
+        "run_contract_sha256": manifest.get("run_contract_sha256"),
+        "implementation_sha256": manifest.get("implementation_sha256"),
+        "checkpoint_name": checkpoint.get("name"),
+        "checkpoint_size": checkpoint.get("size"),
+        "checkpoint_sha256": checkpoint.get("sha256"),
+    }
+    mismatched = sorted(key for key in expected if actual[key] != expected[key])
+    if mismatched:
+        raise ValueError(f"checkpoint manifest mismatch for: {', '.join(mismatched)}")
+    return manifest
+
+
+def load_training_configs(branch: str, resume: Path | None = None) -> tuple[ModelConfig, TrainConfig]:
+    """Materialize a fixed branch through its concrete Pydantic configuration types."""
+    from rfdetr.scalealign.plus_config import ScaleAlignRFDETR2XLargeMSConfig
+
+    raw = load_run_config(CONFIGS[branch])["model"]
+    model = raw["model_config"]
+    train = raw["train_config"]
+    if model.get("class_path") != MODEL_CLASS_PATH:
+        raise ValueError(f"{branch} config must use {MODEL_CLASS_PATH}")
+    if train.get("class_path") != TRAIN_CLASS_PATH:
+        raise ValueError(f"{branch} config must use {TRAIN_CLASS_PATH}")
+    train_args = dict(train["init_args"])
+    if resume is not None:
+        train_args["resume"] = str(resume)
+    model_config = ScaleAlignRFDETR2XLargeMSConfig(**model["init_args"])
+    train_config = TrainConfig(**train_args)
+    validate_architecture(branch, model_config, train_config)
+    return model_config, train_config
+
+
+def validate_architecture(branch: str, model_config: ModelConfig, train_config: TrainConfig) -> None:
+    """Validate the architecture and training invariants that define the matched pair."""
+    if list(model_config.projector_scale) != ["P3", "P4", "P5"]:
+        raise ValueError("projector_scale must be exactly P3/P4/P5")
+    if (model_config.resolution, model_config.dec_layers) != (880, 5):
+        raise ValueError("2XL architecture must use resolution 880 and five decoder layers")
+    if (model_config.num_queries, model_config.num_select, model_config.num_classes) != (300, 300, 90):
+        raise ValueError("2XL architecture must use 300 queries/select and COCO sparse num_classes=90")
+    scalealign = model_config.scalealign
+    if scalealign.pretrained_level_index != 1:
+        raise ValueError("pretrained_level_index must identify P4 at index 1")
+    expected_distillation = (0.25, 1.0, 0.25) if branch == "scalealign" else (0.0, 0.0, 0.0)
+    actual_distillation = (
+        scalealign.distill_class_weight,
+        scalealign.distill_box_weight,
+        scalealign.distill_warmup_epochs,
+    )
+    if actual_distillation != expected_distillation:
+        raise ValueError(
+            f"{branch} requires distillation class/box/warmup={expected_distillation!r}, found {actual_distillation!r}"
+        )
+    scalealign_contract = {
+        "scale_dim": 64,
+        "num_scale_anchors": 8,
+        "temperature": 0.25,
+        "coverage_weight": 0.5,
+        "coverage_warmup_epochs": 0.5,
+        "min_scale": 1.0 / 880.0,
+        "max_scale": 1.0,
+        "epsilon": 1e-6,
+        "feature_strides": [10.0, 20.0, 40.0],
+        "saa_rank": 32,
+        "saa_init_beta": -8.0,
+        "new_level_logit_prior": -6.0,
+        "new_level_prior_warmup_epochs": 0.5,
+        "pretrained_level_index": 1,
+    }
+    for name, expected in scalealign_contract.items():
+        if getattr(scalealign, name) != expected:
+            raise ValueError(f"ScaleAlign config requires {name}={expected!r}")
+    expected_enabled = branch == "scalealign"
+    active = (scalealign.enabled, scalealign.query_injection, scalealign.content_injection, scalealign.saa_enabled)
+    if active != (expected_enabled,) * 4:
+        raise ValueError(f"{branch} has inconsistent ScaleAlign activation")
+    if Path(str(model_config.pretrain_weights)).resolve() != CHECKPOINT.resolve():
+        raise ValueError("model must use the fixed official 2XL checkpoint")
+    if train_config.dataset_file != "coco" or Path(str(train_config.dataset_dir)) != COCO_ROOT:
+        raise ValueError("training must use the fixed local COCO dataset")
+    if train_config.batch_size != 1 or train_config.epochs != 1:
+        raise ValueError("training must use batch_size=1 for one capped epoch")
+    train_contract = {
+        "seed": 0,
+        "grad_accum_steps": 16,
+        "num_workers": 8,
+        "devices": 1,
+        "multi_scale": False,
+        "expanded_scales": False,
+        "square_resize_div_64": True,
+        "use_ema": False,
+        "eval_interval": 1,
+        "run_test": False,
+        "progress_bar": "tqdm",
+        "checkpoint_steps": 250,
+    }
+    for name, expected in train_contract.items():
+        if getattr(train_config, name) != expected:
+            raise ValueError(f"training config requires {name}={expected!r}")
+    if Path(str(train_config.output_dir)).resolve() != OUTPUT_DIRS[branch].resolve():
+        raise ValueError(f"{branch} config has an unexpected output directory")
+
+
+def validate_coco(dataset_dir: Path) -> dict[str, Any]:
+    """Validate official COCO files, image/annotation counts, and sparse ids."""
+    required = [dataset_dir / "train2017", dataset_dir / "val2017", dataset_dir / "annotations"]
+    missing = [str(path) for path in required if not path.exists()]
+    if missing:
+        raise ValueError("missing COCO 2017 paths: " + ", ".join(missing))
+    counts: dict[str, Any] = {}
+    official_category_ids = set(OFFICIAL_COCO_CATEGORY_IDS)
+    for split, expected in EXPECTED_COCO_COUNTS.items():
+        annotation_path = dataset_dir / f"annotations/instances_{split}2017.json"
+        if not annotation_path.is_file():
+            raise ValueError(f"missing COCO annotation file: {annotation_path}")
+        with annotation_path.open(encoding="utf-8") as stream:
+            annotation = json.load(stream)
+        image_records = len(annotation.get("images", []))
+        annotation_records = len(annotation.get("annotations", []))
+        image_files = sum(
+            1 for path in (dataset_dir / f"{split}2017").iterdir() if path.is_file() and path.suffix.lower() == ".jpg"
+        )
+        if image_records != expected["images"] or image_files != expected["images"]:
+            raise ValueError(
+                f"COCO {split}2017 must contain {expected['images']} images/files, found {image_records}/{image_files}"
+            )
+        if annotation_records != expected["annotations"]:
+            raise ValueError(
+                f"COCO {split}2017 must contain {expected['annotations']} annotations, found {annotation_records}"
+            )
+        category_ids = [category.get("id") for category in annotation.get("categories", [])]
+        if not category_ids or any(type(category_id) is not int or category_id <= 0 for category_id in category_ids):
+            raise ValueError(f"COCO {split}2017 categories must use positive integer ids")
+        duplicate_ids = sorted(category_id for category_id in set(category_ids) if category_ids.count(category_id) > 1)
+        if duplicate_ids:
+            raise ValueError(f"COCO {split}2017 has duplicate category IDs: {duplicate_ids}")
+        actual_category_ids = set(category_ids)
+        missing_ids = sorted(official_category_ids - actual_category_ids)
+        extra_ids = sorted(actual_category_ids - official_category_ids)
+        if missing_ids or extra_ids:
+            raise ValueError(
+                f"COCO {split}2017 category table differs from official sparse IDs; "
+                f"missing IDs={missing_ids}, extra IDs={extra_ids}"
+            )
+        for annotation_index, instance in enumerate(annotation.get("annotations", [])):
+            category_id = instance.get("category_id", _MISSING) if isinstance(instance, dict) else _MISSING
+            location = f"COCO {split}2017 annotation[{annotation_index}]"
+            if category_id is _MISSING:
+                raise ValueError(f"{location} is missing category_id")
+            if type(category_id) is not int:
+                raise ValueError(f"{location} has category_id={category_id!r}; expected an integer")
+            if category_id not in official_category_ids:
+                raise ValueError(f"{location} has category_id={category_id!r}; expected an official COCO category ID")
+        counts[split] = {
+            "image_files": image_files,
+            "image_records": image_records,
+            "annotation_records": annotation_records,
+        }
+    counts["category_ids"] = list(OFFICIAL_COCO_CATEGORY_IDS)
+    counts["category_count"] = len(OFFICIAL_COCO_CATEGORY_IDS)
+    counts["min_category_id"] = OFFICIAL_COCO_CATEGORY_IDS[0]
+    counts["max_category_id"] = OFFICIAL_COCO_CATEGORY_IDS[-1]
+    return counts
+
+
+def validate_checkpoint(path: Path) -> str:
+    """Require the registered official RF-DETR-2XL checkpoint and return its MD5."""
+    if not path.is_file():
+        raise ValueError(f"official checkpoint does not exist: {path}")
+    digest = hashlib.md5(usedforsecurity=False)
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    actual = digest.hexdigest()
+    if actual != OFFICIAL_CHECKPOINT_MD5:
+        raise ValueError(f"official checkpoint MD5 mismatch: expected {OFFICIAL_CHECKPOINT_MD5}, found {actual}")
+    return actual
+
+
+def require_cuda(*, cuda_available: bool, dry_run: bool, allow_no_cuda: bool) -> None:
+    """Reject CPU training while allowing an explicit dry-run-only bypass."""
+    if allow_no_cuda and not dry_run:
+        raise ValueError("--allow-no-cuda is valid only with --dry-run")
+    if not cuda_available and not (dry_run and allow_no_cuda):
+        raise RuntimeError("CUDA is required for RF-DETR-2XL training")
+
+
+def resolve_resume_checkpoint(output_dir: Path, *, resume: bool) -> Path | None:
+    """Protect existing output and resolve the only supported resume checkpoint."""
+    if resume:
+        last = output_dir / "last.ckpt"
+        if not last.is_file():
+            raise ValueError(f"resume checkpoint does not exist: {last}")
+        return last
+    if output_dir.exists() and any(output_dir.iterdir()):
+        raise ValueError(f"output exists; pass --resume explicitly: {output_dir}")
+    return None
+
+
+def _load_report_metadata(report: MultiScaleLoadReport) -> dict[str, list[str]]:
+    if report.incompatible:
+        raise ValueError(f"multi-scale checkpoint load is incompatible: {report.incompatible}")
+    if not report.remapped or not report.initialized:
+        raise ValueError("multi-scale checkpoint load must remap P4 and initialize auxiliary branches")
+    return {key: list(value) for key, value in asdict(report).items()}
+
+
+def _validate_trainable_report(model: torch.nn.Module, report: FinetuneReport, *, include_scalealign: bool) -> None:
+    named_parameters = tuple(model.named_parameters())
+    actual_names = tuple(sorted(name for name, parameter in named_parameters if parameter.requires_grad))
+    if actual_names != tuple(sorted(report.trainable_names)):
+        raise ValueError("fine-tune report does not exactly match requires_grad parameters")
+    if report.total_tensors != len(named_parameters) or report.trainable_tensors != len(actual_names):
+        raise ValueError("fine-tune report tensor counts do not match the model")
+    total_parameters = sum(parameter.numel() for _, parameter in named_parameters)
+    trainable_parameters = sum(parameter.numel() for _, parameter in named_parameters if parameter.requires_grad)
+    if report.total_parameters != total_parameters or report.trainable_parameters != trainable_parameters:
+        raise ValueError("fine-tune report scalar counts do not match the model")
+    if sum(report.category_tensor_counts.values()) != report.trainable_tensors:
+        raise ValueError("fine-tune report category tensor counts do not cover all trainable tensors")
+    if sum(report.category_parameter_counts.values()) != report.trainable_parameters:
+        raise ValueError("fine-tune report category scalar counts do not cover all trainable parameters")
+    scalealign_tensors = report.category_tensor_counts["scalealign"]
+    if include_scalealign != (scalealign_tensors > 0):
+        raise ValueError("fine-tune report ScaleAlign category disagrees with branch")
+    for category in ("projector", "aux_deformable_attention"):
+        if report.category_tensor_counts[category] <= 0:
+            raise ValueError(f"fine-tune report must include {category} parameters")
+
+
+def _atomic_write_json(path: Path, value: dict[str, Any]) -> None:
+    """Atomically replace a JSON metadata file in its destination directory."""
+    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
+    temporary.write_text(json.dumps(value, indent=2), encoding="utf-8")
+    temporary.replace(path)
+
+
+def _model_signature(model_config: ModelConfig, model: torch.nn.Module | None = None) -> dict[str, Any]:
+    signature = {
+        "class": f"{type(model_config).__module__}.{type(model_config).__qualname__}",
+        "resolution": model_config.resolution,
+        "decoder_layers": model_config.dec_layers,
+        "queries": model_config.num_queries,
+        "select": model_config.num_select,
+        "projector_scale": list(model_config.projector_scale),
+        "pretrained_level_index": model_config.scalealign.pretrained_level_index,
+    }
+    if model is not None:
+        signature["parameter_tensors"] = sum(1 for _ in model.parameters())
+        signature["parameters"] = sum(parameter.numel() for parameter in model.parameters())
+    return signature
+
+
+def run_training(
+    branch: str,
+    model_config: ModelConfig,
+    train_config: TrainConfig,
+    *,
+    metadata: dict[str, Any] | None = None,
+    diagnostics_dir: Path | None = None,
+    diagnostics_max_batches: int = 16,
+) -> dict[str, Any]:
+    """Build, audit, record, and fit through the supported RF-DETR trainer."""
+    _startup_status(4, "Building RF-DETR-2XL and loading official weights")
+    from rfdetr.training.module_data import RFDETRDataModule
+    from rfdetr.training.module_model import RFDETRModelModule
+    from rfdetr.training.trainer import build_trainer
+
+    module = RFDETRModelModule(model_config, train_config)
+    load_report = getattr(module.model, "multiscale_load_report", None)
+    if load_report is None:
+        raise ValueError("model did not capture a MultiScaleLoadReport")
+    load_metadata = _load_report_metadata(load_report)
+    include_scalealign = branch == "scalealign"
+    finetune_report = configure_scalealign_ms_finetune(
+        module.model,
+        pretrained_level_index=1,
+        include_scalealign=include_scalealign,
+    )
+    _validate_trainable_report(module.model, finetune_report, include_scalealign=include_scalealign)
+    reports = {"load_report": load_metadata, "finetune_report": finetune_report.to_metadata()}
+    if metadata is not None:
+        metadata.update(reports)
+        metadata["model_signature"] = _model_signature(model_config, module.model)
+        output_dir = Path(str(train_config.output_dir))
+        output_dir.mkdir(parents=True, exist_ok=True)
+        metadata_name = "resume_metadata.json" if train_config.resume else "run_metadata.json"
+        _atomic_write_json(output_dir / metadata_name, metadata)
+    _startup_status(5, "Building COCO data module and Lightning trainer")
+    datamodule = RFDETRDataModule(model_config, train_config)
+    limit_train_batches = math.ceil(SAMPLE_BUDGET / int(train_config.batch_size))
+    trainer = build_trainer(train_config, model_config, limit_train_batches=limit_train_batches)
+    if diagnostics_dir is not None:
+        from rfdetr.scalealign.capture import ScaleAlignDiagnosticShardWriter
+
+        trainer.callbacks.append(ScaleAlignDiagnosticShardWriter(diagnostics_dir, diagnostics_max_batches))
+    if metadata is not None and isinstance(metadata.get("provenance"), dict):
+        trainer.callbacks.append(CheckpointManifestCallback(Path(str(train_config.output_dir)), metadata["provenance"]))
+    _startup_status(6, "Starting training; tqdm batch progress follows")
+    trainer.fit(module, datamodule, ckpt_path=str(train_config.resume) if train_config.resume else None)
+    return reports
+
+
+def main() -> None:
+    """Validate fixed inputs and either report or launch one matched branch."""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--branch", choices=tuple(CONFIGS), required=True)
+    parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--allow-no-cuda", action="store_true")
+    parser.add_argument("--resume", action="store_true")
+    parser.add_argument("--diagnostics-dir", type=Path)
+    parser.add_argument("--diagnostics-max-batches", type=int, default=16)
+    args = parser.parse_args()
+
+    _startup_status(2, "Validating CUDA, configs, COCO, and checkpoint")
+    require_cuda(cuda_available=torch.cuda.is_available(), dry_run=args.dry_run, allow_no_cuda=args.allow_no_cuda)
+    control = load_run_config(CONFIGS["control"])
+    treatment = load_run_config(CONFIGS["scalealign"])
+    assert_matched_configs(control, treatment)
+    seed = int(control["model"]["train_config"]["init_args"]["seed"])
+    seed_launch(seed)
+    counts = validate_coco(COCO_ROOT)
+    checkpoint_md5 = validate_checkpoint(CHECKPOINT)
+    _startup_status(3, "Resolving run state and configuration")
+    output_dir = OUTPUT_DIRS[args.branch]
+    resume_checkpoint = resolve_resume_checkpoint(output_dir, resume=args.resume)
+    selected_config = control if args.branch == "control" else treatment
+    provenance = build_provenance(args.branch, selected_config, counts, checkpoint_md5)
+    if args.resume:
+        validate_resume_provenance(output_dir, provenance)
+        if resume_checkpoint is None:  # pragma: no cover - guarded by resolve_resume_checkpoint
+            raise RuntimeError("resume checkpoint resolution unexpectedly returned None")
+        validate_checkpoint_manifest(resume_checkpoint, provenance)
+    model_config, train_config = load_training_configs(args.branch, resume_checkpoint)
+    if args.diagnostics_dir is not None:
+        if args.branch != "scalealign":
+            raise ValueError("diagnostic capture requires --branch scalealign")
+        if args.diagnostics_max_batches < 1:
+            raise ValueError("--diagnostics-max-batches must be positive")
+        model_config.scalealign.diagnostics = True
+    metadata = {
+        "branch": args.branch,
+        "command": [sys.executable, str(Path(__file__).resolve()), *sys.argv[1:]],
+        "config_path": str(CONFIGS[args.branch]),
+        "config": load_run_config(CONFIGS[args.branch]),
+        "dataset": str(COCO_ROOT),
+        "dataset_counts": counts,
+        "sample_budget": SAMPLE_BUDGET,
+        "checkpoint": str(CHECKPOINT),
+        "checkpoint_md5": checkpoint_md5,
+        "git_commit": _git_commit(),
+        "torch_version": torch.__version__,
+        "cuda_version": torch.version.cuda,
+        "cuda_available": torch.cuda.is_available(),
+        "cuda_device_count": torch.cuda.device_count(),
+        "model_signature": _model_signature(model_config),
+        "provenance": provenance,
+        "diagnostics": {
+            "enabled": args.diagnostics_dir is not None,
+            "directory": None if args.diagnostics_dir is None else str(args.diagnostics_dir.resolve()),
+            "max_batches": args.diagnostics_max_batches,
+        },
+    }
+    if torch.cuda.is_available():
+        metadata["cuda_device"] = torch.cuda.get_device_name(0)
+    if args.dry_run:
+        _startup_status(6, "Dry run complete; training was not started")
+        print(json.dumps(metadata, indent=2))
+        return
+    run_training(
+        args.branch,
+        model_config,
+        train_config,
+        metadata=metadata,
+        diagnostics_dir=args.diagnostics_dir,
+        diagnostics_max_batches=args.diagnostics_max_batches,
+    )
+
+
+if __name__ == "__main__":
+    main()
