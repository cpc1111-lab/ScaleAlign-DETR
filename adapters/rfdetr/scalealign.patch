+            self.transformer = _build_transformer(
+                ScaleAlignConfig(
+                    enabled=True,
+                    query_injection=False,
+                    content_injection=False,
+                    saa_enabled=True,
+                    feature_strides=[8.0, 16.0],
+                ),
+                num_feature_levels=2,
+            )
+            self.bbox_embed = nn.Linear(8, 4)
+            self.transformer.decoder = _CaptureDecoder()
+
+    owner = Owner()
+    copied = copy.deepcopy(owner)
+    src = torch.zeros(1, 8, 2, 2)
