+# ------------------------------------------------------------------------
+# RF-DETR
+# Copyright (c) 2025 Roboflow. All Rights Reserved.
+# Licensed under the Apache License, Version 2.0 [see LICENSE for details]
+# ------------------------------------------------------------------------
+"""Explicit continuous scale state derived from predicted boxes."""
+
+from dataclasses import dataclass
+
+import torch
+from torch import Tensor, nn
+
+
+@dataclass(frozen=True)
+class ScaleState:
+    """Continuous geometric state and its learned representation.
+
+    Attributes:
+        log_scale: Log geometric-mean width and height.
+        log_aspect: Log width-to-height ratio.
+        descriptor: Stacked ``(log_scale, log_aspect)`` coordinates.
+        embedding: Learned normalized scale-state representation.
+    """
+
+    log_scale: Tensor
+    log_aspect: Tensor
+    descriptor: Tensor
+    embedding: Tensor
+
+
+class ExplicitScaleModel(nn.Module):
+    """Convert normalized ``cxcywh`` boxes into stopped-gradient scale state."""
+
+    def __init__(self, scale_dim: int, epsilon: float = 1e-6) -> None:
+        """Initialize the scale embedding network.
+
+        Args:
+            scale_dim: Output embedding width.
+            epsilon: Positive lower bound applied before logarithms.
+        """
+        super().__init__()
+        if scale_dim < 1:
+            raise ValueError("scale_dim must be positive")
+        if epsilon <= 0.0:
+            raise ValueError("epsilon must be positive")
+        self.epsilon = epsilon
+        self.projection = nn.Sequential(
+            nn.Linear(2, scale_dim),
+            nn.GELU(),
+            nn.Linear(scale_dim, scale_dim),
+        )
+        self.norm = nn.LayerNorm(scale_dim)
+
+    def forward(self, boxes: Tensor) -> ScaleState:
+        """Build scale state without propagating gradients into box predictions.
+
+        Args:
+            boxes: Tensor ending in normalized ``(cx, cy, width, height)``.
+
+        Returns:
+            Explicit and learned scale state matching the leading box dimensions.
+
+        Raises:
+            ValueError: If the final box dimension is not four.
+        """
+        if boxes.shape[-1] != 4:
+            raise ValueError("boxes must end with four cxcywh coordinates")
+        geometry = boxes.detach()
+        width, height = geometry[..., 2:].clamp(self.epsilon, 1.0).unbind(-1)
+        log_width = torch.log(width)
+        log_height = torch.log(height)
+        log_scale = 0.5 * (log_width + log_height)
+        log_aspect = log_width - log_height
+        descriptor = torch.stack((log_scale, log_aspect), dim=-1)
+        embedding = self.norm(self.projection(descriptor))
+        return ScaleState(log_scale, log_aspect, descriptor, embedding)
