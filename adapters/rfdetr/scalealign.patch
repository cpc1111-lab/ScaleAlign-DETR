+# ------------------------------------------------------------------------
+"""Tests for matched RF-DETR-2XL COCO continuation definitions."""
+
+import json
+from pathlib import Path
+
+import pytest
+
+from scripts.run_equal_budget import _command, assert_equal_budget, load_run_config, validate_coco
+
+ROOT = Path(__file__).resolve().parents[2]
+BASELINE_CONFIG = ROOT / "configs/scalealign/rfdetr_2xl_baseline_coco.yaml"
+SCALEALIGN_CONFIG = ROOT / "configs/scalealign/rfdetr_2xl_esm_sgqg_coco.yaml"
+
+
+def test_equal_budget_configs_differ_only_in_scalealign_and_output() -> None:
+    """The paired definitions must isolate ScaleAlign as the model treatment."""
+    baseline = load_run_config(BASELINE_CONFIG)
+    improved = load_run_config(SCALEALIGN_CONFIG)
+
+    assert_equal_budget(baseline, improved)
+
+    baseline_model = baseline["model"]["model_config"]["init_args"]
+    improved_model = improved["model"]["model_config"]["init_args"]
+    assert baseline_model["scalealign"]["enabled"] is False
+    assert improved_model["scalealign"]["enabled"] is True
+    assert improved_model["scalealign"]["saa_enabled"] is False
+
+
+def test_coco_preflight_reports_missing_layout(tmp_path: Path) -> None:
+    """Preflight must list all absent COCO directories and annotations."""
+    with pytest.raises(ValueError, match="train2017"):
+        validate_coco(tmp_path)
+
+
+def test_coco_preflight_rejects_wrong_record_counts(tmp_path: Path) -> None:
+    """Directory names alone are insufficient; official JSON counts are required."""
+    (tmp_path / "train2017").mkdir()
+    (tmp_path / "val2017").mkdir()
+    annotations = tmp_path / "annotations"
+    annotations.mkdir()
+    (annotations / "instances_train2017.json").write_text(json.dumps({"images": [{}]}))
+    (annotations / "instances_val2017.json").write_text(json.dumps({"images": [{}]}))
+
+    with pytest.raises(ValueError, match="118287"):
+        validate_coco(tmp_path)
+
+
+def test_resume_command_forwards_branch_checkpoint(tmp_path: Path) -> None:
+    """Resume mode must restore Lightning state rather than only reuse a directory."""
+    output_dir = tmp_path / "baseline"
+    checkpoint = tmp_path / "official.pth"
+    resume = output_dir / "last.ckpt"
+
+    command = _command("baseline", tmp_path / "coco", checkpoint, output_dir, resume=resume)
+
+    assert command[-2:] == ["--model.train_config.init_args.resume", str(resume)]
