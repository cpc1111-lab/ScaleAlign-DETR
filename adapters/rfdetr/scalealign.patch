+# ------------------------------------------------------------------------
+# RF-DETR
+# Copyright (c) 2025 Roboflow. All Rights Reserved.
+# Licensed under the Apache License, Version 2.0 [see LICENSE for details]
+# ------------------------------------------------------------------------
+"""Scale-guided allocation of a fixed decoder-query budget."""
+
+import math
+from dataclasses import dataclass
+
+import torch
+from torch import Tensor, nn
+
+
+@dataclass(frozen=True)
+class QuerySelection:
+    """Selected candidates and detached scale-coverage diagnostics.
+
+    Attributes:
+        indices: Candidate indices occupying the query slots.
+        pool_distribution: Confidence-weighted candidate-pool scale distribution.
+        selected_distribution: Scale distribution of selected candidates.
+        qcd: KL divergence from the pool to the selected distribution.
+    """
+
+    indices: Tensor
+    pool_distribution: Tensor
+    selected_distribution: Tensor
+    qcd: Tensor
+
+
+class ScaleGuidedQueryGenerator(nn.Module):
+    """Balance candidate logits with continuous scale-distribution coverage."""
+
+    def __init__(
+        self,
+        num_anchors: int,
+        temperature: float,
+        min_scale: float = 1.0 / 880.0,
+        max_scale: float = 1.0,
+        epsilon: float = 1e-6,
+    ) -> None:
+        """Initialize ordered anchors in log geometric-scale space.
+
+        Args:
+            num_anchors: Number of scale anchors.
+            temperature: Positive Gaussian membership temperature.
+            min_scale: Smallest normalized scale represented by the anchors.
+            max_scale: Largest normalized scale represented by the anchors.
+            epsilon: Numerical probability floor.
+
+        Raises:
+            ValueError: If anchor or numerical parameters are invalid.
+        """
+        super().__init__()
+        if num_anchors < 2:
+            raise ValueError("num_anchors must be at least two")
+        if temperature <= 0.0:
+            raise ValueError("temperature must be positive")
+        if not 0.0 < min_scale < max_scale <= 1.0:
+            raise ValueError("scales must satisfy 0 < min_scale < max_scale <= 1")
+        if epsilon <= 0.0:
+            raise ValueError("epsilon must be positive")
+        self.num_anchors = num_anchors
+        self.temperature = temperature
+        self.epsilon = epsilon
+        anchors = torch.linspace(math.log(min_scale), math.log(max_scale), num_anchors)
+        self.register_buffer("anchors", anchors, persistent=True)
+
+    def membership(self, boxes: Tensor) -> Tensor:
+        """Compute soft membership of normalized boxes in ordered scale anchors.
+
+        Args:
+            boxes: Batched normalized ``cxcywh`` boxes of shape ``(B, N, 4)``.
+
+        Returns:
+            Membership tensor of shape ``(B, N, num_anchors)``.
+
+        Raises:
+            ValueError: If boxes do not have shape ``(B, N, 4)``.
+        """
+        if boxes.ndim != 3 or boxes.shape[-1] != 4:
+            raise ValueError("boxes must have shape (batch, candidates, 4)")
+        size = boxes.detach()[..., 2:].clamp(self.epsilon, 1.0)
+        log_scale = 0.5 * torch.log(size).sum(dim=-1, keepdim=True)
+        logits = -torch.square(log_scale - self.anchors) / self.temperature
+        return torch.softmax(logits, dim=-1)
+
+    def forward(self, scores: Tensor, boxes: Tensor, k: int, coverage_weight: float) -> QuerySelection:
+        """Select exactly ``k`` candidates using logits and scale coverage.
+
+        Args:
+            scores: Candidate foreground logits with shape ``(B, N)``.
+            boxes: Candidate normalized ``cxcywh`` boxes with shape ``(B, N, 4)``.
+            k: Fixed query budget.
+            coverage_weight: Nonnegative KL penalty multiplier.
+
+        Returns:
+            Selection indices and detached distribution diagnostics.
+
+        Raises:
+            ValueError: If shapes, query budget, or coverage weight are invalid.
+        """
+        if scores.ndim != 2:
+            raise ValueError("scores must have shape (batch, candidates)")
+        if boxes.shape[:2] != scores.shape:
+            raise ValueError("scores and boxes must share batch and candidate dimensions")
+        if k <= 0 or k > scores.shape[1]:
+            raise ValueError("k must be in [1, number of candidates]")
+        if coverage_weight < 0.0:
+            raise ValueError("coverage_weight must be nonnegative")
+
+        membership = self.membership(boxes)
+        confidence = scores.detach().sigmoid()
+        pool = (confidence.unsqueeze(-1) * membership).sum(dim=1)
+        pool = (pool / confidence.sum(dim=1, keepdim=True).clamp_min(self.epsilon)).detach()
+
+        if coverage_weight == 0.0:
+            indices = torch.topk(scores, k, dim=1).indices
+        else:
+            indices = self._greedy_indices(scores.detach(), membership, pool, k, coverage_weight)
+
+        gather_index = indices.unsqueeze(-1).expand(-1, -1, self.num_anchors)
+        selected_membership = membership.gather(1, gather_index)
+        selected = (selected_membership.sum(dim=1) + self.epsilon) / (k + self.num_anchors * self.epsilon)
+        qcd = (pool * (pool.clamp_min(self.epsilon).log() - selected.log())).sum(dim=-1)
+        return QuerySelection(indices, pool, selected.detach(), qcd.detach())
+
+    def _greedy_indices(
+        self,
+        scores: Tensor,
+        membership: Tensor,
+        pool: Tensor,
+        k: int,
+        coverage_weight: float,
+    ) -> Tensor:
+        """Perform deterministic exact greedy selection over every candidate."""
+        batch_size, num_candidates = scores.shape
+        selected_mask = torch.zeros((batch_size, num_candidates), dtype=torch.bool, device=scores.device)
+        selected_sum = torch.zeros_like(pool)
+        selected_indices: list[Tensor] = []
+        pool_log = pool.clamp_min(self.epsilon).log()
+
+        for step in range(k):
+            candidate_distribution = (selected_sum[:, None, :] + membership + self.epsilon) / (
+                step + 1 + self.num_anchors * self.epsilon
+            )
+            divergence = (pool[:, None, :] * (pool_log[:, None, :] - candidate_distribution.log())).sum(dim=-1)
+            gain = scores - coverage_weight * divergence
+            gain = gain.masked_fill(selected_mask, -torch.inf)
+            index = gain.argmax(dim=1)
+            selected_indices.append(index)
+            selected_mask.scatter_(1, index[:, None], True)
+            chosen = membership.gather(1, index[:, None, None].expand(-1, 1, self.num_anchors)).squeeze(1)
+            selected_sum = selected_sum + chosen
+
+        return torch.stack(selected_indices, dim=1)
