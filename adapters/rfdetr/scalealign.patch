+# ------------------------------------------------------------------------
+# RF-DETR
+# Copyright (c) 2025 Roboflow. All Rights Reserved.
+# Licensed under the Apache License, Version 2.0 [see LICENSE for details]
+# ------------------------------------------------------------------------
+"""Pure rank-matched losses for ScaleAlign warmup distillation."""
+
+from __future__ import annotations
+
+from typing import NamedTuple
+
+import torch
+import torch.nn.functional as F  # noqa: N812
+from torch import Tensor
+
+
+class DistillationLoss(NamedTuple):
+    """Classification and normalized-box loss scalars."""
+
+    class_loss: Tensor
+    box_loss: Tensor
+
+
+def warmup_multiplier(epoch_progress: float, warmup_epochs: float) -> float:
+    """Return a linear multiplier that is exactly zero at and after the boundary."""
+    if warmup_epochs <= 0.0 or epoch_progress >= warmup_epochs:
+        return 0.0
+    return max(0.0, 1.0 - max(0.0, epoch_progress) / warmup_epochs)
+
+
+def _validated_predictions(name: str, outputs: dict[str, Tensor]) -> tuple[Tensor, Tensor]:
+    for key in ("pred_logits", "pred_boxes"):
+        if key not in outputs:
+            raise KeyError(f"{name} outputs are missing {key}")
+        if not isinstance(outputs[key], Tensor):
+            raise TypeError(f"{name} {key} must be a tensor")
+    logits, boxes = outputs["pred_logits"], outputs["pred_boxes"]
+    if logits.ndim != 3 or boxes.ndim != 3 or boxes.shape[-1] != 4:
+        raise ValueError(f"{name} prediction shape must be pred_logits [B,Q,C], pred_boxes [B,Q,4]")
+    if logits.shape[:2] != boxes.shape[:2] or any(size == 0 for size in logits.shape):
+        raise ValueError(f"{name} prediction shapes must share non-empty batch/query/class dimensions")
+    if not logits.is_floating_point() or not boxes.is_floating_point():
+        raise TypeError(f"{name} predictions must have floating dtypes")
+    if logits.device != boxes.device:
+        raise ValueError(f"{name} logits and boxes must use the same device")
+    return logits, boxes
+
+
+def rank_matched_distillation_loss(
+    student_outputs: dict[str, Tensor],
+    teacher_outputs: dict[str, Tensor],
+) -> DistillationLoss:
+    """Match queries by confidence rank and compute detached-teacher KL/L1 losses.
+
+    Each Group-DETR student group is independently sorted by maximum foreground sigmoid score and paired with the same
+    independently ranked teacher queries. Stable sorting retains query-index order for exact ties. Classification uses
+    float32 Bernoulli KL ``KL(teacher || student)``, evaluated as BCE-with-logits minus teacher entropy and clamped at
+    zero to remove roundoff-only negative values.
+    """
+    student_logits, student_boxes = _validated_predictions("student", student_outputs)
+    teacher_logits, teacher_boxes = _validated_predictions("teacher", teacher_outputs)
+    if student_logits.shape[0] != teacher_logits.shape[0]:
+        raise ValueError("student and teacher batch sizes must match")
+    if student_logits.shape[2] != teacher_logits.shape[2]:
+        raise ValueError("student and teacher classes must match")
+    if student_logits.dtype != teacher_logits.dtype or student_boxes.dtype != teacher_boxes.dtype:
+        raise TypeError("student and teacher predictions must have matching dtypes")
+    if student_logits.device != teacher_logits.device or student_boxes.device != teacher_boxes.device:
+        raise ValueError("student and teacher predictions must use the same device")
+
+    teacher_queries = teacher_logits.shape[1]
+    student_queries = student_logits.shape[1]
+    if student_queries % teacher_queries != 0:
+        raise ValueError("student query count must be divisible by the teacher query count")
+    batch_size, classes = student_logits.shape[0], student_logits.shape[2]
+    groups = student_queries // teacher_queries
+    grouped_student_logits = student_logits.reshape(batch_size, groups, teacher_queries, classes)
+    grouped_student_boxes = student_boxes.reshape(batch_size, groups, teacher_queries, 4)
+    student_rank = torch.argsort(
+        grouped_student_logits.float().sigmoid().amax(dim=-1), dim=2, descending=True, stable=True
+    )
+    with torch.no_grad():
+        teacher_rank = torch.argsort(teacher_logits.float().sigmoid().amax(dim=-1), dim=1, descending=True, stable=True)
+    student_ranked_logits = grouped_student_logits.gather(2, student_rank.unsqueeze(-1).expand(-1, -1, -1, classes))
+    student_ranked_boxes = grouped_student_boxes.gather(2, student_rank.unsqueeze(-1).expand(-1, -1, -1, 4))
+    with torch.no_grad():
+        teacher_ranked_logits = teacher_logits.detach().gather(1, teacher_rank.unsqueeze(-1).expand(-1, -1, classes))
+        teacher_ranked_boxes = teacher_boxes.detach().gather(1, teacher_rank.unsqueeze(-1).expand(-1, -1, 4))
+        teacher_ranked_logits = teacher_ranked_logits[:, None].expand(-1, groups, -1, -1)
+        teacher_ranked_boxes = teacher_ranked_boxes[:, None].expand(-1, groups, -1, -1)
+        teacher_probability = teacher_ranked_logits.float().sigmoid()
+        teacher_entropy = F.binary_cross_entropy_with_logits(
+            teacher_ranked_logits.float(), teacher_probability, reduction="none"
+        )
+    class_loss = (
+        (
+            F.binary_cross_entropy_with_logits(student_ranked_logits.float(), teacher_probability, reduction="none")
+            - teacher_entropy
+        )
+        .mean()
+        .clamp_min(0.0)
+    )
+    box_loss = F.l1_loss(student_ranked_boxes, teacher_ranked_boxes)
+    return DistillationLoss(class_loss=class_loss, box_loss=box_loss)
