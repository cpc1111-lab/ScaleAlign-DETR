+def test_rank_matching_distills_every_student_group_and_is_group_permutation_invariant() -> None:
+    teacher_logits = torch.tensor([[[4.0], [-4.0]]])
+    teacher_boxes = torch.tensor([[[0.1, 0.1, 0.1, 0.1], [0.9, 0.9, 0.9, 0.9]]])
+    student_logits = torch.tensor([[[3.0], [-3.0], [1.0], [-1.0], [2.0], [-2.0]]], requires_grad=True)
+    student_boxes = torch.tensor(
+        [
+            [
+                [0.2, 0.2, 0.2, 0.2],
+                [0.8, 0.8, 0.8, 0.8],
+                [0.3, 0.3, 0.3, 0.3],
+                [0.7, 0.7, 0.7, 0.7],
+                [0.4, 0.4, 0.4, 0.4],
+                [0.6, 0.6, 0.6, 0.6],
+            ]
+        ],
+        requires_grad=True,
+    )
+    losses = rank_matched_distillation_loss(
+        _outputs(student_logits, student_boxes), _outputs(teacher_logits, teacher_boxes)
+    )
+    (losses.class_loss + losses.box_loss).backward()
+    assert student_logits.grad is not None
+    assert student_boxes.grad is not None
+    assert torch.all(student_logits.grad.reshape(3, 2).abs().sum(dim=1) > 0)
+    assert torch.all(student_boxes.grad.reshape(3, 2, 4).abs().sum(dim=(1, 2)) > 0)
+
+    group_permutation = torch.tensor([4, 5, 0, 1, 2, 3])
+    permuted_logits = student_logits.detach()[:, group_permutation].clone().requires_grad_()
+    permuted_boxes = student_boxes.detach()[:, group_permutation].clone().requires_grad_()
+    permuted = rank_matched_distillation_loss(
+        _outputs(permuted_logits, permuted_boxes),
+        _outputs(teacher_logits, teacher_boxes),
+    )
+    torch.testing.assert_close(permuted.class_loss, losses.class_loss.detach())
+    torch.testing.assert_close(permuted.box_loss, losses.box_loss.detach())
+    (permuted.class_loss + permuted.box_loss).backward()
+    inverse_permutation = torch.argsort(group_permutation)
+    torch.testing.assert_close(permuted_logits.grad[:, inverse_permutation], student_logits.grad)
+    torch.testing.assert_close(permuted_boxes.grad[:, inverse_permutation], student_boxes.grad)
