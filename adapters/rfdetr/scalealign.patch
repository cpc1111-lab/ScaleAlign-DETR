+from rfdetr.scalealign import ScaleAlignConfig
+
+
+def test_scalealign_defaults_are_disabled() -> None:
+    """ScaleAlign must not alter existing models unless explicitly enabled."""
+    config = RFDETRSmallConfig()
+
+    assert config.scalealign.enabled is False
+    assert config.scalealign.saa_enabled is False
+
+
+def test_scalealign_config_round_trips() -> None:
+    """Nested ScaleAlign values must survive Pydantic serialization."""
+    config = RFDETRSmallConfig(
+        pretrain_weights=None,
+        scalealign={"enabled": True, "coverage_weight": 0.25},
+    )
+
+    rebuilt = RFDETRSmallConfig.model_validate(config.model_dump())
+
+    assert rebuilt.scalealign.coverage_weight == pytest.approx(0.25)
+    assert rebuilt == config
+    assert rebuilt.scalealign == config.scalealign
+
+
+def test_scalealign_binding_does_not_affect_public_equality() -> None:
+    """Private parent ownership state is excluded from config equality."""
+    scalealign = ScaleAlignConfig(enabled=True, feature_strides=[10.0, 20.0])
+    config = RFDETRSmallConfig(
+        projector_scale=["P3", "P5"],
+        pretrain_weights=None,
+        scalealign=scalealign,
+    )
+
+    assert config.scalealign == scalealign
+    assert config == RFDETRSmallConfig.model_validate(config.model_dump())
+
+
+def test_parents_deep_copy_a_reused_scalealign_config_before_binding() -> None:
+    """Each parent owns an independent projector-level binding."""
+    shared = ScaleAlignConfig(enabled=True, feature_strides=[10.0, 20.0])
+    two_level = RFDETRSmallConfig(projector_scale=["P3", "P5"], scalealign=shared)
+    three_level = RFDETRSmallConfig(projector_scale=["P3", "P4", "P5"], scalealign=shared)
+
+    assert two_level.scalealign is not shared
+    assert three_level.scalealign is not shared
+    assert two_level.scalealign is not three_level.scalealign
+
+    two_level.scalealign.saa_enabled = True
+
+    assert two_level.scalealign.saa_enabled is True
+
+
+@pytest.mark.parametrize(
+    "replacement",
+    [
+        pytest.param(
+            {
+                "enabled": True,
+                "saa_enabled": True,
+                "feature_strides": [10.0, 20.0, 40.0],
