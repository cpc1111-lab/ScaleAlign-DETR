+def test_rank_matching_is_independent_and_invariant_to_teacher_query_permutation() -> None:
+    student_logits = torch.tensor([[[-3.0, -3.0], [3.0, -3.0], [0.0, 2.0], [-2.0, -2.0]]], requires_grad=True)
+    student_boxes = torch.tensor(
+        [
