+def test_level_bias_preserves_within_level_ratios_and_changes_level_mass() -> None:
+    """A level-only logit bias reroutes mass without changing point conditionals."""
+    logits = torch.tensor([[[[[1.0, -0.5, 0.25], [0.2, 0.7, -1.0]]]]])
+    bias = torch.tensor([[[[[-2.0], [1.5]]]]])
+    baseline = torch.softmax(logits.flatten(-2), dim=-1).reshape_as(logits)
+    aligned = torch.softmax((logits + bias).flatten(-2), dim=-1).reshape_as(logits)
+
+    baseline_conditional = baseline / baseline.sum(dim=-1, keepdim=True)
+    aligned_conditional = aligned / aligned.sum(dim=-1, keepdim=True)
+
+    torch.testing.assert_close(aligned_conditional, baseline_conditional)
+    assert not torch.allclose(aligned.sum(dim=-1), baseline.sum(dim=-1))
