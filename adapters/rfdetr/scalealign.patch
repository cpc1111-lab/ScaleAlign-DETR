--- /dev/null
+++ b/src/rfdetr/scalealign/finetune.py
@@ -0,0 +1,207 @@
+# ------------------------------------------------------------------------
+# RF-DETR
+# Copyright (c) 2025 Roboflow. All Rights Reserved.
+# Licensed under the Apache License, Version 2.0 [see LICENSE for details]
+# ------------------------------------------------------------------------
+"""Exact parameter selection for ScaleAlign multi-scale fine-tuning."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from types import MappingProxyType
+from typing import Mapping
+
+from torch import nn
+
+from rfdetr.scalealign.attention import ScaleAlignedAttention
+from rfdetr.scalealign.state import ExplicitScaleModel
+
+_PROJECTOR = "projector"
+_AUX_ATTENTION = "aux_deformable_attention"
+_SCALEALIGN = "scalealign"
+_CATEGORIES = (_PROJECTOR, _AUX_ATTENTION, _SCALEALIGN)
+
+
+@dataclass(frozen=True)
+class FinetuneReport:
+    """Immutable summary of the parameters enabled for fine-tuning.
+
+    Counts distinguish parameter tensors from their total scalar elements. The category mappings are read-only, and
+    :meth:`to_metadata` returns only JSON native containers and scalar values.
+    """
+
+    trainable_names: tuple[str, ...]
+    total_tensors: int
+    trainable_tensors: int
+    total_parameters: int
+    trainable_parameters: int
+    category_tensor_counts: Mapping[str, int]
+    category_parameter_counts: Mapping[str, int]
+
+    def to_metadata(self) -> dict[str, object]:
+        """Return a JSON-serializable representation of this report."""
+        return {
+            "trainable_names": list(self.trainable_names),
+            "total_tensors": self.total_tensors,
+            "trainable_tensors": self.trainable_tensors,
+            "total_parameters": self.total_parameters,
+            "trainable_parameters": self.trainable_parameters,
+            "category_tensor_counts": dict(self.category_tensor_counts),
+            "category_parameter_counts": dict(self.category_parameter_counts),
+        }
+
+
+def _parameter_ids(module: nn.Module) -> set[int]:
+    """Return the identities of parameters owned recursively by ``module``."""
+    return {id(parameter) for parameter in module.parameters()}
+
+
+def _registered_scalealign_parameter_ids(model: nn.Module) -> set[int]:
+    """Find ScaleAlign parameters through their registered module ownership."""
+    parameter_ids: set[int] = set()
+    for module in model.modules():
+        if isinstance(module, (ExplicitScaleModel, ScaleAlignedAttention)):
+            parameter_ids.update(_parameter_ids(module))
+        for attribute in (
+            "scalealign_query_projection",
+            "scalealign_query_gate",
+            "scalealign_content_projection",
+            "scalealign_content_gate",
+            "scalealign_stride_encoder",
+        ):
+            component = getattr(module, attribute, None)
+            if isinstance(component, nn.Parameter):
+                parameter_ids.add(id(component))
+            elif isinstance(component, nn.Module):
+                parameter_ids.update(_parameter_ids(component))
+    return parameter_ids
+
+
+def configure_scalealign_ms_finetune(
+    model: nn.Module,
+    pretrained_level_index: int,
+    include_scalealign: bool,
+) -> FinetuneReport:
+    """Freeze published weights and enable only new multi-scale adapter tensors.
+
+    Args:
+        model: Detector containing at least one multi-scale projector and one
+            auxiliary multi-scale deformable-attention module.
+        pretrained_level_index: Projector/attention level restored from the
+            published single-level checkpoint.
+        include_scalealign: Whether registered ScaleAlign treatment parameters
+            are expected and should also be trained.
+
+    Returns:
+        Immutable parameter and scalar-count metadata for the configured model.
+
+    Raises:
+        ValueError: If the index or multi-scale topology is invalid, the model's
+            ScaleAlign ownership disagrees with ``include_scalealign``, or no
+            trainable parameters are selected.
+    """
+    # Imported lazily to avoid the models -> transformer -> scalealign package
+    # initialization cycle.
+    from rfdetr.models.backbone.projector import MultiScaleProjector
+    from rfdetr.models.ops.modules import MSDeformAttn
+
+    if (
+        not isinstance(pretrained_level_index, int)
+        or isinstance(pretrained_level_index, bool)
+        or pretrained_level_index < 0
+    ):
+        raise ValueError("pretrained_level_index must be a nonnegative integer")
+    if not isinstance(include_scalealign, bool):
+        raise ValueError("include_scalealign must be a boolean")
+
+    named_parameters = tuple(model.named_parameters())
+    parameters_by_id = {id(parameter): (name, parameter) for name, parameter in named_parameters}
+    selected: dict[int, str] = {}
+
+    projectors = [module for module in model.modules() if isinstance(module, MultiScaleProjector)]
+    if not projectors:
+        raise ValueError("expected at least one MultiScaleProjector")
+    level_counts: set[int] = set()
+    for projector in projectors:
+        level_count = len(projector.stages)
+        if level_count != len(projector.stages_sampling):
+            raise ValueError("MultiScaleProjector stages and stages_sampling topology must match")
+        if level_count < 2 or pretrained_level_index >= level_count:
+            raise ValueError(
+                f"pretrained_level_index {pretrained_level_index} is invalid for "
+                f"MultiScaleProjector with {level_count} levels"
+            )
+        level_counts.add(level_count)
+        for level_index in range(level_count):
+            if level_index == pretrained_level_index:
+                continue
+            for branch in (projector.stages[level_index], projector.stages_sampling[level_index]):
+                for parameter in branch.parameters():
+                    selected[id(parameter)] = _PROJECTOR
+    if len(level_counts) != 1:
+        raise ValueError("all MultiScaleProjector modules must have the same number of levels")
+    level_count = next(iter(level_counts))
+
+    auxiliary_attention = [
+        module
+        for module in model.modules()
+        if isinstance(module, MSDeformAttn)
+        and (module.pretrained_level_index is not None or hasattr(module, "aux_sampling_offsets"))
+    ]
+    if not auxiliary_attention:
+        raise ValueError("expected at least one auxiliary MSDeformAttn module")
+    for attention in auxiliary_attention:
+        if attention.n_levels != level_count or attention.pretrained_level_index != pretrained_level_index:
+            raise ValueError(
+                "auxiliary MSDeformAttn topology must match the projector levels and pretrained_level_index"
+            )
+        if not hasattr(attention, "aux_sampling_offsets") or not hasattr(attention, "aux_attention_weights"):
+            raise ValueError("auxiliary MSDeformAttn must own offsets and attention-weight projections")
+        for projection in (attention.aux_sampling_offsets, attention.aux_attention_weights):
+            for parameter in projection.parameters():
+                selected[id(parameter)] = _AUX_ATTENTION
+
+    scalealign_ids = _registered_scalealign_parameter_ids(model)
+    if include_scalealign:
+        if not scalealign_ids:
+            raise ValueError("include_scalealign=True requires registered ScaleAlign parameters")
+        for parameter_id in scalealign_ids:
+            selected[parameter_id] = _SCALEALIGN
+    elif scalealign_ids:
+        names = sorted(parameters_by_id[parameter_id][0] for parameter_id in scalealign_ids)
