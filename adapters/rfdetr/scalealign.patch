+def test_resume_requires_last_checkpoint(tmp_path: Path) -> None:
+    """Resume mode cannot silently restart from official pretrained weights."""
+    output_dir = tmp_path / "output"
+    output_dir.mkdir()
+
+    with pytest.raises(ValueError, match="last.ckpt"):
+        resolve_resume_checkpoint(output_dir, resume=True)
+
+
+def test_checkpoint_validation_rejects_missing_or_corrupt_file(tmp_path: Path) -> None:
+    """Only the registered official 2XL checkpoint may start this run."""
+    with pytest.raises(ValueError, match="does not exist"):
+        validate_checkpoint(tmp_path / "missing.pth")
+
+    corrupt = tmp_path / "rf-detr-xxlarge.pth"
+    corrupt.write_bytes(b"not the official checkpoint")
+    with pytest.raises(ValueError, match="MD5"):
