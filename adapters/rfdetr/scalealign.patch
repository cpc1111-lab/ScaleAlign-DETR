+        (0.5 - torch.sigmoid(torch.tensor(0.0))) * 2.0 + (0.5 - torch.sigmoid(torch.tensor(1.0))) * 1.5
+    ) / 2.0
+    assert low_then_high.item() == pytest.approx((-0.1 * expected_gradient).item())
