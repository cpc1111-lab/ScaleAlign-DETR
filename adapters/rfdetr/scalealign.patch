+@pytest.mark.parametrize("dtype", [torch.float16, torch.bfloat16])
+def test_reducer_accepts_low_precision_query_scale_from_current_boxes(dtype: torch.dtype) -> None:
+    capture = _capture(1, 0)
+    layer = capture["attention_layers"][0]  # type: ignore[index]
+    boxes = layer["boxes"].to(dtype)
+    boxes[..., 2:] = torch.tensor([0.853, 0.0193], dtype=dtype)
+    layer["boxes"] = boxes
+    width, height = boxes[..., 2:].clamp(1e-6, 1.0).unbind(-1)
+    layer["query_log_scale"] = 0.5 * (torch.log(width) + torch.log(height))
+    layer["pre_saa_logits"] = layer["pre_saa_logits"].to(dtype)
+    layer["attention_weights"] = layer["attention_weights"].to(dtype)
+    layer["log_strides"] = layer["log_strides"].to(dtype)
+    layer["sampling_locations"] = layer["sampling_locations"].to(dtype)
+    capture["proposals"] = boxes
+    capture["targets"] = [boxes[0]]
+
+    result = reduce_captures([capture], image_size=100, iou_threshold=0.5)
+
+    assert result["saa_capture_batches"] == 1
+
+
+def test_reducer_rejects_one_step_stale_bfloat16_box_stage() -> None:
+    capture = _capture(1, 0)
+    layer = capture["attention_layers"][0]  # type: ignore[index]
+    boxes = layer["boxes"].to(torch.bfloat16)
+    boxes[..., 2:] = 0.490234375
+    layer["boxes"] = boxes
+    old_size = torch.full(boxes.shape[:2], 0.5, dtype=torch.bfloat16)
+    layer["query_log_scale"] = 0.5 * (torch.log(old_size) + torch.log(old_size))
+    layer["pre_saa_logits"] = layer["pre_saa_logits"].to(torch.bfloat16)
+    layer["attention_weights"] = layer["attention_weights"].to(torch.bfloat16)
+    layer["log_strides"] = layer["log_strides"].to(torch.bfloat16)
+    layer["sampling_locations"] = layer["sampling_locations"].to(torch.bfloat16)
+    capture["proposals"] = boxes
+    capture["targets"] = [boxes[0]]
+
+    with pytest.raises(ValueError, match="current boxes"):
+        reduce_captures([capture], image_size=100, iou_threshold=0.5)
+
+
+def test_constant_routing_serializes_undefined_metrics_with_support() -> None:
+    capture = _capture(1, 0)
+    layer = capture["attention_layers"][0]  # type: ignore[index]
+    layer["query_log_scale"] = torch.full((1, 2), -2.0)
+    layer["boxes"][..., 2:] = math.exp(-2.0)
+    result = reduce_captures([capture], image_size=100, iou_threshold=0.5)
+
+    assert result["scale_mismatch_rate"] == [
+        {"layer": 0, "head": 0, "value": None, "defined": False, "support_count": 0}
+    ]
+    assert result["scale_stride_correlation"] == [
+        {"layer": 0, "head": 0, "value": None, "defined": False, "support_count": 2}
+    ]
+    assert result["saa_capture_batches"] == 1
+    assert result["attention_capture_batches"] == 1
+
+
+def test_empty_targets_have_null_recall_in_strict_json() -> None:
+    capture = _capture(1, 0)
+    capture["targets"] = [torch.empty((0, 4))]
+
+    result = reduce_captures([capture], image_size=100, iou_threshold=0.5)
+
+    assert result["proposal_recall_at_k"] == {"overall": None, "small": None, "medium": None, "large": None}
+    import json
+
+    json.dumps(result, allow_nan=False)
+
+
+def _capture(batch_size: int, selected_level: int, *, sampling_location: float = 0.5) -> dict[str, object]:
+    boxes = torch.full((batch_size, 2, 4), 0.5)
+    boxes[..., 2:] = torch.tensor([math.exp(-2.0), math.exp(-1.0)]).view(1, 2, 1)
+    weights = torch.zeros((batch_size, 2, 1, 2, 1))
+    weights[..., selected_level, :] = 1.0
+    return {
+        "proposals": boxes,
+        "targets": [image_boxes for image_boxes in boxes],
+        "attention_layers": [
+            {
+                "boxes": boxes,
+                "sampling_locations": torch.full((batch_size, 2, 1, 2, 1, 2), sampling_location),
+                "query_log_scale": torch.tensor([[-2.0, -1.0]]).expand(batch_size, -1),
+                "pre_saa_logits": torch.zeros_like(weights),
+                "attention_weights": weights,
+                "log_strides": torch.tensor([math.log(8.0), math.log(16.0)]),
+            }
+        ],
+    }
+
+
+def _numeric_leaves(value: object) -> list[float]:
+    if isinstance(value, dict):
+        return [number for item in value.values() for number in _numeric_leaves(item)]
+    if isinstance(value, list):
+        return [number for item in value for number in _numeric_leaves(item)]
+    if isinstance(value, (int, float)):
+        return [float(value)]
+    return []
