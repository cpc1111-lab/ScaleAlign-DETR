+"""Runtime-only ScaleAlign ablations for checkpoint diagnostics."""
+
+import copy
+
+
+EVAL_ABLATIONS = (
+    "full",
+    "native_host",
+    "separate_scale_embeddings",
+    "shuffled_scale_embeddings",
+    "fixed_scale_gate",
+    "objectness_only_queries",
+    "content_location_diversity",
+    "saa_off",
+    "topk",
+    "content_off",
+    "all_off",
+)
+
+
+def apply_scalealign_eval_ablation(model, mode, seed=0):
+    """Disable selected ScaleAlign contributions without changing a checkpoint on disk."""
+
+    if mode not in EVAL_ABLATIONS:
+        raise ValueError(
+            f"unknown ScaleAlign evaluation ablation {mode!r}; "
+            f"expected one of {EVAL_ABLATIONS}"
+        )
+
+    transformer = getattr(model, "transformer", None)
+    if transformer is None or not getattr(transformer, "scalealign_enabled", False):
+        raise ValueError("ScaleAlign evaluation ablation requires a ScaleAlign model")
+
+    disable_saa = mode in ("saa_off", "all_off", "native_host")
+    disable_topk_coverage = mode in (
+        "topk", "all_off", "native_host", "objectness_only_queries"
+    )
+    disable_content = mode in ("content_off", "all_off", "native_host")
+
+    transformer.scalealign_selector.runtime_mode = (
+        "content_location" if mode == "content_location_diversity" else "scale"
+    )
+    transformer.decoder.scale_embedding_mode = (
+        "shuffle" if mode == "shuffled_scale_embeddings" else "full"
+    )
+    transformer.decoder.scale_embedding_seed = int(seed)
+    if disable_content:
+        transformer.scalealign_content_mode = "off"
+    elif mode == "shuffled_scale_embeddings":
+        transformer.scalealign_content_mode = "shuffle"
+    else:
+        transformer.scalealign_content_mode = "full"
+    transformer.scale_embedding_seed = int(seed)
+
+    if mode == "separate_scale_embeddings":
+        transformer.decoder.scalealign_state = copy.deepcopy(transformer.scalealign_state)
+
+    if disable_topk_coverage:
+        transformer.scalealign_coverage_weight = 0.0
+
+    for layer in transformer.decoder.layers:
+        attention = getattr(layer, "scalealign_attention", None)
+        if attention is None:
+            raise ValueError("decoder layer is missing ScaleAlign attention")
+        if disable_saa:
+            attention.runtime_mode = "off"
+        elif mode == "fixed_scale_gate":
+            attention.runtime_mode = "fixed"
+        else:
+            attention.runtime_mode = "full"
+
+    return {
+        "mode": mode,
+        "saa_enabled": not disable_saa,
+        "sgqg_enabled": not disable_topk_coverage,
+        "esm_content_enabled": not disable_content,
+        "content_embedding_mode": transformer.scalealign_content_mode,
+        "scale_embedding_mode": transformer.decoder.scale_embedding_mode,
+        "selector_mode": transformer.scalealign_selector.runtime_mode,
+    }
