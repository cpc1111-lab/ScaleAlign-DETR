@@ -0,0 +1,92 @@
+"""Checkpoint adaptation and parameter-efficient freezing for ScaleAlign."""
+
+from collections import OrderedDict
+
+
+SIZES = {"s": (3, 300), "m": (6, 600), "l": (6, 900)}
+
+
+def _is_dataset_head(key):
+    return key == "label_enc.weight" or key.startswith(
+        (
+            "class_embed.",
+            "enc_class_embed.",
+            "transformer.decoder.class_embed.",
+            "transformer.enc_out_class_embed.",
+        )
+    )
+
+
+def adapt_checkpoint(state_dict, size):
+    """Adapt one official 6-layer/900-query state dict to a fixed S/M/L model."""
+    if size not in SIZES:
+        raise ValueError("size must be one of s, m, l")
+    layers, queries = SIZES[size]
+    result = OrderedDict()
+    for key, value in state_dict.items():
+        if ".decoder.layers." in key:
+            layer = int(key.split(".decoder.layers.", 1)[1].split(".", 1)[0])
+            if layer >= layers:
+                continue
+        head_markers = (
+            "class_embed.",
+            "bbox_embed.",
+            "transformer.decoder.class_embed.",
+            "transformer.decoder.bbox_embed.",
+        )
+        head_index = next(
+            (
+                key.split(marker, 1)[1].split(".", 1)[0]
+                for marker in head_markers
+                if marker in key
+            ),
+            None,
+        )
+        if head_index is not None and head_index.isdigit() and int(head_index) >= layers:
+            continue
+        if key == "transformer.tgt_embed.weight" and value.shape[0] >= queries:
+            value = value[:queries]
+        result[key] = value
+    return result
+
+
+def prepare_pretrained_state(state_dict, model, size):
+    """Keep compatible official weights and report every excluded tensor."""
+    adapted = adapt_checkpoint(state_dict, size)
+    target = model.state_dict()
+    prepared = OrderedDict()
+    shape_mismatch = []
+    unexpected = []
+    for key, value in adapted.items():
+        if key not in target:
+            unexpected.append(key)
+        elif target[key].shape != value.shape:
+            shape_mismatch.append(key)
+        else:
+            prepared[key] = value
+    invalid_mismatches = [key for key in shape_mismatch if not _is_dataset_head(key)]
+    if unexpected or invalid_mismatches:
+        raise ValueError(
+            "unexpected checkpoint incompatibility: "
+            f"unexpected={sorted(unexpected)}, shape={sorted(invalid_mismatches)}"
+        )
+    report = {
+        "loaded_tensors": len(prepared),
+        "shape_mismatch": sorted(shape_mismatch),
+        "unexpected": sorted(unexpected),
+    }
+    return prepared, report
+
+
+def freeze_for_scalealign(model):
+    """Freeze backbone and transformer encoder, leaving decoder, heads and ScaleAlign trainable."""
+    for name, parameter in model.named_parameters():
+        parameter.requires_grad = not (
+            name.startswith("backbone.") or name.startswith("transformer.encoder.")
+        )
+
+
+def parameter_summary(model):
+    total = sum(parameter.numel() for parameter in model.parameters())
+    trainable = sum(parameter.numel() for parameter in model.parameters() if parameter.requires_grad)
+    return {"total": total, "trainable": trainable, "frozen": total - trainable}
diff --git a/util/scalealign_diagnostics.py b/util/scalealign_diagnostics.py
new file mode 100644
index 0000000000000000000000000000000000000000..9a465381f00be129cfcfb8108c3ea8d8ce927070
--- /dev/null
+++ b/util/scalealign_diagnostics.py
@@ -0,0 +1,195 @@
+"""Mergeable inference diagnostics for ScaleAlign query and attention routing."""
+
+from dataclasses import dataclass
+
+import torch
+from torch import Tensor
+
+
+def _ratio(numerator, denominator):
+    return numerator / denominator if denominator else None
+
+
+@dataclass(frozen=True)
+class RecallStatistics:
+    matched: tuple[int, int, int, int] = (0, 0, 0, 0)
+    total: tuple[int, int, int, int] = (0, 0, 0, 0)
+
+    def __add__(self, other):
+        return RecallStatistics(
+            tuple(a + b for a, b in zip(self.matched, other.matched)),
+            tuple(a + b for a, b in zip(self.total, other.total)),
+        )
+
+    @property
+    def rates(self):
+        return tuple(_ratio(matched, total) for matched, total in zip(self.matched, self.total))
+
+
+@dataclass(frozen=True)
+class CorrelationMoments:
+    count: int = 0
+    sum_x: float = 0.0
+    sum_y: float = 0.0
+    sum_x2: float = 0.0
+    sum_y2: float = 0.0
+    sum_xy: float = 0.0
+
+    def __add__(self, other):
+        return CorrelationMoments(*(a + b for a, b in zip(self.as_tuple(), other.as_tuple())))
+
+    def as_tuple(self):
+        return (self.count, self.sum_x, self.sum_y, self.sum_x2, self.sum_y2, self.sum_xy)
+
+    @property
+    def correlation(self):
+        if self.count < 2:
+            return None
+        count = float(self.count)
+        variance_x = self.sum_x2 - self.sum_x * self.sum_x / count
+        variance_y = self.sum_y2 - self.sum_y * self.sum_y / count
+        if variance_x <= 0.0 or variance_y <= 0.0:
+            return None
+        covariance = self.sum_xy - self.sum_x * self.sum_y / count
+        return covariance / (variance_x * variance_y) ** 0.5
+
+
+@dataclass(frozen=True)
+class AttentionStatistics:
+    smr_count: int = 0
+    smr_support: int = 0
+    outside_mass: float = 0.0
+    total_mass: float = 0.0
+    correlation_moments: CorrelationMoments = CorrelationMoments()
+
+    def __add__(self, other):
+        return AttentionStatistics(
+            self.smr_count + other.smr_count,
+            self.smr_support + other.smr_support,
+            self.outside_mass + other.outside_mass,
+            self.total_mass + other.total_mass,
+            self.correlation_moments + other.correlation_moments,
+        )
+
+    @property
+    def smr(self):
+        return _ratio(self.smr_count, self.smr_support)
+
+    @property
+    def bam(self):
+        return _ratio(self.outside_mass, self.total_mass)
+
+    @property
+    def correlation(self):
+        return self.correlation_moments.correlation
+
+
+def scale_membership(boxes, anchors, temperature, epsilon=1e-6):
+    if boxes.ndim != 3 or boxes.shape[-1] != 4:
+        raise ValueError("boxes must have shape [batch, candidates, 4]")
+    if temperature <= 0.0:
+        raise ValueError("temperature must be positive")
+    log_scale = boxes.detach()[..., 2:].clamp(epsilon, 1.0).log().mean(dim=-1, keepdim=True)
+    return (-(log_scale - anchors.to(boxes)) ** 2 / temperature).softmax(dim=-1)
+
+
+@torch.no_grad()
+def query_coverage_divergence(scores, boxes, selected_indices, anchors, temperature, epsilon=1e-6):
+    membership = scale_membership(boxes, anchors, temperature, epsilon)
+    confidence = scores.detach().sigmoid()
+    pool = (confidence.unsqueeze(-1) * membership).sum(dim=1)
+    pool = pool / confidence.sum(dim=1, keepdim=True).clamp_min(epsilon)
+    selected = membership.gather(
+        1, selected_indices.unsqueeze(-1).expand(-1, -1, membership.shape[-1])
+    ).sum(dim=1)
+    selected = (selected + epsilon) / (selected_indices.shape[1] + membership.shape[-1] * epsilon)
+    return (pool * (pool.clamp_min(epsilon).log() - selected.log())).sum(dim=-1)
+
+
+def _pairwise_iou(first, second):
+    first_xyxy = torch.cat((first[:, :2] - first[:, 2:] / 2, first[:, :2] + first[:, 2:] / 2), dim=-1)
+    second_xyxy = torch.cat((second[:, :2] - second[:, 2:] / 2, second[:, :2] + second[:, 2:] / 2), dim=-1)
+    lower = torch.maximum(first_xyxy[:, None, :2], second_xyxy[None, :, :2])
+    upper = torch.minimum(first_xyxy[:, None, 2:], second_xyxy[None, :, 2:])
+    intersection = (upper - lower).clamp_min(0).prod(dim=-1)
+    first_area = first[:, 2:].clamp_min(0).prod(dim=-1)
+    second_area = second[:, 2:].clamp_min(0).prod(dim=-1)
+    union = first_area[:, None] + second_area[None, :] - intersection
+    return intersection / union.clamp_min(torch.finfo(intersection.dtype).eps)
+
+
+@torch.no_grad()
+def proposal_recall_statistics(proposals, targets, image_sizes, iou_threshold=0.5):
+    if proposals.ndim != 3 or proposals.shape[-1] != 4:
+        raise ValueError("proposals must have shape [batch, queries, 4]")
+    if len(targets) != proposals.shape[0] or len(image_sizes) != proposals.shape[0]:
+        raise ValueError("targets and image_sizes must match the batch")
+    matched_counts = [0, 0, 0, 0]
+    total_counts = [0, 0, 0, 0]
+    for candidate_boxes, target_boxes, (height, width) in zip(proposals, targets, image_sizes):
+        if target_boxes.numel() == 0:
+            continue
+        target_boxes = target_boxes.to(candidate_boxes)
+        matched = _pairwise_iou(target_boxes, candidate_boxes).max(dim=1).values >= iou_threshold
+        areas = target_boxes[:, 2:].prod(dim=-1) * float(height * width)
+        masks = (
+            torch.ones_like(matched, dtype=torch.bool),
+            areas < 32.0**2,
+            (areas >= 32.0**2) & (areas < 96.0**2),
+            areas >= 96.0**2,
+        )
+        for index, mask in enumerate(masks):
+            matched_counts[index] += int(matched[mask].sum())
+            total_counts[index] += int(mask.sum())
+    return RecallStatistics(tuple(matched_counts), tuple(total_counts))
+
+
+def _correlation_moments(scale, stride, support):
+    expanded_scale = scale[..., None].expand_as(stride).to(torch.float64)
+    stride = stride.to(torch.float64)
+    x = expanded_scale[support]
+    y = stride[support]
+    return CorrelationMoments(
+        int(x.numel()), float(x.sum()), float(y.sum()), float(x.square().sum()),
+        float(y.square().sum()), float((x * y).sum()),
+    )
+
+
+@torch.no_grad()
+def attention_statistics(query_log_scale, expected_log_stride, boxes, sampling_locations, attention_weights):
+    if expected_log_stride.shape[:2] != query_log_scale.shape:
+        raise ValueError("query scales and expected strides must share batch/query dimensions")
+    if sampling_locations.shape[:-1] != attention_weights.shape:
+        raise ValueError("sampling locations and attention weights must match")
+    if boxes.shape[:2] != query_log_scale.shape or boxes.shape[-1] != 4:
+        raise ValueError("boxes must match query scales")
+
+    observation_support = attention_weights.to(torch.float64).sum(dim=(-2, -1)) > 0.0
+    mismatch_count = 0
+    mismatch_support = 0
+    query_count = query_log_scale.shape[1]
+    indices = torch.arange(query_count, device=query_log_scale.device)
+    for batch in range(query_log_scale.shape[0]):
+        for head in range(expected_log_stride.shape[-1]):
+            scale = query_log_scale[batch].to(torch.float64)
+            stride = expected_log_stride[batch, :, head].to(torch.float64)
+            valid_observation = observation_support[batch, :, head]
+            for start in range(0, query_count, 64):
+                stop = min(query_count, start + 64)
+                upper = indices[None, :] > indices[start:stop, None]
+                scale_difference = scale[start:stop, None] - scale[None, :]
+                stride_difference = stride[start:stop, None] - stride[None, :]
+                valid = upper & valid_observation[start:stop, None] & valid_observation[None, :]
+                valid &= (scale_difference != 0.0) & (stride_difference != 0.0)
+                mismatch_support += int(valid.sum())
+                mismatch_count += int(((scale_difference * stride_difference < 0.0) & valid).sum())
+
+    corners = torch.cat((boxes[..., :2] - boxes[..., 2:] / 2, boxes[..., :2] + boxes[..., 2:] / 2), dim=-1)
+    lower = corners[..., :2].unsqueeze(2).unsqueeze(2).unsqueeze(2)
+    upper = corners[..., 2:].unsqueeze(2).unsqueeze(2).unsqueeze(2)
+    inside = ((sampling_locations >= lower) & (sampling_locations <= upper)).all(dim=-1)
+    weights = attention_weights.to(torch.float64)
+    outside_mass = float((weights * ~inside).sum())
+    total_mass = float(weights.sum())
+    moments = _correlation_moments(query_log_scale, expected_log_stride, observation_support)
+    return AttentionStatistics(mismatch_count, mismatch_support, outside_mass, total_mass, moments)
