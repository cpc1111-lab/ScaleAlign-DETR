+#!/usr/bin/env python3
+"""Render the reproducible ScaleAlign qualitative simulation figure."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+from matplotlib.colors import LinearSegmentedColormap
+from matplotlib.lines import Line2D
+from matplotlib.patches import Patch, Rectangle
+import numpy as np
+from PIL import Image
+
+from util.scalealign_qualitative_simulation import (
+    annotations_in_crop,
+    box_iou,
+    densest_crop,
+    load_coco_scenes,
+    query_coverage_divergence,
+    scale_group,
+    select_scale_guided_queries,
+    select_scene,
+    simulate_detection_pair,
+    simulate_saa_evidence,
+    soft_scale_memberships,
+)
+
+
+ROOT = Path(__file__).resolve().parents[1]
+COLORS = {"small": "#F28E2B", "medium": "#22B8B5", "large": "#8B5CF6"}
+PREDICTION_COLOR = "#18C5C8"
+LEVEL_COLORS = ("#F1A340", "#5AB4AC", "#8073AC", "#4D4D4D")
+QUERY_CMAP = LinearSegmentedColormap.from_list(
+    "scale_anchor", (COLORS["small"], COLORS["medium"], COLORS["large"])
+)
+
+
+def parse_args():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output-dir", type=Path, default=ROOT / "outputs/visualizations")
+    parser.add_argument("--dpi", type=int, default=300)
+    parser.add_argument("--seed", type=int, default=17)
+    parser.add_argument("--max-scan", type=int, default=None)
+    parser.add_argument("--coco-root", type=Path, default=ROOT / "data/coco")
+    parser.add_argument("--voc-root", type=Path, default=ROOT / "data/voc")
+    parser.add_argument("--visdrone-root", type=Path, default=ROOT / "data/visdrone")
+    return parser.parse_args()
+
+
+def scene_image_path(scene, image_root):
+    path = Path(scene.file_name)
+    return path if path.is_absolute() else image_root / path
+
+
+def crop_with_aspect(scene, aspect=1.52, padding=0.08):
+    boxes = np.asarray([annotation["bbox"] for annotation in scene.annotations], dtype=float)
+    x0 = boxes[:, 0].min()
+    y0 = boxes[:, 1].min()
+    x1 = (boxes[:, 0] + boxes[:, 2]).max()
+    y1 = (boxes[:, 1] + boxes[:, 3]).max()
+    center_x, center_y = (x0 + x1) / 2, (y0 + y1) / 2
+    width = min(scene.width, max(x1 - x0, (y1 - y0) * aspect) * (1 + padding))
+    height = min(scene.height, width / aspect)
+    width = min(width, height * aspect)
+    x0 = float(np.clip(center_x - width / 2, 0, scene.width - width))
+    y0 = float(np.clip(center_y - height / 2, 0, scene.height - height))
+    return (x0, y0, float(width), float(height))
+
+
+def display_crop(scene):
+    target_aspect = 0.76
+    if scene.dataset == "voc":
+        return crop_with_aspect(scene, aspect=target_aspect, padding=0.03)
+    crop_height = scene.height if scene.dataset == "coco" else min(540, scene.height)
+    crop_width = int(round(crop_height * target_aspect))
+    crop, _ = densest_crop(scene.annotations, scene.width, scene.height, crop_width, crop_height)
+    return crop
+
+
+def select_display_annotations(scene, crop):
+    visible = annotations_in_crop(scene.annotations, crop)
+    if scene.dataset != "visdrone":
+        return sorted(visible, key=lambda item: int(item["id"]))[:24], None
+
+    _, crop_y, _, crop_height = crop
+    upper = [
+        annotation
+        for annotation in visible
+        if annotation["bbox"][1] + annotation["bbox"][3] / 2
+        <= crop_y + crop_height * 0.62
+    ]
+    selected = sorted(
+        upper,
+        key=lambda item: (item["bbox"][2] * item["bbox"][3], int(item["id"])),
+    )[:48]
+    selected = sorted(selected, key=lambda item: int(item["id"]))
+    miss_candidates = [
+        annotation
+        for annotation in selected
+        if crop_y + 30
+        <= annotation["bbox"][1] + annotation["bbox"][3] / 2
+        <= crop_y + crop_height * 0.45
+    ]
+    miss_candidates.sort(
+        key=lambda item: (item["bbox"][2] * item["bbox"][3], int(item["id"]))
+    )
+    return selected, [int(annotation["id"]) for annotation in miss_candidates[:3]]
+
+
+def setup_image_axis(ax, image, crop):
+    width, height = image.size
+    ax.imshow(image, extent=(0, width, height, 0), interpolation="antialiased")
+    x, y, crop_width, crop_height = crop
+    ax.set_xlim(x, x + crop_width)
+    ax.set_ylim(y + crop_height, y)
+    ax.set_xticks([])
+    ax.set_yticks([])
+    for spine in ax.spines.values():
+        spine.set_linewidth(0.45)
+        spine.set_color("#475569")
+
+
+def draw_box(ax, box, color, linestyle="-", linewidth=0.8, alpha=1.0, zorder=4):
+    x, y, width, height = box
+    ax.add_patch(
+        Rectangle(
+            (x, y), width, height, fill=False, edgecolor=color,
+            linestyle=linestyle, linewidth=linewidth, alpha=alpha, zorder=zorder,
+        )
+    )
+
+
+def draw_ground_truth(ax, annotations):
+    for annotation in annotations:
+        draw_box(ax, annotation["bbox"], "#111827", "-", 1.25, 0.72, 3)
+        draw_box(ax, annotation["bbox"], "white", "--", 0.72, 0.95, 4)
+
+
+def draw_detection_panel(ax, image, crop, annotations, predictions, variant):
+    setup_image_axis(ax, image, crop)
+    draw_ground_truth(ax, annotations)
+    for prediction in predictions:
+        draw_box(ax, prediction["bbox"], PREDICTION_COLOR, linewidth=0.9, zorder=5)
+    ax.set_title(variant, fontsize=6.2, pad=1.5, weight="bold")
+
+
+def box_intersects_crop(box, crop):
+    box_x, box_y, box_width, box_height = map(float, box)
+    crop_x, crop_y, crop_width, crop_height = map(float, crop)
+    return (
+        box_x < crop_x + crop_width
+        and box_x + box_width > crop_x
+        and box_y < crop_y + crop_height
+        and box_y + box_height > crop_y
+    )
+
+
+def visdrone_zoom_crop(annotations, base_predictions, crop):
+    x0, y0, width, height = crop
+    predicted_ids = {int(prediction["source_id"]) for prediction in base_predictions}
+    missing = [annotation for annotation in annotations if int(annotation["id"]) not in predicted_ids]
+    target = min(
+        missing or annotations,
+        key=lambda annotation: annotation["bbox"][2] * annotation["bbox"][3],
+    )
+    box_x, box_y, box_width, box_height = target["bbox"]
+    target_center = np.array([box_x + box_width / 2, box_y + box_height / 2])
+    zoom_width = min(max(box_width * 3.0, 60.0), width * 0.30)
+    zoom_height = min(max(box_height * 2.0, 80.0), height * 0.30)
+    return (
+        float(np.clip(target_center[0] - zoom_width / 2, x0, x0 + width - zoom_width)),
+        float(np.clip(target_center[1] - zoom_height / 2, y0, y0 + height - zoom_height)),
+        zoom_width,
+        zoom_height,
+    )
+
+
+def add_visdrone_inset(ax, image, annotations, predictions, zoom):
+    draw_box(ax, zoom, "white", linewidth=0.65, zorder=7)
+    inset = ax.inset_axes([0.34, 0.025, 0.63, 0.58])
+    setup_image_axis(inset, image, zoom)
+    for annotation in annotations:
+        if box_intersects_crop(annotation["bbox"], zoom):
+            draw_box(inset, annotation["bbox"], "white", "--", 0.55, zorder=4)
+    for prediction in predictions:
+        if box_intersects_crop(prediction["bbox"], zoom):
+            draw_box(inset, prediction["bbox"], PREDICTION_COLOR, linewidth=0.85, zorder=5)
+    inset.set_facecolor("black")
+def generate_proposals(annotations, width, height, seed):
+    rng = np.random.default_rng(seed)
+    boxes = []
+    scores = []
+    for annotation in annotations[:14]:
+        x, y, box_width, box_height = map(float, annotation["bbox"])
+        group_bonus = {"small": -0.18, "medium": 0.08, "large": 0.16}[scale_group(annotation["bbox"])]
+        for repetition in range(3):
+            dx, dy = rng.normal(0, 0.07, size=2)
+            scale = np.exp(rng.normal(0, 0.06))
+            candidate_width, candidate_height = box_width * scale, box_height * scale
+            candidate_x = np.clip(x + dx * box_width, 0, width - candidate_width)
+            candidate_y = np.clip(y + dy * box_height, 0, height - candidate_height)
+            boxes.append([candidate_x, candidate_y, candidate_width, candidate_height])
+            scores.append(2.5 - 0.20 * repetition + group_bonus + rng.normal(0, 0.035))
+    for _ in range(20):
+        box_width = rng.uniform(12, width * 0.24)
+        box_height = rng.uniform(10, height * 0.24)
+        boxes.append([rng.uniform(0, width - box_width), rng.uniform(0, height - box_height), box_width, box_height])
+        scores.append(rng.uniform(0.25, 1.0))
+    return np.asarray(boxes), np.asarray(scores)
+
+
+def draw_query_panel(ax, image, crop, boxes, memberships, indices, title, qcd):
+    setup_image_axis(ax, image, crop)
+    anchors = memberships[indices].argmax(axis=1)
+    anchor_min = int(memberships.argmax(axis=1).min())
+    anchor_max = int(memberships.argmax(axis=1).max())
+    for box, anchor in zip(boxes[indices], anchors):
+        normalized_anchor = (anchor - anchor_min) / max(anchor_max - anchor_min, 1)
+        draw_box(ax, box, QUERY_CMAP(normalized_anchor), linewidth=0.7, alpha=0.92)
+    ax.set_title(title, fontsize=6.1, pad=1.5, weight="bold")
+    ax.text(
+        0.03, 0.05, f"QCD {qcd:.3f}", transform=ax.transAxes, fontsize=5.0,
+        color="white", weight="bold",
+        bbox={"boxstyle": "square,pad=0.18", "fc": "#111827", "ec": "none", "alpha": 0.82},
+        zorder=9,
+    )
+
+
+def add_level_bar(ax, masses):
+    bar = ax.inset_axes([0.08, 0.055, 0.84, 0.115])
+    left = 0.0
+    for index, (mass, color) in enumerate(zip(masses, LEVEL_COLORS)):
+        bar.barh([0], [mass], left=left, height=0.68, color=color, edgecolor="white", linewidth=0.25)
+        if mass > 0.11:
+            bar.text(left + mass / 2, 0, f"P{index + 3}", ha="center", va="center", fontsize=3.8, color="white", weight="bold")
+        left += mass
+    bar.set_xlim(0, 1)
+    bar.set_ylim(-0.5, 0.5)
+    bar.axis("off")
+
+
+def draw_attention_panel(ax, image, crop, attention_map, target_box, masses, title, vmax):
+    setup_image_axis(ax, image, crop)
+    width, height = image.size
+    ax.imshow(
+        attention_map,
+        extent=(0, width, height, 0),
+        cmap="magma",
+        vmin=0,
+        vmax=vmax,
+        alpha=0.62,
+        interpolation="bilinear",
+        zorder=2,
+    )
+    draw_box(ax, target_box, "white", "--", 0.9, zorder=6)
+    add_level_bar(ax, masses)
+    ax.set_title(title, fontsize=6.1, pad=1.5, weight="bold")
+
+
+def paired_iou(pair, annotations):
+    by_id = {int(annotation["id"]): annotation["bbox"] for annotation in annotations}
+    result = {}
+    for variant, predictions in pair.items():
+        values = [box_iou(prediction["bbox"], by_id[prediction["source_id"]]) for prediction in predictions if prediction["source_id"] in by_id]
+        result[variant] = float(np.mean(values))
+    return result
+
+
+def main():
