+import sys
+from pathlib import Path
+
+import torch
+
+sys.path.insert(0, str(Path(__file__).parents[2]))
+from models.dino.deformable_transformer import DeformableTransformer
+
+
+def _build_transformer():
+    return DeformableTransformer(
+        d_model=16,
+        nhead=4,
+        num_queries=8,
+        num_encoder_layers=1,
+        num_decoder_layers=1,
+        dim_feedforward=32,
+        return_intermediate_dec=True,
+        deformable_encoder=True,
+        deformable_decoder=True,
+        num_feature_levels=2,
+        two_stage_type="standard",
+        learnable_tgt_init=True,
+        decoder_sa_type="sa",
+        scalealign_enabled=True,
+        scalealign_dim=8,
+        scalealign_strides=(8, 16),
+        scalealign_min_pool_size=8,
+    )
+
+
+def test_transformer_initializes_complete_identity_scalealign_path():
+    transformer = _build_transformer()
+
+    assert transformer.d_model == 16
+    torch.testing.assert_close(
+        transformer.scalealign_content_projection.weight,
+        torch.zeros_like(transformer.scalealign_content_projection.weight),
+    )
+    torch.testing.assert_close(
+        transformer.scalealign_content_projection.bias,
+        torch.zeros_like(transformer.scalealign_content_projection.bias),
+    )
+    for layer in transformer.decoder.layers:
+        projection = layer.scalealign_attention.query_projection.weight
+        torch.testing.assert_close(projection, torch.zeros_like(projection))
+
+
+def test_transformer_content_projection_has_live_gradient_at_identity_init():
+    transformer = _build_transformer()
+    embedding = torch.randn(2, 3, 8)
+
+    contribution = transformer.scalealign_content_projection(embedding)
+    contribution.sum().backward()
+
+    torch.testing.assert_close(contribution, torch.zeros_like(contribution))
+    assert transformer.scalealign_content_projection.weight.grad.abs().sum() > 0
+
+
+def test_legacy_content_gate_is_folded_into_projection():
+    source = _build_transformer()
+    with torch.no_grad():
+        source.scalealign_content_projection.weight.normal_()
+        source.scalealign_content_projection.bias.normal_()
+    embedding = torch.randn(2, 3, 8)
+    ungated = source.scalealign_content_projection(embedding)
+    legacy = source.state_dict()
+    legacy["scalealign_content_gate"] = torch.tensor(-0.2)
+
+    restored = _build_transformer()
+    restored.load_state_dict(legacy, strict=True)
+
+    torch.testing.assert_close(
+        restored.scalealign_content_projection(embedding), ungated * -0.2
+    )
+    assert restored.scalealign_content_gate.item() == 1.0
