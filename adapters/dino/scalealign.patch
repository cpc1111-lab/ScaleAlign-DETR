@@ -0,0 +1,80 @@
+import sys
+from pathlib import Path
+
+import torch
+from torch import nn
+
+sys.path.insert(0, str(Path(__file__).parents[2]))
+from util.scalealign_checkpoint import (
+    SIZES,
+    adapt_checkpoint,
+    freeze_for_scalealign,
+    prepare_pretrained_state,
+)
+
+
+class TinyModel(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.backbone = nn.Linear(2, 2)
+        self.transformer = nn.Module()
+        self.transformer.encoder = nn.Linear(2, 2)
+        self.transformer.decoder = nn.Linear(2, 2)
+        self.scalealign = nn.Linear(2, 2)
+
+
+def test_freezing_keeps_decoder_and_scalealign_trainable():
+    model = TinyModel()
+    freeze_for_scalealign(model)
+    flags = {name: value.requires_grad for name, value in model.named_parameters()}
+    assert not flags["backbone.weight"]
+    assert not flags["transformer.encoder.weight"]
+    assert flags["transformer.decoder.weight"]
+    assert flags["scalealign.weight"]
+
+
+def test_checkpoint_adaptation_truncates_layers_and_queries():
+    state = {
+        "transformer.tgt_embed.weight": torch.randn(900, 2),
+        "transformer.decoder.layers.2.weight": torch.randn(2),
+        "transformer.decoder.layers.3.weight": torch.randn(2),
+        "transformer.decoder.class_embed.3.weight": torch.randn(2),
+    }
+    adapted = adapt_checkpoint(state, "s")
+    assert adapted["transformer.tgt_embed.weight"].shape[0] == SIZES["s"][1]
+    assert "transformer.decoder.layers.2.weight" in adapted
+    assert "transformer.decoder.layers.3.weight" not in adapted
+    assert "transformer.decoder.class_embed.3.weight" not in adapted
+
+
+def test_pretrained_state_skips_only_shape_mismatches_and_reports_them():
+    model = nn.Module()
+    model.body = nn.Linear(2, 2)
+    model.class_embed = nn.Linear(2, 3)
+    checkpoint = {
+        "body.weight": torch.randn(2, 2),
+        "body.bias": torch.randn(2),
+        "class_embed.weight": torch.randn(91, 2),
+        "class_embed.bias": torch.randn(91),
+    }
+
+    prepared, report = prepare_pretrained_state(checkpoint, model, "l")
+
+    assert set(prepared) == {"body.weight", "body.bias"}
+    assert set(report["shape_mismatch"]) == {
+        "class_embed.weight",
+        "class_embed.bias",
+    }
+    assert report["unexpected"] == []
+    assert report["loaded_tensors"] == 2
+
+
+def test_pretrained_state_rejects_unrelated_shape_mismatch():
+    model = TinyModel()
+    checkpoint = {"backbone.weight": torch.randn(3, 3)}
+    try:
+        prepare_pretrained_state(checkpoint, model, "l")
+    except ValueError as error:
+        assert "backbone.weight" in str(error)
+    else:
+        raise AssertionError("unrelated shape mismatch must be rejected")
