+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).parents[2]))
+from util.slconfig import SLConfig
+
+
+def test_nine_configs_resolve_consistently():
+    expected_size = {
+        "s": ("resnet50", 3, 300, False),
+        "m": ("resnet101", 6, 600, False),
+        "l": ("swin_B_224_22k", 6, 900, False),
+    }
+    expected_data = {"coco": (91, 12), "voc": (20, 12), "visdrone": (10, 12)}
+    root = Path(__file__).parents[2] / "config" / "ScaleAlign"
+    for dataset, (classes, epochs) in expected_data.items():
+        for size, (backbone, layers, queries, checkpointing) in expected_size.items():
+            config = SLConfig.fromfile(root / f"{dataset}_{size}.py")
+            assert (config.dec_layers, config.num_queries) == (layers, queries)
+            assert config.num_select == queries
+            assert config.backbone == backbone
+            assert config.use_checkpoint is checkpointing
+            assert (config.num_classes, config.epochs) == (classes, epochs)
+            assert config.return_interm_indices == [1, 2, 3]
+            assert config.num_feature_levels == 4
+            assert config.scalealign_strides == [8, 16, 32, 64]
+            assert config.scalealign_enabled and not config.scalealign_peft
+            assert config.gradient_accumulation_steps == 16
+            assert config.batch_size * config.gradient_accumulation_steps == 16
