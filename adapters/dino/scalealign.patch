+#!/usr/bin/env python3
+"""Aggregate completed ScaleAlign runs into JSON, CSV, and Markdown."""
+
+import argparse
+import csv
+import json
+from pathlib import Path
+
+
+METRICS = ("AP", "AP50", "AP75", "APS", "APM", "APL")
+EPOCHS = {"coco": 12, "voc": 12, "visdrone": 12}
+
+
+def collect(outputs):
+    rows = []
+    for dataset in ("coco", "voc", "visdrone"):
+        for size in ("s", "m", "l"):
+            log = outputs / f"scalealign_{dataset}_{size}" / "log.txt"
+            records = []
+            if log.exists():
+                records = [json.loads(line) for line in log.read_text().splitlines() if line.strip()]
+                records = [row for row in records if "test_coco_eval_bbox" in row]
+            if not records:
+                rows.append({"dataset": dataset, "size": size, "status": "pending"})
+                continue
+            record = max(records, key=lambda row: row["test_coco_eval_bbox"][0])
+            status = "complete" if max(row.get("epoch", -1) for row in records) >= EPOCHS[dataset] - 1 else "incomplete"
+            row = {"dataset": dataset, "size": size, "status": status, "epoch": record["epoch"]}
+            row.update(dict(zip(METRICS, record["test_coco_eval_bbox"][:6])))
+            for key in ("gpu_hours", "peak_memory_gib", "test_latency_ms_per_image", "n_parameters"):
+                row[key] = record.get(key)
+            rows.append(row)
+    return rows
+
+
+def write_reports(rows, destination):
+    destination.mkdir(parents=True, exist_ok=True)
+    (destination / "scalealign_results.json").write_text(json.dumps(rows, indent=2))
+    fields = ["dataset", "size", "status", "epoch", *METRICS, "gpu_hours", "peak_memory_gib", "test_latency_ms_per_image", "n_parameters"]
+    with (destination / "scalealign_results.csv").open("w", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=fields, extrasaction="ignore")
+        writer.writeheader()
+        writer.writerows(rows)
+    lines = [
+        "| Dataset | Size | Status | AP | AP50 | AP75 | APS | APM | APL | GPU h | Peak GiB | ms/image |",
+        "|---|---:|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|",
+    ]
+    for row in rows:
+        values = []
+        for key in (*METRICS, "gpu_hours", "peak_memory_gib", "test_latency_ms_per_image"):
+            value = row.get(key)
+            values.append("-" if value is None else f"{value:.4f}")
+        lines.append(f"| {row['dataset']} | {row['size'].upper()} | {row['status']} | " + " | ".join(values) + " |")
+    (destination / "scalealign_results.md").write_text("\n".join(lines) + "\n")
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--outputs", type=Path, default=Path("outputs"))
+    parser.add_argument("--destination", type=Path, default=Path("reports"))
+    args = parser.parse_args()
+    write_reports(collect(args.outputs), args.destination)
+    print(args.destination / "scalealign_results.md")
+
+
+if __name__ == "__main__":
+    main()
