@@ -0,0 +1,174 @@
+"""Profile ScaleAlign S/M/L reproducibility metrics on one CUDA device."""
+
+import argparse
+import json
+import math
+import time
+
+import torch
+
+from main import build_model_main, get_args_parser
+from util.scalealign_checkpoint import adapt_checkpoint
+from util.slconfig import SLConfig
+
+
+SIZES = ("s", "m", "l")
+COCO_TRAIN_IMAGES = 118287
+
+
+def synchronize():
+    torch.cuda.synchronize()
+
+
+def build(size, checkpoint_path):
+    config_path = f"config/ScaleAlign/coco_{size}.py"
+    config = SLConfig.fromfile(config_path)._cfg_dict.to_dict()
+    args = get_args_parser().parse_args(["-c", config_path, "--device", "cuda"])
+    for key, value in config.items():
+        setattr(args, key, value)
+
+    print(f"[build] size={size} config={config_path}", flush=True)
+    model, criterion, _ = build_model_main(args)
+    checkpoint = torch.load(
+        checkpoint_path, map_location="cpu", weights_only=False
+    )["model"]
+    checkpoint = adapt_checkpoint(checkpoint, size)
+    target = model.state_dict()
+    compatible = {
+        key: value
+        for key, value in checkpoint.items()
+        if key in target and target[key].shape == value.shape
+    }
+    model.load_state_dict(compatible, strict=False)
+    print(f"[build] loaded_tensors={len(compatible)}", flush=True)
+    return model.cuda(), criterion.cuda(), config
+
+
+def make_batch():
+    generator = torch.Generator(device="cuda").manual_seed(0)
+    image = torch.rand(3, 800, 1333, generator=generator, device="cuda")
+    boxes = torch.rand(10, 4, generator=generator, device="cuda")
+    boxes[:, 2:] = boxes[:, 2:] * 0.25 + 0.01
+    targets = [{
+        "labels": torch.arange(10, device="cuda", dtype=torch.long) % 80,
+        "boxes": boxes,
+    }]
+    return [image], targets
+
+
+def loss_for(model, criterion, images, targets):
+    with torch.autocast("cuda", dtype=torch.float16):
+        outputs = model(images, targets)
+        losses = criterion(outputs, targets)
+        return sum(
+            losses[key] * criterion.weight_dict[key]
+            for key in losses
+            if key in criterion.weight_dict
+        )
+
+
+def train_cycle(model, criterion, optimizer, scaler, images, targets, accumulation):
+    optimizer.zero_grad(set_to_none=True)
+    total_loss = 0.0
+    for _ in range(accumulation):
+        loss = loss_for(model, criterion, images, targets) / accumulation
+        scaler.scale(loss).backward()
+        total_loss += float(loss.detach())
+    scaler.step(optimizer)
+    scaler.update()
+    synchronize()
+    return total_loss
+
+
+def mean_and_sd(samples):
+    mean = sum(samples) / len(samples)
+    variance = sum((value - mean) ** 2 for value in samples) / len(samples)
+    return mean, math.sqrt(variance)
+
+
+def profile_training(model, criterion, images, targets, config):
+    model.train()
+    criterion.train()
+    optimizer = torch.optim.AdamW(model.parameters(), lr=1e-4, weight_decay=1e-4)
+    scaler = torch.amp.GradScaler("cuda")
+    accumulation = config["gradient_accumulation_steps"]
+
+    print(f"[train] warmup accumulation={accumulation}", flush=True)
+    train_cycle(model, criterion, optimizer, scaler, images, targets, accumulation)
+    torch.cuda.reset_peak_memory_stats()
+    times = []
+    losses = []
+    for index in range(2):
+        print(f"[train] measured optimizer cycle {index + 1}/2", flush=True)
+        start = time.perf_counter()
+        losses.append(
+            train_cycle(model, criterion, optimizer, scaler, images, targets, accumulation)
+        )
+        times.append(time.perf_counter() - start)
+
+    mean_cycle, cycle_sd = mean_and_sd(times)
+    optimizer_steps = math.ceil(COCO_TRAIN_IMAGES / accumulation) * config["epochs"]
+    return {
+        "optimizer_cycle_seconds": times,
+        "optimizer_cycle_seconds_mean": mean_cycle,
+        "optimizer_cycle_seconds_sd": cycle_sd,
+        "peak_training_memory_gib": torch.cuda.max_memory_allocated() / 1024**3,
+        "projected_gpu_hours": mean_cycle * optimizer_steps / 3600,
+        "losses": losses,
+    }
+
+
+def profile_latency(model, images):
+    model.eval()
+    with torch.inference_mode():
+        print("[latency] warmup 10", flush=True)
+        for _ in range(10):
+            with torch.autocast("cuda", dtype=torch.float16):
+                model(images)
+        synchronize()
+        samples = []
+        print("[latency] measured 100", flush=True)
+        for _ in range(100):
+            start = time.perf_counter()
+            with torch.autocast("cuda", dtype=torch.float16):
+                model(images)
+            synchronize()
+            samples.append((time.perf_counter() - start) * 1000)
+    mean, sd = mean_and_sd(samples)
+    return {"latency_ms_mean": mean, "latency_ms_sd": sd}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("size", choices=SIZES)
+    parser.add_argument(
+        "--checkpoint",
+        default="weights/official/checkpoint0011_5scale.pth",
+    )
+    parser.add_argument("--skip-latency", action="store_true")
+    parser.add_argument("--skip-training", action="store_true")
+    args = parser.parse_args()
+
+    torch.manual_seed(0)
+    model, criterion, config = build(args.size, args.checkpoint)
+    images, targets = make_batch()
+    result = {
+        "size": args.size,
+        "trainable_parameters": sum(
+            parameter.numel()
+            for parameter in model.parameters()
+            if parameter.requires_grad
+        ),
+        "device": torch.cuda.get_device_name(),
+        "precision": "AMP FP16",
+        "input": [800, 1333],
+    }
+    if not args.skip_training:
+        result.update(profile_training(model, criterion, images, targets, config))
+    if not args.skip_latency:
+        result.update(profile_latency(model, images))
+    print(json.dumps(result, indent=2), flush=True)
+
+
+if __name__ == "__main__":
+    main()
