+import json
+import sys
+from pathlib import Path
+
+from PIL import Image
+
+sys.path.insert(0, str(Path(__file__).parents[2]))
+from datasets.scalealign_convert import convert_visdrone, convert_voc
+
+
+def test_voc_conversion_preserves_difficult_and_coordinates(tmp_path):
+    root = tmp_path / "VOC2007"
+    (root / "Annotations").mkdir(parents=True)
+    (root / "JPEGImages").mkdir()
+    (root / "ImageSets" / "Main").mkdir(parents=True)
+    (root / "ImageSets" / "Main" / "trainval.txt").write_text("000001\n")
+    (root / "JPEGImages" / "000001.jpg").touch()
+    (root / "Annotations" / "000001.xml").write_text(
+        "<annotation><size><width>20</width><height>10</height></size>"
+        "<object><name>person</name><difficult>1</difficult><bndbox>"
+        "<xmin>1</xmin><ymin>2</ymin><xmax>11</xmax><ymax>8</ymax>"
+        "</bndbox></object></annotation>"
+    )
+    output = tmp_path / "voc.json"
+    convert_voc([root], [root / "ImageSets" / "Main" / "trainval.txt"], output)
+    annotation = json.loads(output.read_text())["annotations"][0]
+    assert annotation["bbox"] == [0.0, 1.0, 11.0, 7.0]
+    assert annotation["iscrowd"] == 1
+    assert annotation["category_id"] == 14
+
+
+def test_visdrone_conversion_excludes_ignored_regions(tmp_path):
+    images, labels = tmp_path / "images", tmp_path / "annotations"
+    images.mkdir()
+    labels.mkdir()
+    Image.new("RGB", (20, 10)).save(images / "1.jpg")
+    (labels / "1.txt").write_text("0,0,5,5,0,0,0,0\n1,2,8,4,1,4,0,1\n")
+    output = tmp_path / "visdrone.json"
+    convert_visdrone(images, labels, output)
+    data = json.loads(output.read_text())
+    assert len(data["annotations"]) == 1
+    assert data["annotations"][0]["category_id"] == 3
+    assert [category["id"] for category in data["categories"]] == list(range(10))
