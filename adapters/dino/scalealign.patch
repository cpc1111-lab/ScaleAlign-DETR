+++ b/tests/scalealign/test_saa.py
@@ -0,0 +1,69 @@
+import sys
+from pathlib import Path
+
+import torch
+
+sys.path.insert(0, str(Path(__file__).parents[2] / "models" / "dino"))
+from scalealign import ScaleAlignedAttention, add_level_bias
+
+sys.path.insert(0, str(Path(__file__).parents[2]))
+from tools.benchmark import flop_count
+
+
+def test_level_bias_preserves_within_level_ratios():
+    logits = torch.tensor([[[[[1.0, 0.0], [0.5, -0.5]]]]])
+    before = logits.flatten(-2).softmax(-1).view_as(logits)
+    after = add_level_bias(logits, torch.tensor([[[[0.0, 2.0]]]])).flatten(-2).softmax(-1).view_as(logits)
+    torch.testing.assert_close(after[..., 0, 0] / after[..., 0, 1], before[..., 0, 0] / before[..., 0, 1])
+    assert after[..., 1, :].sum() > before[..., 1, :].sum()
+
+
+def test_zero_level_bias_is_identity():
+    logits = torch.randn(2, 3, 4, 5, 4)
+    torch.testing.assert_close(add_level_bias(logits, torch.zeros(2, 3, 4, 5)), logits)
+
+
+def test_saa_starts_as_identity_with_live_projection_gradient():
+    module = ScaleAlignedAttention(scale_dim=8, num_heads=2, strides=(8, 16))
+    embedding = torch.randn(1, 3, 8, requires_grad=True)
+
+    bias = module(embedding)
+    bias.sum().backward()
+
+    torch.testing.assert_close(bias, torch.zeros_like(bias))
+    assert module.query_projection.weight.grad.abs().sum() > 0
+
+
+def test_saa_off_policy_is_exact_identity():
+    module = ScaleAlignedAttention(scale_dim=8, num_heads=2, strides=(8, 16))
+    with torch.no_grad():
+        module.query_projection.weight.fill_(0.5)
+    module.runtime_mode = "off"
+
+    bias = module(torch.randn(1, 3, 8))
+
+    torch.testing.assert_close(bias, torch.zeros_like(bias))
+
+
+def test_legacy_scalar_gate_is_folded_into_query_projection():
+    source = ScaleAlignedAttention(scale_dim=8, num_heads=2, strides=(8, 16))
+    with torch.no_grad():
+        source.query_projection.weight.normal_()
+    embedding = torch.randn(1, 3, 8)
+    ungated = source(embedding)
+    legacy = source.state_dict()
+    legacy["gate"] = torch.tensor(-0.25)
+
+    restored = ScaleAlignedAttention(scale_dim=8, num_heads=2, strides=(8, 16))
+    restored.load_state_dict(legacy, strict=True)
+
+    torch.testing.assert_close(restored(embedding), ungated * -0.25)
+    assert restored.gate.item() == 1.0
+
+
+def test_benchmark_counts_pytorch_25_einsum_signature():
+    module = ScaleAlignedAttention(scale_dim=8, num_heads=2, strides=(8, 16))
+
+    counts = flop_count(module, (torch.randn(1, 3, 8),))
+
+    assert counts["einsum"] == 48 / 1e9
diff --git a/tests/scalealign/test_sgqg.py b/tests/scalealign/test_sgqg.py
