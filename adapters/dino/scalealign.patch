@@ -0,0 +1,163 @@
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+import numpy as np
+from PIL import Image
+
+from util.scalealign_qualitative_simulation import (
+    box_iou,
+    query_coverage_divergence,
+    select_scale_guided_queries,
+    simulate_detection_pair,
+    simulate_saa_evidence,
+    soft_scale_memberships,
+)
+
+
+def synthetic_annotations():
+    boxes = [
+        [20, 20, 18, 16],
+        [80, 25, 24, 20],
+        [130, 30, 68, 54],
+        [230, 20, 110, 100],
+        [60, 130, 42, 36],
+        [180, 135, 150, 92],
+    ]
+    return [
+        {"id": index + 1, "category_id": index % 3, "bbox": box, "iscrowd": 0}
+        for index, box in enumerate(boxes)
+    ]
+
+
+def mean_matched_iou(predictions, annotations):
+    by_id = {annotation["id"]: annotation["bbox"] for annotation in annotations}
+    values = [
+        box_iou(prediction["bbox"], by_id[prediction["source_id"]])
+        for prediction in predictions
+        if prediction["source_id"] in by_id
+    ]
+    return float(np.mean(values))
+
+
+def test_detection_simulation_has_equal_budget_and_better_alignment():
+    annotations = synthetic_annotations()
+    pair = simulate_detection_pair(
+        annotations,
+        width=400,
+        height=260,
+        dataset="coco",
+        seed=17,
+        max_predictions=6,
+    )
+
+    assert len(pair["base"]) == len(pair["scalealign"]) == 6
+    assert mean_matched_iou(pair["scalealign"], annotations) > mean_matched_iou(
+        pair["base"], annotations
+    )
+    assert any(prediction["error"] == "miss" for prediction in pair["base"])
+
+
+def test_voc_simulation_uses_plausible_boundary_refinement():
+    annotations = [
+        {"id": 1, "category_id": 11, "bbox": [20, 20, 120, 100], "iscrowd": 0},
+        {"id": 2, "category_id": 14, "bbox": [180, 60, 130, 120], "iscrowd": 0},
+    ]
+    pair = simulate_detection_pair(
+        annotations,
+        width=400,
+        height=260,
+        dataset="voc",
+        seed=18,
+        max_predictions=2,
+    )
+
+    base_iou = mean_matched_iou(pair["base"], annotations)
+    aligned_iou = mean_matched_iou(pair["scalealign"], annotations)
+    assert base_iou > 0.75
+    assert aligned_iou > base_iou
+
+
+def test_scale_guided_queries_reduce_qcd():
+    proposals = np.array(
+        [[10 + i * 3, 10, 18, 16] for i in range(18)]
+        + [[80 + i * 2, 70, 70, 58] for i in range(8)]
+        + [[180 + i, 120, 150, 110] for i in range(6)],
+        dtype=np.float64,
+    )
+    scores = np.concatenate(
+        [np.linspace(0.99, 0.80, 18), np.linspace(0.78, 0.68, 8), np.linspace(0.66, 0.60, 6)]
+    )
+    memberships = soft_scale_memberships(proposals, width=400, height=260, bins=8)
+    objectness = np.argsort(-scores)[:12]
+    guided = select_scale_guided_queries(scores, memberships, count=12, coverage_weight=2.0)
+
+    objectness_qcd = query_coverage_divergence(scores, memberships, objectness)
+    guided_qcd = query_coverage_divergence(scores, memberships, guided)
+    assert guided_qcd < objectness_qcd
+    assert len(np.unique(guided)) == 12
+
+
+def test_saa_evidence_is_normalized_and_reduces_background_mass():
+    evidence = simulate_saa_evidence(
+        width=400,
+        height=260,
+        target_bbox=[20, 20, 18, 16],
+        seed=17,
+    )
+
+    assert np.isclose(evidence["unconditioned_mass"].sum(), 1.0)
+    assert np.isclose(evidence["saa_mass"].sum(), 1.0)
+    assert evidence["saa_background_mass"] < evidence["unconditioned_background_mass"]
+    assert evidence["saa_mass"][0] > evidence["unconditioned_mass"][0]
+    assert evidence["unconditioned_map"].shape == evidence["saa_map"].shape
+
+
+def test_inset_keeps_boxes_that_cross_the_crop_boundary():
+    from tools.visualize_scalealign_simulation import box_intersects_crop
+
+    crop = (840.5, 23.5, 60.0, 80.0)
+    scalealign_prediction = (877.8, 13.7, 10.1, 19.2)
+
+    assert box_intersects_crop(scalealign_prediction, crop)
+    assert not box_intersects_crop((800.0, 0.0, 10.0, 10.0), crop)
+
+
+def test_cli_smoke_renders_all_artifacts(tmp_path):
+    repository = Path(__file__).resolve().parents[2]
+    command = [
+        sys.executable,
+        str(repository / "tools/visualize_scalealign_simulation.py"),
+        "--output-dir",
+        str(tmp_path),
+        "--dpi",
+        "72",
+        "--max-scan",
+        "200",
+    ]
+    subprocess.run(command, cwd=repository, check=True, capture_output=True, text=True)
+
+    png = tmp_path / "scalealign_simulation.png"
+    pdf = tmp_path / "scalealign_simulation.pdf"
+    metadata = tmp_path / "scalealign_simulation_metadata.json"
+    assert png.stat().st_size > 20_000
+    assert pdf.stat().st_size > 10_000
+    loaded = json.loads(metadata.read_text(encoding="utf-8"))
+    assert loaded["simulation"] is True
+    assert loaded["figure_width_mm"] == 183
+    assert loaded["routing"]["sgqg_qcd"] < loaded["routing"]["objectness_qcd"]
+    assert loaded["routing"]["saa_background_mass"] < loaded["routing"]["unconditioned_background_mass"]
+    visdrone = loaded["datasets"]["visdrone"]
+    assert visdrone["ground_truth_count"] >= 40
+    assert visdrone["ground_truth_count"] == visdrone["prediction_count_each"]
+    assert visdrone["matched_prediction_count"]["base"] == visdrone["ground_truth_count"] - 3
+    assert visdrone["matched_prediction_count"]["scalealign"] == visdrone["ground_truth_count"]
+    crop_y, crop_height = visdrone["crop_xywh"][1], visdrone["crop_xywh"][3]
+    zoom_center_y = visdrone["zoom_xywh"][1] + visdrone["zoom_xywh"][3] / 2
+    assert zoom_center_y < crop_y + crop_height / 2
+    assert visdrone["zoom_xywh"][2] <= 0.30 * visdrone["crop_xywh"][2]
+    assert visdrone["zoom_xywh"][3] <= 0.30 * visdrone["crop_xywh"][3]
+    with Image.open(png) as image:
+        assert image.width == 518
+        assert image.height == 272
