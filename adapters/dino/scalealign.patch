+++ b/util/scalealign_embedding_quality.py
@@ -0,0 +1,75 @@
+"""Statistics for matched ScaleAlign ESM embeddings."""
+
+import torch
+
+
+GROUP_NAMES = ("small", "medium", "large")
+
+
+def select_stage_boxes(outputs, references):
+    """Select query initialization and public decoder-layer box predictions."""
+
+    auxiliary = outputs.get("aux_outputs", ())
+    if len(references) < 1 or len(auxiliary) < 1 or "pred_boxes" not in outputs:
+        raise ValueError("t=0, t=1, and final decoder boxes are required")
+    return {
+        "t0": references[0],
+        "t1": auxiliary[0]["pred_boxes"],
+        "t3": outputs["pred_boxes"],
+    }
+
+
+def _mean_or_none(values):
+    return float(values.mean()) if values.numel() else None
+
+
+def summarize_stage(
+    pred_embeddings,
+    gt_embeddings,
+    pred_log_scale,
+    gt_log_scale,
+    size_groups,
+    permutation,
+):
+    """Summarize one decoder stage using a caller-supplied global permutation."""
+
+    n_pairs = pred_embeddings.shape[0]
+    if gt_embeddings.shape != pred_embeddings.shape:
+        raise ValueError("predicted and GT embeddings must have identical shapes")
+    if any(tensor.shape != (n_pairs,) for tensor in (
+        pred_log_scale, gt_log_scale, size_groups, permutation
+    )):
+        raise ValueError("stage vectors and permutation must match the pair count")
+
+    pred_embeddings = pred_embeddings.to(dtype=torch.float64)
+    gt_embeddings = gt_embeddings.to(dtype=torch.float64)
+    pred_norm = torch.linalg.vector_norm(pred_embeddings, dim=-1)
+    gt_norm = torch.linalg.vector_norm(gt_embeddings, dim=-1)
+    valid = (pred_norm > 0) & (gt_norm > 0)
+    cosine = (pred_embeddings * gt_embeddings).sum(-1) / (pred_norm * gt_norm).clamp_min(
+        torch.finfo(torch.float64).tiny
+    )
+
+    shuffled_gt = gt_embeddings[permutation]
+    shuffled_gt_norm = gt_norm[permutation]
+    shuffled_valid = (pred_norm > 0) & (shuffled_gt_norm > 0)
+    shuffled_cosine = (pred_embeddings * shuffled_gt).sum(-1) / (
+        pred_norm * shuffled_gt_norm
+    ).clamp_min(torch.finfo(torch.float64).tiny)
+
+    result = {
+        "n_pairs": int(n_pairs),
+        "cosine_all": _mean_or_none(cosine[valid]),
+        "shuffled_cosine": _mean_or_none(shuffled_cosine[shuffled_valid]),
+        "log_scale_mae": float(
+            (pred_log_scale.to(torch.float64) - gt_log_scale.to(torch.float64)).abs().mean()
+        ),
+        "zero_norm_excluded": int((~valid).sum()),
+        "shuffled_zero_norm_excluded": int((~shuffled_valid).sum()),
+    }
+    for group_index, group_name in enumerate(GROUP_NAMES):
+        group_mask = valid & (size_groups == group_index)
+        result[f"cosine_{group_name}"] = _mean_or_none(cosine[group_mask])
+        result[f"n_{group_name}"] = int((size_groups == group_index).sum())
+    return result
+
diff --git a/util/scalealign_qualitative_simulation.py b/util/scalealign_qualitative_simulation.py
new file mode 100644
index 0000000000000000000000000000000000000000..5923b2db6c8999a67ca40db5fd9852c7acc1ae6a
--- /dev/null
+++ b/util/scalealign_qualitative_simulation.py
@@ -0,0 +1,296 @@
+"""Deterministic helpers for the ScaleAlign qualitative simulation figure."""
+
+from __future__ import annotations
+
+from collections import defaultdict
+from dataclasses import dataclass
+import json
+from pathlib import Path
+
+import numpy as np
+
+
+EPSILON = 1e-9
+
+
+@dataclass(frozen=True)
+class Scene:
+    dataset: str
+    image_id: int
+    file_name: str
+    width: int
+    height: int
+    annotations: tuple[dict, ...]
+    crop: tuple[float, float, float, float] | None = None
+
+
+def box_iou(first, second):
+    """Return IoU for two COCO-format xywh boxes."""
+    ax, ay, aw, ah = map(float, first)
+    bx, by, bw, bh = map(float, second)
+    intersection_w = max(0.0, min(ax + aw, bx + bw) - max(ax, bx))
+    intersection_h = max(0.0, min(ay + ah, by + bh) - max(ay, by))
+    intersection = intersection_w * intersection_h
+    union = aw * ah + bw * bh - intersection
+    return intersection / max(union, EPSILON)
+
+
+def scale_group(box):
+    area = float(box[2]) * float(box[3])
+    if area < 32**2:
+        return "small"
+    if area < 96**2:
+        return "medium"
+    return "large"
+
+
+def load_coco_scenes(annotation_path, dataset):
+    payload = json.loads(Path(annotation_path).read_text(encoding="utf-8"))
+    annotations = defaultdict(list)
+    for annotation in payload["annotations"]:
+        if not annotation.get("iscrowd", 0) and annotation["bbox"][2] > 1 and annotation["bbox"][3] > 1:
+            annotations[annotation["image_id"]].append(annotation)
+    return [
+        Scene(
+            dataset=dataset,
+            image_id=int(image["id"]),
+            file_name=image["file_name"],
+            width=int(image["width"]),
+            height=int(image["height"]),
+            annotations=tuple(annotations[image["id"]]),
+        )
+        for image in sorted(payload["images"], key=lambda item: int(item["id"]))
+    ]
+
+
+def _boxes_are_adjacent(first, second, width, height):
+    if box_iou(first, second) > 0.02:
+        return True
+    first_center = np.array([first[0] + first[2] / 2, first[1] + first[3] / 2])
+    second_center = np.array([second[0] + second[2] / 2, second[1] + second[3] / 2])
+    distance = np.linalg.norm((first_center - second_center) / np.array([width, height]))
+    return bool(distance < 0.18)
+
+
+def densest_crop(annotations, width, height, crop_width=640, crop_height=420):
+    crop_width = min(int(crop_width), int(width))
+    crop_height = min(int(crop_height), int(height))
+    centers = np.array(
+        [[box[0] + box[2] / 2, box[1] + box[3] / 2] for box in (a["bbox"] for a in annotations)],
+        dtype=np.float64,
+    )
+    if centers.size == 0:
+        return (0.0, 0.0, float(crop_width), float(crop_height)), 0
+    best_crop = None
+    best_count = -1
+    for center_x, center_y in centers:
+        x0 = float(np.clip(center_x - crop_width / 2, 0, width - crop_width))
+        y0 = float(np.clip(center_y - crop_height / 2, 0, height - crop_height))
+        inside = (
+            (centers[:, 0] >= x0)
+            & (centers[:, 0] <= x0 + crop_width)
+            & (centers[:, 1] >= y0)
+            & (centers[:, 1] <= y0 + crop_height)
+        )
+        count = int(inside.sum())
+        candidate = (x0, y0, float(crop_width), float(crop_height))
+        if count > best_count or (count == best_count and candidate < best_crop):
+            best_crop, best_count = candidate, count
+    return best_crop, best_count
+
+
+def select_scene(scenes, dataset, max_scan=None):
+    scanned = scenes if max_scan is None else scenes[:max_scan]
+    for scene in scanned:
+        annotations = list(scene.annotations)
+        if dataset == "coco":
+            groups = {scale_group(annotation["bbox"]) for annotation in annotations}
+            if len(annotations) >= 6 and len(groups) >= 2:
+                return scene
+        elif dataset == "voc":
+            boxes = [annotation["bbox"] for annotation in annotations]
+            if len(boxes) >= 2 and any(
+                _boxes_are_adjacent(boxes[i], boxes[j], scene.width, scene.height)
+                for i in range(len(boxes))
+                for j in range(i + 1, len(boxes))
+            ):
+                return scene
+        elif dataset == "visdrone":
+            crop, count = densest_crop(annotations, scene.width, scene.height)
+            if count >= 15:
+                return Scene(**{**scene.__dict__, "crop": crop})
+        else:
+            raise ValueError(f"unknown dataset: {dataset}")
+    raise RuntimeError(f"no {dataset} scene met the selection rule in {len(scanned)} images")
+
+
+def annotations_in_crop(annotations, crop):
+    if crop is None:
+        return list(annotations)
+    x0, y0, width, height = crop
+    selected = []
+    for annotation in annotations:
+        x, y, box_width, box_height = annotation["bbox"]
+        center_x, center_y = x + box_width / 2, y + box_height / 2
+        if x0 <= center_x <= x0 + width and y0 <= center_y <= y0 + height:
+            selected.append(annotation)
+    return selected
+
+
+def _jitter_box(box, width, height, rng, shift, resize):
+    x, y, box_width, box_height = map(float, box)
+    center_x = x + box_width / 2 + rng.normal(0, shift * box_width)
+    center_y = y + box_height / 2 + rng.normal(0, shift * box_height)
+    new_width = box_width * np.exp(rng.normal(0, resize))
+    new_height = box_height * np.exp(rng.normal(0, resize))
+    new_width = float(np.clip(new_width, 3, width))
+    new_height = float(np.clip(new_height, 3, height))
+    new_x = float(np.clip(center_x - new_width / 2, 0, width - new_width))
+    new_y = float(np.clip(center_y - new_height / 2, 0, height - new_height))
+    return [new_x, new_y, new_width, new_height]
+
+
+def simulate_detection_pair(
+    annotations,
+    width,
+    height,
+    dataset,
+    seed=17,
+    max_predictions=24,
+    miss_source_ids=None,
+    miss_count=1,
+):
+    valid = [annotation for annotation in annotations if annotation["bbox"][2] > 2 and annotation["bbox"][3] > 2]
+    valid = sorted(valid, key=lambda item: int(item["id"]))[:max_predictions]
+    if not valid:
+        raise ValueError("detection simulation requires at least one annotation")
+    rng = np.random.default_rng(seed)
+    scalealign = []
+    base = []
+    for index, annotation in enumerate(valid):
+        group = scale_group(annotation["bbox"])
+        scalealign.append(
+            {
+                "bbox": _jitter_box(annotation["bbox"], width, height, rng, 0.018, 0.025),
+                "score": float(0.92 - 0.008 * index),
+                "source_id": int(annotation["id"]),
+                "scale": group,
+                "error": None,
+            }
+        )
+        base_shift = 0.06 if dataset == "voc" and index == 0 else (0.085 if group == "small" else 0.055)
+        base_resize = 0.055 if dataset == "voc" and index == 0 else 0.075
+        base.append(
+            {
+                "bbox": _jitter_box(annotation["bbox"], width, height, rng, base_shift, base_resize),
+                "score": float(0.90 - 0.008 * index),
+                "source_id": int(annotation["id"]),
+                "scale": group,
+                "error": "localization" if dataset == "voc" and index == 0 else None,
+            }
+        )
+
+    small_indices = [i for i, annotation in enumerate(valid) if scale_group(annotation["bbox"]) == "small"]
+    if miss_source_ids is not None:
+        requested = {int(identifier) for identifier in miss_source_ids}
+        missed_indices = [i for i, annotation in enumerate(valid) if int(annotation["id"]) in requested]
+    else:
+        missed_indices = small_indices[:miss_count]
+    largest_indices = sorted(
+        range(len(valid)),
+        key=lambda i: valid[i]["bbox"][2] * valid[i]["bbox"][3],
+        reverse=True,
+    )
+    for offset, missed in enumerate(missed_indices[:miss_count]):
+        duplicate_source = largest_indices[offset % len(largest_indices)]
+        duplicate = _jitter_box(valid[duplicate_source]["bbox"], width, height, rng, 0.035, 0.04)
+        base[missed] = {
+            "bbox": duplicate,
+            "score": base[missed]["score"],
+            "source_id": -1,
+            "scale": scale_group(duplicate),
+            "error": "miss",
+        }
+    return {"base": base, "scalealign": scalealign}
+
+
+def soft_scale_memberships(boxes, width, height, bins=8, temperature=0.25):
+    boxes = np.asarray(boxes, dtype=np.float64)
+    normalized_area = np.clip((boxes[:, 2] / width) * (boxes[:, 3] / height), 1e-8, 1.0)
+    log_scale = 0.5 * np.log(normalized_area)
+    anchors = np.linspace(-7.0, 0.0, bins)
+    logits = -((log_scale[:, None] - anchors[None, :]) ** 2) / temperature
+    logits -= logits.max(axis=1, keepdims=True)
+    membership = np.exp(logits)
+    return membership / membership.sum(axis=1, keepdims=True)
+
+
+def query_coverage_divergence(scores, memberships, selected):
+    scores = np.asarray(scores, dtype=np.float64)
+    memberships = np.asarray(memberships, dtype=np.float64)
+    quality = 1.0 / (1.0 + np.exp(-scores))
+    target = (quality[:, None] * memberships).sum(axis=0)
+    target /= target.sum() + EPSILON
+    selected_distribution = memberships[np.asarray(selected, dtype=np.int64)].sum(axis=0) + EPSILON
+    selected_distribution /= selected_distribution.sum()
+    return float(np.sum(target * np.log((target + EPSILON) / selected_distribution)))
+
+
+def select_scale_guided_queries(scores, memberships, count, coverage_weight=2.0):
+    scores = np.asarray(scores, dtype=np.float64)
+    memberships = np.asarray(memberships, dtype=np.float64)
+    if count <= 0 or count > len(scores):
+        raise ValueError("count must be within the proposal count")
+    quality = 1.0 / (1.0 + np.exp(-scores))
+    target = (quality[:, None] * memberships).sum(axis=0)
+    target /= target.sum() + EPSILON
+    selected_counts = np.zeros(memberships.shape[1], dtype=np.float64)
+    available = np.ones(len(scores), dtype=bool)
+    selected = []
+    for step in range(count):
+        candidate = selected_counts[None, :] + memberships
+        candidate = (candidate + EPSILON) / (step + 1 + memberships.shape[1] * EPSILON)
+        divergence = np.sum(target[None, :] * np.log((target[None, :] + EPSILON) / candidate), axis=1)
+        utility = quality - coverage_weight * divergence
+        utility[~available] = -np.inf
+        chosen = int(np.argmax(utility))
+        selected.append(chosen)
+        available[chosen] = False
+        selected_counts += memberships[chosen]
+    return np.asarray(selected, dtype=np.int64)
+
+
+def simulate_saa_evidence(width, height, target_bbox, seed=17, map_width=140, map_height=90):
+    rng = np.random.default_rng(seed)
+    x, y, box_width, box_height = map(float, target_bbox)
+    center_x = (x + box_width / 2) / width
+    center_y = (y + box_height / 2) / height
+    yy, xx = np.mgrid[0:1:complex(map_height), 0:1:complex(map_width)]
+    target_sigma = max(0.025, np.sqrt((box_width / width) * (box_height / height)) * 0.55)
+    foreground = np.exp(-((xx - center_x) ** 2 + (yy - center_y) ** 2) / (2 * target_sigma**2))
+    background_x = float(np.clip(center_x + 0.28, 0.12, 0.88))
+    background_y = float(np.clip(center_y + 0.20, 0.12, 0.88))
+    background = np.exp(-((xx - background_x) ** 2 + (yy - background_y) ** 2) / (2 * 0.13**2))
+    unconditioned_texture = rng.random((map_height, map_width)) * 0.010
+    saa_texture = rng.random((map_height, map_width)) * 0.003
+
+    object_scale = np.sqrt((box_width / width) * (box_height / height))
+    ideal_level = int(np.clip(np.floor(np.log2(max(object_scale * 32, 1.0))), 0, 3))
+    levels = np.arange(4)
+    saa_mass = np.exp(-0.9 * (levels - ideal_level) ** 2)
+    saa_mass /= saa_mass.sum()
+    unconditioned_mass = np.array([0.14, 0.22, 0.31, 0.33], dtype=np.float64)
+    unconditioned_mass /= unconditioned_mass.sum()
+
+    unconditioned_map = 0.50 * foreground + 0.50 * background + unconditioned_texture
+    saa_map = 0.96 * foreground + 0.04 * background + saa_texture
+    outside = ((xx - center_x) ** 2 + (yy - center_y) ** 2) > (2.2 * target_sigma) ** 2
+    return {
+        "unconditioned_map": unconditioned_map,
+        "saa_map": saa_map,
+        "unconditioned_mass": unconditioned_mass,
+        "saa_mass": saa_mass,
+        "unconditioned_background_mass": float(unconditioned_map[outside].sum() / unconditioned_map.sum()),
+        "saa_background_mass": float(saa_map[outside].sum() / saa_map.sum()),
+        "ideal_level": ideal_level,
+    }
