@@ -0,0 +1,208 @@
+#!/usr/bin/env python3
+"""Measure matched ESM embedding quality on COCO val2017."""
+
+import argparse
+import csv
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+import torch
+from tqdm import tqdm
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+from datasets import build_dataset
+from main import build_model_main, get_args_parser
+from util.scalealign_embedding_quality import select_stage_boxes, summarize_stage
+from util.slconfig import SLConfig
+
+
+STAGES = (("t0", 0), ("t1", 1), ("t3", 3))
+
+
+def model_args(config_path, coco_path, device):
+    args = get_args_parser().parse_args(
+        ["-c", str(config_path), "--coco_path", str(coco_path), "--device", device]
+    )
+    config = SLConfig.fromfile(str(config_path))._cfg_dict.to_dict()
+    for key, value in config.items():
+        setattr(args, key, value)
+    return args
+
+
+def sha256(path):
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def original_coco_area(target):
+    current_h, current_w = target["size"].to(torch.float64)
+    original_h, original_w = target["orig_size"].to(torch.float64)
+    resize_factor = (current_h / original_h) * (current_w / original_w)
+    return target["area"].to(torch.float64) / resize_factor
+
+
+def coco_size_groups(area):
+    groups = torch.full_like(area, 2, dtype=torch.int64)
+    groups[area < 96.0**2] = 1
+    groups[area < 32.0**2] = 0
+    return groups
+
+
+class ReferenceCollector:
+    def __init__(self, decoder):
+        self.references = None
+        self.handle = decoder.register_forward_hook(self._capture)
+
+    def _capture(self, _module, _args, output):
+        self.references = output[1]
+
+    def close(self):
+        self.handle.remove()
+
+
+def evaluate(config_path, checkpoint_path, coco_path, device, image_limit, seed):
+    args = model_args(config_path, coco_path, device)
+    model, criterion, _ = build_model_main(args)
+    checkpoint = torch.load(checkpoint_path, map_location="cpu", weights_only=False)
+    model.load_state_dict(checkpoint["model"], strict=True)
+    model = model.to(device).eval()
+    criterion = criterion.to(device).eval()
+    esm = model.transformer.scalealign_state
+    if esm is None:
+        raise RuntimeError("checkpoint model does not expose a shared ScaleAlign ESM")
+    if len(model.transformer.decoder.layers) < 3:
+        raise RuntimeError("embedding table requires at least three decoder layers")
+
+    dataset = build_dataset("val", args)
+    total_images = len(dataset) if image_limit <= 0 else min(image_limit, len(dataset))
+    pred_embeddings = {name: [] for name, _ in STAGES}
+    pred_log_scales = {name: [] for name, _ in STAGES}
+    gt_embeddings = []
+    gt_log_scales = []
+    size_groups = []
+    collector = ReferenceCollector(model.transformer.decoder)
+
+    try:
+        with torch.inference_mode():
+            for index in tqdm(range(total_images), desc="ESM embedding quality", unit="image"):
+                image, target_cpu = dataset[index]
+                target = {
+                    key: value.to(device) if torch.is_tensor(value) else value
+                    for key, value in target_cpu.items()
+                }
+                outputs = model([image.to(device)])
+                if collector.references is None:
+                    raise RuntimeError("decoder reference hook did not capture a trajectory")
+                references = collector.references
+                if len(references) <= STAGES[-1][1]:
+                    raise RuntimeError(
+                        f"decoder returned {len(references)} reference stages; expected at least 4"
+                    )
+                stage_boxes = select_stage_boxes(outputs, references)
+
+                match = criterion.matcher(
+                    {"pred_logits": outputs["pred_logits"], "pred_boxes": outputs["pred_boxes"]},
+                    [target],
+                )[0]
+                query_indices = match[0].to(device)
+                target_indices = match[1].to(device)
+                matched_gt_boxes = target["boxes"][target_indices]
+                gt_state = esm(matched_gt_boxes.unsqueeze(0))
+                gt_embeddings.append(gt_state.embedding[0].cpu())
+                gt_log_scales.append(gt_state.log_scale[0].cpu())
+
+                groups = coco_size_groups(original_coco_area(target_cpu))[match[1]]
+                size_groups.append(groups.cpu())
+                for stage_name, _ in STAGES:
+                    matched_pred_boxes = stage_boxes[stage_name][0, query_indices]
+                    pred_state = esm(matched_pred_boxes.unsqueeze(0))
+                    pred_embeddings[stage_name].append(pred_state.embedding[0].cpu())
+                    pred_log_scales[stage_name].append(pred_state.log_scale[0].cpu())
+    finally:
+        collector.close()
+
+    gt_embeddings = torch.cat(gt_embeddings)
+    gt_log_scales = torch.cat(gt_log_scales)
+    size_groups = torch.cat(size_groups)
+    generator = torch.Generator(device="cpu")
+    generator.manual_seed(seed)
+    permutation = torch.randperm(gt_embeddings.shape[0], generator=generator)
+
+    stages = {}
+    for stage_name, _ in STAGES:
+        stages[stage_name] = summarize_stage(
+            torch.cat(pred_embeddings[stage_name]),
+            gt_embeddings,
+            torch.cat(pred_log_scales[stage_name]),
+            gt_log_scales,
+            size_groups,
+            permutation,
+        )
+    return stages, total_images, int(checkpoint.get("epoch", -1))
+
+
+def write_results(output_dir, metadata, stages):
+    output_dir = Path(output_dir)
+    output_dir.mkdir(parents=True, exist_ok=True)
+    json_path = output_dir / "embedding_quality.json"
+    csv_path = output_dir / "embedding_quality.csv"
+    json_path.write_text(json.dumps({"metadata": metadata, "stages": stages}, indent=2) + "\n")
+    rows = [{"stage": stage, **values} for stage, values in stages.items()]
+    with csv_path.open("w", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=list(rows[0]))
+        writer.writeheader()
+        writer.writerows(rows)
+    return json_path, csv_path
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config", default="outputs/scalealign_coco_s/config_cfg.py")
+    parser.add_argument(
+        "--checkpoint", default="outputs/scalealign_coco_s/checkpoint_best_regular.pth"
+    )
+    parser.add_argument("--coco-path", default="data/coco")
+    parser.add_argument(
+        "--output-dir", default="outputs/scalealign_coco_s/diagnostics/embedding_quality"
+    )
+    parser.add_argument("--device", default="cuda")
+    parser.add_argument("--images", type=int, default=0, help="0 evaluates all val images")
+    parser.add_argument("--seed", type=int, default=0, help="global GT shuffle seed")
+    parser.add_argument("--checkpoint-seed", type=int, default=0)
+    return parser.parse_args()
+
+
+def main():
+    cli = parse_args()
+    torch.manual_seed(cli.seed)
+    stages, image_count, checkpoint_epoch = evaluate(
+        cli.config, cli.checkpoint, cli.coco_path, cli.device, cli.images, cli.seed
+    )
+    metadata = {
+        "checkpoint": str(Path(cli.checkpoint).resolve()),
+        "checkpoint_sha256": sha256(cli.checkpoint),
+        "checkpoint_epoch_zero_based": checkpoint_epoch,
+        "checkpoint_seed": cli.checkpoint_seed,
+        "config": str(Path(cli.config).resolve()),
+        "coco_path": str(Path(cli.coco_path).resolve()),
+        "images": image_count,
+        "shuffle_seed": cli.seed,
+        "matching": "final-layer Hungarian; same identities reused at t=0,1,3",
+        "stage_boxes": "t0 initial reference; t1 first auxiliary prediction; t3 final prediction",
+        "precision": "float32 model inference; float64 metric reduction",
+    }
+    json_path, csv_path = write_results(cli.output_dir, metadata, stages)
+    print(json.dumps({"metadata": metadata, "stages": stages}, indent=2))
+    print(f"wrote {json_path}")
+    print(f"wrote {csv_path}")
+
+
+if __name__ == "__main__":
+    main()
