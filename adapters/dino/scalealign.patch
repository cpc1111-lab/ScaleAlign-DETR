+    figure.legend(handles=legend, loc="lower center", bbox_to_anchor=(0.5, 0.002), ncol=5, frameon=False, fontsize=4.3, handlelength=1.1, columnspacing=1.0)
+    figure.text(0.994, 0.008, "Simulated qualitative comparison · seed 17", ha="right", va="bottom", fontsize=4.5, color="#64748B")
+
+    metadata = {
+        "simulation": True,
