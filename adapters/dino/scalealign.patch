+++ b/tests/scalealign/test_sgqg.py
@@ -0,0 +1,79 @@
+import sys
+from pathlib import Path
+
+import torch
+
+sys.path.insert(0, str(Path(__file__).parents[2] / "models" / "dino"))
+from scalealign import ScaleGuidedQueryGenerator
+
+
+def test_zero_coverage_is_exact_topk():
+    scores = torch.tensor([[0.2, 0.9, 0.4, 0.8]])
+    boxes = torch.rand(1, 4, 4)
+    selector = ScaleGuidedQueryGenerator(num_bins=4)
+    selected = selector(scores, boxes, query_count=3, coverage_weight=0.0)
+    torch.testing.assert_close(selected, scores.topk(3, dim=1).indices)
+
+
+def test_selection_is_unique_and_deterministic():
+    scores = torch.ones(1, 8)
+    boxes = torch.rand(1, 8, 4)
+    selector = ScaleGuidedQueryGenerator(num_bins=4)
+    first = selector(scores, boxes, query_count=4, coverage_weight=0.5)
+    second = selector(scores, boxes, query_count=4, coverage_weight=0.5)
+    torch.testing.assert_close(first, second)
+    assert first.unique().numel() == first.numel()
+
+
+def test_candidate_pool_maps_selected_indices_back_to_full_proposals():
+    selector = ScaleGuidedQueryGenerator(num_bins=4, min_pool_size=4)
+    scores = torch.tensor([[0.1, 9.0, 8.0, 7.0, 6.0, -5.0]])
+    boxes = torch.rand(1, 6, 4)
+    boxes[..., 2:] = boxes[..., 2:].clamp_min(0.01)
+    selected = selector(scores, boxes, query_count=2, coverage_weight=0.2)
+    assert set(selected[0].tolist()).issubset({1, 2, 3, 4})
+
+
+def test_quality_normalization_allows_scale_coverage_to_change_the_set():
+    selector = ScaleGuidedQueryGenerator(num_bins=4, temperature=0.05, min_pool_size=4)
+    scores = torch.tensor([[10.0, 9.0, 8.0, 7.0]])
+    boxes = torch.tensor(
+        [[[0.5, 0.5, 0.1, 0.1], [0.5, 0.5, 0.1, 0.1],
+          [0.5, 0.5, 0.8, 0.8], [0.5, 0.5, 0.8, 0.8]]]
+    )
+
+    selected = selector(scores, boxes, query_count=2, coverage_weight=1.0)
+
+    assert 0 in selected[0]
+    assert any(index in selected[0] for index in (2, 3))
+
+
+def test_quality_is_sigmoid_bounded():
+    scores = torch.tensor([[-10.0, 0.0, 10.0]])
+
+    quality = ScaleGuidedQueryGenerator.quality(scores)
+
+    torch.testing.assert_close(quality, scores.sigmoid())
+
+
+def test_selector_is_traceable_for_flop_measurement():
+    class TraceableSelector(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.selector = ScaleGuidedQueryGenerator(
+                num_bins=4, pool_factor=2, min_pool_size=4
+            )
+
+        def forward(self, scores, boxes):
+            return self.selector(scores, boxes, query_count=2, coverage_weight=0.2)
+
+    module = TraceableSelector()
+    scores = torch.tensor([[0.9, 0.8, 0.7, 0.6]])
+    boxes = torch.tensor(
+        [[[0.5, 0.5, 0.1, 0.1], [0.5, 0.5, 0.2, 0.2],
+          [0.5, 0.5, 0.3, 0.3], [0.5, 0.5, 0.4, 0.4]]]
+    )
+
+    traced = torch.jit.trace(module, (scores, boxes))
+
+    assert torch.equal(traced(scores, boxes), module(scores, boxes))
