+#!/usr/bin/env python3
+"""Evaluate seven ablations under the selected stride-calibrated SAA policy."""
+
+import argparse
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+import torch
+from tqdm.auto import tqdm
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+from datasets import build_dataset
+from tools.evaluate_scalealign_ablations import (
+    VARIANTS,
+    AttentionCollector,
+    VariantAccumulator,
+    _build_model,
+)
+from tools.simulate_geometric_saa import (
+    _positive_float,
+    _positive_int,
+    write_results,
+)
+from util.geometric_saa_simulation import GeometricSAASimulator
+from util.scalealign_diagnostics import (
+    proposal_recall_statistics,
+    query_coverage_divergence,
+)
+
+
+def parse_args(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--config", default="outputs/scalealign_coco_s/config_cfg.py"
+    )
+    parser.add_argument(
+        "--checkpoint", default="outputs/scalealign_coco_s/checkpoint_best_regular.pth"
+    )
+    parser.add_argument("--coco-path", default="data/coco")
+    parser.add_argument(
+        "--output-dir",
+        default="outputs/scalealign_coco_s/diagnostics/stride_calibrated_ablations",
+    )
+    parser.add_argument("--images", type=_positive_int, default=100)
+    parser.add_argument("--cells-per-object", type=_positive_float, default=8.0)
+    parser.add_argument("--gamma", type=_positive_float, default=2.0)
+    parser.add_argument("--temperature", type=_positive_float, default=0.25)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--device", default="cuda")
+    parser.add_argument("--variants", nargs="+", choices=VARIANTS, default=list(VARIANTS))
+    return parser.parse_args(argv)
+
+
+def simulator_policy(variant):
+    if variant not in VARIANTS:
+        raise ValueError(f"unknown ablation variant {variant!r}")
+    if variant == "native_host":
+        return None
+    if variant == "fixed_scale_gate":
+        return "fixed"
+    return "full"
+
+
+def _sha256(path):
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def evaluate_variant(cli, variant):
+    torch.manual_seed(cli.seed)
+    model, model_args = _build_model(
+        cli.config,
+        cli.checkpoint,
+        cli.coco_path,
+        cli.device,
+        variant,
+        cli.seed,
+    )
+    dataset = build_dataset("val", model_args)
+    selector = model.transformer.scalealign_selector
+    policy = simulator_policy(variant)
+    simulator = None
+    if policy is not None:
+        simulator = GeometricSAASimulator(
+            model,
+            gamma=cli.gamma,
+            temperature=cli.temperature,
+            anchor_mode="stride_calibrated",
+            cells_per_object=cli.cells_per_object,
+            query_mode=policy,
+        )
+    collector = AttentionCollector(model)
+    accumulator = VariantAccumulator()
+    evaluated = min(cli.images, len(dataset))
+    try:
+        with torch.inference_mode():
+            for index in tqdm(
+                range(evaluated),
+                desc=variant,
+                unit="image",
+                dynamic_ncols=True,
+            ):
+                image, target = dataset[index]
+                model([image.to(cli.device)])
+                captured = selector.last_diagnostics
+                if captured is None:
+                    raise RuntimeError("query selector did not capture diagnostics")
+                indices = captured["indices"]
+                qcd = query_coverage_divergence(
+                    captured["scores"],
+                    captured["boxes"],
+                    indices,
+                    selector.anchors,
+                    selector.temperature,
+                    selector.epsilon,
+                )
+                selected_boxes = captured["boxes"].gather(
+                    1, indices.unsqueeze(-1).expand(-1, -1, 4)
+                )
+                size = tuple(int(value) for value in target["size"].tolist())
+                recall = proposal_recall_statistics(
+                    selected_boxes, [target["boxes"].to(cli.device)], [size]
+                )
+                accumulator.qcd_sum += float(qcd.sum())
+                accumulator.qcd_count += int(qcd.numel())
+                accumulator.recall = accumulator.recall + recall
+                accumulator.images += 1
+        accumulator.attention = collector.statistics
+    finally:
+        collector.close()
+        if simulator is not None:
+            simulator.close()
+    return accumulator.to_row(variant)
+
+
+def main(argv=None):
+    cli = parse_args(argv)
+    metadata = {
+        "simulation": "stride_calibrated_ablation_table",
+        "checkpoint": str(Path(cli.checkpoint).resolve()),
+        "checkpoint_sha256": _sha256(cli.checkpoint),
+        "config": str(Path(cli.config).resolve()),
+        "coco_path": str(Path(cli.coco_path).resolve()),
+        "requested_images": cli.images,
+        "seed": cli.seed,
+        "device": cli.device,
+        "temperature": cli.temperature,
+        "cells_per_object": cli.cells_per_object,
+        "gamma": cli.gamma,
+        "anchor_formula": "log(cells_per_object * stride / sqrt(input_h * input_w))",
+        "native_host_uses_geometric_saa": False,
+        "ap_evaluation": False,
+    }
+    rows = []
+    for variant in cli.variants:
+        row = evaluate_variant(cli, variant)
+        rows.append(row)
+        json_path, csv_path = write_results(
+            cli.output_dir,
+            metadata,
+            rows,
+            stem="stride_calibrated_ablations",
+        )
+        print(json.dumps(row, sort_keys=True), flush=True)
+    print(f"JSON: {json_path}", flush=True)
+    print(f"CSV: {csv_path}", flush=True)
+
+
+if __name__ == "__main__":
+    main()
