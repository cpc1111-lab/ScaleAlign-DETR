+#!/usr/bin/env python3
+"""Run the 3 datasets x 3 ScaleAlign size experiment matrix."""
+
+import argparse
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+from tqdm.auto import tqdm
+
+
+DATASETS = ("coco", "voc", "visdrone")
+SIZES = ("s", "m", "l")
+EPOCHS = {"coco": 12, "voc": 12, "visdrone": 12}
+
+
+def dataset_root(root, dataset):
+    return root / "data" / dataset
+
+
+def validate_inputs(root, datasets, checkpoint):
+    print("[preflight] validating checkpoint and datasets", flush=True)
+    if not checkpoint.is_file():
+        raise FileNotFoundError(checkpoint)
+    for dataset in datasets:
+        path = dataset_root(root, dataset)
+        if not path.exists():
+            raise FileNotFoundError(f"missing dataset {dataset}: {path}")
+        expected = {
+            "coco": ("instances_train2017.json", "instances_val2017.json"),
+            "voc": ("voc0712_trainval.json", "voc2007_test.json"),
+            "visdrone": ("visdrone_train.json", "visdrone_val.json"),
+        }[dataset]
+        missing = [path / "annotations" / name for name in expected if not (path / "annotations" / name).is_file()]
+        if missing:
+            raise FileNotFoundError("missing annotations: " + ", ".join(map(str, missing)))
+    print("[preflight] importing PyTorch and probing CUDA", flush=True)
+    import torch
+
+    cuda_available = torch.cuda.is_available()
+    print(
+        f"[preflight] torch={torch.__version__} cuda={torch.version.cuda} "
+        f"available={cuda_available}",
+        flush=True,
+    )
+    if not cuda_available:
+        raise RuntimeError(
+            "CUDA is unavailable. Fix the NVIDIA driver before starting the matrix; "
+            f"PyTorch build is {torch.__version__}."
+        )
+
+
+def run_is_complete(output, dataset):
+    log = output / "log.txt"
+    if not log.is_file():
+        return False
+    records = [json.loads(line) for line in log.read_text().splitlines() if line.strip()]
+    return any(record.get("epoch", -1) >= EPOCHS[dataset] - 1 for record in records)
+
+
+def main():
+    print("[launcher] ScaleAlign matrix launcher started", flush=True)
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--datasets", nargs="+", choices=DATASETS, default=list(DATASETS))
+    parser.add_argument("--sizes", nargs="+", choices=SIZES, default=list(SIZES))
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--workers", type=int, default=4)
+    parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--force", action="store_true")
+    parser.add_argument(
+        "--checkpoint",
+        type=Path,
+        default=Path("weights/official/checkpoint0011_5scale.pth"),
+    )
+    args = parser.parse_args()
+
+    root = Path(__file__).resolve().parents[1]
+    checkpoint = (root / args.checkpoint).resolve() if not args.checkpoint.is_absolute() else args.checkpoint
+    jobs = [(dataset, size) for dataset in args.datasets for size in args.sizes]
+    print(
+        f"[launcher] jobs={len(jobs)} datasets={args.datasets} sizes={args.sizes}",
+        flush=True,
+    )
+    print(
+        "[launcher] policy=official DINO checkpoint, full-model training, "
+        "batch=1 x accumulation=16",
+        flush=True,
+    )
+    if not args.dry_run:
+        validate_inputs(root, args.datasets, checkpoint)
+
+    failures = []
+    for dataset, size in tqdm(jobs, desc="ScaleAlign experiments", unit="run"):
+        output = root / "outputs" / f"scalealign_{dataset}_{size}"
+        if run_is_complete(output, dataset) and not args.force:
+            tqdm.write(f"[skip] {dataset}-{size}: all epochs completed")
+            continue
+        command = [
+            sys.executable,
+            "-u",
+            "main.py",
+            "-c",
+            f"config/ScaleAlign/{dataset}_{size}.py",
+            "--coco_path",
+            str(dataset_root(root, dataset)),
+            "--pretrain_model_path",
+            str(checkpoint),
+            "--output_dir",
+            str(output),
+            "--device",
+            "cuda",
+            "--amp",
+            "--progress",
+            "--save_log",
+            "--seed",
+            str(args.seed),
+            "--num_workers",
+            str(args.workers),
+        ]
+        tqdm.write("[run] " + " ".join(command), file=sys.stdout)
+        sys.stdout.flush()
+        if args.dry_run:
+            continue
+        result = subprocess.run(command, cwd=root)
+        if result.returncode:
+            failures.append({"dataset": dataset, "size": size, "returncode": result.returncode})
+            break
+    if failures:
+        raise SystemExit("experiment failed: " + json.dumps(failures))
+
+
+if __name__ == "__main__":
+    main()
