+import csv
+import importlib
+import json
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).parents[2]))
+
+from tools.evaluate_scalealign_ablations import (
+    VARIANTS,
+    VariantAccumulator,
+    write_results,
+)
+from util.scalealign_diagnostics import AttentionStatistics, CorrelationMoments, RecallStatistics
+
+
+def test_variant_order_matches_the_ablation_table():
+    assert VARIANTS == (
+        "full",
+        "native_host",
+        "separate_scale_embeddings",
+        "shuffled_scale_embeddings",
+        "fixed_scale_gate",
+        "objectness_only_queries",
+        "content_location_diversity",
+    )
+
+
+def test_accumulator_exposes_ratios_from_aggregate_counts():
+    accumulator = VariantAccumulator(
+        qcd_sum=0.6,
+        qcd_count=2,
+        recall=RecallStatistics((3, 1, 1, 1), (4, 1, 2, 1)),
+        attention=AttentionStatistics(
+            2, 8, 3.0, 12.0,
+            CorrelationMoments(3, 3.0, 3.0, 5.0, 5.0, 2.0),
+        ),
+        images=2,
+    )
+
+    row = accumulator.to_row("full")
+
+    assert row["qcd"] == pytest.approx(0.3)
+    assert row["recall_at_k"] == pytest.approx(0.75)
+    assert row["recall_at_k_medium"] == pytest.approx(0.5)
+    assert row["smr"] == pytest.approx(0.25)
+    assert row["bam"] == pytest.approx(0.25)
+    assert row["scale_stride_correlation"] == pytest.approx(-0.5)
+
+
+def test_result_writer_emits_matching_json_and_csv(tmp_path):
+    rows = [VariantAccumulator(images=1).to_row("full")]
+
+    json_path, csv_path = write_results(tmp_path, {"checkpoint": "model.pth"}, rows)
+
+    payload = json.loads(json_path.read_text())
+    with csv_path.open(newline="") as handle:
+        csv_rows = list(csv.DictReader(handle))
+    assert payload["metadata"]["checkpoint"] == "model.pth"
+    assert payload["results"] == rows
+    assert csv_rows[0]["variant"] == "full"
+
+
+def test_stride_calibrated_table_uses_selected_policy_defaults():
+    evaluator = importlib.import_module(
+        "tools.evaluate_stride_calibrated_ablations"
+    )
+
+    args = evaluator.parse_args([])
+
+    assert args.cells_per_object == 8.0
+    assert args.gamma == 2.0
+    assert args.images == 100
+
+
+def test_stride_calibrated_table_maps_each_variant_to_the_right_policy():
+    evaluator = importlib.import_module(
+        "tools.evaluate_stride_calibrated_ablations"
+    )
+
+    assert evaluator.simulator_policy("native_host") is None
+    assert evaluator.simulator_policy("fixed_scale_gate") == "fixed"
+    for variant in (
+        "full",
+        "separate_scale_embeddings",
+        "shuffled_scale_embeddings",
+        "objectness_only_queries",
+        "content_location_diversity",
+    ):
+        assert evaluator.simulator_policy(variant) == "full"
