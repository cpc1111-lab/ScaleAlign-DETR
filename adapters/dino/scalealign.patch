+import pytest
+import torch
+
+from models.dino.ops.modules.ms_deform_attn import (
+    MSDeformAttn,
+    select_ms_deform_attention_backend,
+)
+
+
+def test_cpu_fallback_accepts_scalealign_level_bias():
+    module = MSDeformAttn(d_model=8, n_levels=2, n_heads=2, n_points=2)
+    query = torch.randn(1, 3, 8)
+    values = torch.randn(1, 8, 8)
+    shapes = torch.tensor([[2, 2], [2, 2]])
+    starts = torch.tensor([0, 4])
+    refs = torch.rand(1, 3, 2, 2)
+    bias = torch.zeros(1, 3, 2, 2)
+    output = module(query, refs, values, shapes, starts, level_bias=bias)
+    assert output.shape == (1, 3, 8)
+    assert torch.isfinite(output).all()
+
+
+def test_cpu_uses_pytorch_fallback_without_extension():
