diff --git a/datasets/scalealign_convert.py b/datasets/scalealign_convert.py
new file mode 100644
index 0000000000000000000000000000000000000000..ba48a22ba2a57cf392f53ae892d87f4e172f18e7
--- /dev/null
+++ b/datasets/scalealign_convert.py
@@ -0,0 +1,77 @@
+"""VOC and VisDrone conversion to COCO detection JSON."""
+
+import csv
+import json
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+from PIL import Image
+
+
+VOC_CLASSES = (
+    "aeroplane", "bicycle", "bird", "boat", "bottle", "bus", "car", "cat", "chair", "cow",
+    "diningtable", "dog", "horse", "motorbike", "person", "pottedplant", "sheep", "sofa", "train", "tvmonitor",
+)
+VISDRONE_CLASSES = (
+    "pedestrian", "people", "bicycle", "car", "van", "truck", "tricycle", "awning-tricycle", "bus", "motor",
+)
+
+
+def convert_voc(voc_roots, split_files, output):
+    categories = [{"id": index, "name": name} for index, name in enumerate(VOC_CLASSES)]
+    class_ids = {item["name"]: item["id"] for item in categories}
+    images, annotations = [], []
+    image_id = annotation_id = 1
+    for root, split_file in zip(map(Path, voc_roots), split_files):
+        for stem in Path(split_file).read_text().split():
+            tree = ET.parse(root / "Annotations" / (stem + ".xml")).getroot()
+            width = int(tree.findtext("size/width"))
+            height = int(tree.findtext("size/height"))
+            images.append({"id": image_id, "file_name": str((root / "JPEGImages" / (stem + ".jpg")).resolve()), "width": width, "height": height})
+            for obj in tree.findall("object"):
+                box = obj.find("bndbox")
+                x1 = max(0.0, float(box.findtext("xmin")) - 1.0)
+                y1 = max(0.0, float(box.findtext("ymin")) - 1.0)
+                x2 = min(float(width), float(box.findtext("xmax")))
+                y2 = min(float(height), float(box.findtext("ymax")))
+                w, h = x2 - x1, y2 - y1
+                if w <= 0 or h <= 0:
+                    continue
+                annotations.append({"id": annotation_id, "image_id": image_id, "category_id": class_ids[obj.findtext("name")], "bbox": [x1, y1, w, h], "area": w * h, "iscrowd": int(obj.findtext("difficult", "0"))})
+                annotation_id += 1
+            image_id += 1
+    _write_coco(output, images, annotations, categories)
+
+
+def convert_visdrone(image_dir, annotation_dir, output):
+    image_dir, annotation_dir = Path(image_dir), Path(annotation_dir)
+    categories = [{"id": index, "name": name} for index, name in enumerate(VISDRONE_CLASSES)]
+    images, annotations = [], []
+    annotation_id = 1
+    for image_id, image_path in enumerate(sorted(image_dir.glob("*.jpg")), 1):
+        with Image.open(image_path) as image:
+            width, height = image.size
+        images.append({"id": image_id, "file_name": str(image_path.resolve()), "width": width, "height": height})
+        label_path = annotation_dir / (image_path.stem + ".txt")
+        with label_path.open(newline="") as handle:
+            for row in csv.reader(handle):
+                if len(row) < 8:
+                    continue
+                x, y, w, h, score, category, truncation, occlusion = map(int, row[:8])
+                if category < 1 or category > 10 or score == 0 or w <= 0 or h <= 0:
+                    continue
+                x, y = max(0, x), max(0, y)
+                w, h = min(w, width - x), min(h, height - y)
+                if w <= 0 or h <= 0:
+                    continue
+                annotations.append({"id": annotation_id, "image_id": image_id, "category_id": category - 1, "bbox": [x, y, w, h], "area": w * h, "iscrowd": 0, "truncation": truncation, "occlusion": occlusion})
+                annotation_id += 1
+    _write_coco(output, images, annotations, categories)
+
+
+def _write_coco(output, images, annotations, categories):
+    output = Path(output)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    temporary = output.with_suffix(output.suffix + ".tmp")
+    temporary.write_text(json.dumps({"images": images, "annotations": annotations, "categories": categories}))
+    temporary.replace(output)
