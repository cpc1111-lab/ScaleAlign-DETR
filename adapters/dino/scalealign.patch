@@ -0,0 +1,299 @@
+import importlib
+import json
+import sys
+from pathlib import Path
+
+import pytest
+import torch
+from torch import nn
+
+sys.path.insert(0, str(Path(__file__).parents[2]))
+from util.geometric_saa_simulation import (
+    GeometricSAASimulator,
+    geometric_level_bias,
+    stride_calibrated_level_anchors,
+)
+
+
+def _reference_points(scales, levels=4):
+    boxes = torch.tensor(
+        [[[0.5, 0.5, scale, scale] for scale in scales]], dtype=torch.float32
+    )
+    return boxes[:, :, None, :].expand(-1, -1, levels, -1).clone()
+
+
+def test_zero_strength_is_exact_no_saa_bias():
+    reference_points = _reference_points([0.01, 0.5])
+
+    bias = geometric_level_bias(
+        reference_points, num_heads=2, gamma=0.0, temperature=0.25
+    )
+
+    torch.testing.assert_close(bias, torch.zeros_like(bias))
+
+
+def test_geometry_routes_small_boxes_to_fine_and_large_boxes_to_coarse_levels():
+    reference_points = _reference_points([torch.exp(torch.tensor(-7.0)), 1.0])
+
+    bias = geometric_level_bias(
+        reference_points, num_heads=2, gamma=1.0, temperature=0.25
+    )
+
+    assert bias.shape == (1, 2, 2, 4)
+    assert bias[0, 0, 0].argmax().item() == 0
+    assert bias[0, 1, 0].argmax().item() == 3
+    torch.testing.assert_close(bias[0, :, 0], bias[0, :, 1])
+
+
+def test_geometry_rejects_nonpositive_temperature():
+    with pytest.raises(ValueError, match="temperature"):
+        geometric_level_bias(
+            _reference_points([0.1]), num_heads=2, gamma=1.0, temperature=0.0
+        )
+
+
+class FakeCrossAttention(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.n_heads = 2
+        self.weight = nn.Parameter(torch.tensor(3.0))
+
+    def forward(
+        self,
+        query,
+        reference_points,
+        input_flatten=None,
+        input_spatial_shapes=None,
+        input_level_start_index=None,
+        input_padding_mask=None,
+        level_bias=None,
+    ):
+        return level_bias
+
+
+class FakeModel(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.transformer = nn.Module()
+        self.transformer.decoder = nn.Module()
+        layer = nn.Module()
+        layer.cross_attn = FakeCrossAttention()
+        layer.scalealign_attention = nn.Module()
+        layer.scalealign_attention.register_buffer(
+            "log_strides", torch.tensor([8.0, 16.0, 32.0, 64.0]).log()
+        )
+        self.transformer.decoder.layers = nn.ModuleList([layer])
+
+
+def test_simulator_replaces_bias_and_close_restores_original_forward():
+    model = FakeModel()
+    cross_attention = model.transformer.decoder.layers[0].cross_attn
+    reference_points = _reference_points([0.01, 0.5])
+    query = torch.randn(1, 2, 8)
+    learned_bias = torch.full((1, 2, 2, 4), 9.0)
+    parameters_before = {
+        name: parameter.detach().clone() for name, parameter in model.named_parameters()
+    }
+
+    simulator = GeometricSAASimulator(model, gamma=1.0, temperature=0.25)
+    simulated = cross_attention(query, reference_points, level_bias=learned_bias)
+    simulator.close()
+    restored = cross_attention(query, reference_points, level_bias=learned_bias)
+
+    assert not torch.equal(simulated, learned_bias)
+    torch.testing.assert_close(restored, learned_bias)
+    for name, parameter in model.named_parameters():
+        torch.testing.assert_close(parameter, parameters_before[name])
+
+
+def test_stride_anchors_follow_physical_input_size_and_feature_strides():
+    spatial_shapes = torch.tensor([[100, 160], [50, 80], [25, 40], [13, 20]])
+    strides = torch.tensor([8.0, 16.0, 32.0, 64.0])
+
+    anchors = stride_calibrated_level_anchors(
+        spatial_shapes, strides, cells_per_object=4.0
+    )
+
+    image_geometric_size = (800.0 * 1280.0) ** 0.5
+    expected = (4.0 * strides / image_geometric_size).log()
+    torch.testing.assert_close(anchors, expected)
+
+
+def test_stride_anchors_translate_when_input_resolution_doubles():
+    shapes = torch.tensor([[100, 160], [50, 80], [25, 40], [13, 20]])
+    strides = torch.tensor([8.0, 16.0, 32.0, 64.0])
+
+    original = stride_calibrated_level_anchors(shapes, strides, 4.0)
+    doubled = stride_calibrated_level_anchors(shapes * 2, strides, 4.0)
+
+    torch.testing.assert_close(doubled, original - torch.log(torch.tensor(2.0)))
+
+
+def test_stride_calibrated_hook_uses_runtime_spatial_shapes():
+    model = FakeModel()
+    cross_attention = model.transformer.decoder.layers[0].cross_attn
+    reference_points = _reference_points([0.01, 0.5])
+    query = torch.randn(1, 2, 8)
+    spatial_shapes = torch.tensor([[100, 160], [50, 80], [25, 40], [13, 20]])
+    learned_bias = torch.full((1, 2, 2, 4), 9.0)
+
+    with GeometricSAASimulator(
+        model,
+        gamma=1.0,
+        temperature=0.25,
+        anchor_mode="stride_calibrated",
+        cells_per_object=4.0,
+    ):
+        simulated = cross_attention(
+            query,
+            reference_points,
+            None,
+            spatial_shapes,
+            None,
+            None,
+            level_bias=learned_bias,
+        )
+
+    anchors = stride_calibrated_level_anchors(
+        spatial_shapes, torch.tensor([8.0, 16.0, 32.0, 64.0]), 4.0
+    )
+    expected = geometric_level_bias(
+        reference_points,
+        num_heads=2,
+        gamma=1.0,
+        temperature=0.25,
+        level_anchors=anchors,
+    )
+    torch.testing.assert_close(simulated, expected)
+
+
+def test_fixed_query_mode_replaces_query_bias_with_its_mean():
+    model = FakeModel()
+    cross_attention = model.transformer.decoder.layers[0].cross_attn
+    reference_points = _reference_points([0.01, 0.1, 0.5])
+    query = torch.randn(1, 3, 8)
+    spatial_shapes = torch.tensor([[100, 160], [50, 80], [25, 40], [13, 20]])
+
+    with GeometricSAASimulator(
+        model,
+        gamma=2.0,
+        temperature=0.25,
+        anchor_mode="stride_calibrated",
+        cells_per_object=8.0,
+        query_mode="fixed",
+    ):
+        simulated = cross_attention(
+            query, reference_points, None, spatial_shapes, None, None
+        )
+
+    torch.testing.assert_close(simulated[:, 0], simulated[:, 1])
+    torch.testing.assert_close(simulated[:, 1], simulated[:, 2])
+
+
+def test_sweep_cli_defaults_to_the_approved_strengths():
+    simulation = importlib.import_module("tools.simulate_geometric_saa")
+
+    args = simulation.parse_args([])
+
+    assert args.gammas == [0.0, 0.5, 1.0, 2.0, 4.0]
+    assert args.images == 100
+    assert args.temperature == 0.25
+
+
+@pytest.mark.parametrize(
+    "arguments",
+    (("--images", "0"), ("--temperature", "0"), ("--gammas", "-1")),
+)
+def test_sweep_cli_rejects_invalid_positive_values(arguments):
+    simulation = importlib.import_module("tools.simulate_geometric_saa")
+
+    with pytest.raises(SystemExit):
+        simulation.parse_args(list(arguments))
+
+
+def test_sweep_results_are_written_atomically(tmp_path):
+    simulation = importlib.import_module("tools.simulate_geometric_saa")
+    metadata = {"simulation": "geometric_saa", "images": 2}
+    rows = [
+        {
+            "gamma": 0.0,
+            "images": 2,
+            "smr": 0.2,
+            "smr_mismatch_count": 20,
+            "smr_support": 100,
+            "bam": 0.3,
+            "bam_outside_mass": 6.0,
+            "bam_total_mass": 20.0,
+            "scale_stride_correlation": 0.5,
+            "correlation_support": 10,
+        }
+    ]
+
+    json_path, csv_path = simulation.write_results(tmp_path, metadata, rows)
+
+    assert json.loads(json_path.read_text()) == {
+        "metadata": metadata,
+        "results": rows,
+    }
+    assert csv_path.read_text().splitlines()[0].startswith("gamma,images,smr")
+    assert not list(tmp_path.glob("*.tmp"))
+
+
+def test_result_writer_accepts_an_explicit_artifact_stem(tmp_path):
+    simulation = importlib.import_module("tools.simulate_geometric_saa")
+
+    json_path, csv_path = simulation.write_results(
+        tmp_path,
+        {"simulation": "stride_calibrated_saa"},
+        [{"gamma": 0.0}],
+        stem="stride_calibrated_saa",
+    )
+
+    assert json_path.name == "stride_calibrated_saa.json"
+    assert csv_path.name == "stride_calibrated_saa.csv"
+
+
+def test_stride_sweep_defaults_to_sixteen_candidates_plus_baseline():
+    simulation = importlib.import_module("tools.simulate_stride_calibrated_saa")
+
+    args = simulation.parse_args([])
+    grid = simulation.candidate_grid(args.cells_per_object, args.gammas)
+
+    assert args.cells_per_object == [2.0, 4.0, 8.0, 16.0]
+    assert args.gammas == [0.25, 0.5, 1.0, 2.0]
+    assert len(grid) == 16
+    assert grid[0] == (2.0, 0.25)
+    assert grid[-1] == (16.0, 2.0)
+
+
+def test_pareto_annotation_requires_all_three_metrics_to_improve():
