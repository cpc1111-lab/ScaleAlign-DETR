+import sys
+from pathlib import Path
+
+import pytest
+import torch
+from torch import nn
+
+sys.path.insert(0, str(Path(__file__).parents[2]))
+from util.scalealign_ablation import apply_scalealign_eval_ablation
+from models.dino.scalealign import ScaleGuidedQueryGenerator
+
+
+class FakeScaleAttention(nn.Module):
+    def __init__(self, gate):
+        super().__init__()
+        self.gate = nn.Parameter(torch.tensor(gate))
+        self.runtime_mode = "full"
+
+
+class FakeSelector(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.runtime_mode = "scale"
+
+
+class FakeModel(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.transformer = nn.Module()
+        self.transformer.scalealign_enabled = True
+        self.transformer.scalealign_coverage_weight = 0.25
+        self.transformer.scalealign_content_gate = nn.Parameter(torch.tensor(0.5))
+        self.transformer.scalealign_content_mode = "full"
+        self.transformer.scale_embedding_seed = 0
+        self.transformer.scalealign_state = nn.Linear(2, 2)
+        self.transformer.scalealign_selector = FakeSelector()
+        self.transformer.decoder = nn.Module()
+        self.transformer.decoder.scalealign_state = self.transformer.scalealign_state
+        self.transformer.decoder.scale_embedding_mode = "full"
+        self.transformer.decoder.scale_embedding_seed = 0
+        self.transformer.decoder.layers = nn.ModuleList(
+            [
+                nn.ModuleDict({"scalealign_attention": FakeScaleAttention(0.2)}),
+                nn.ModuleDict({"scalealign_attention": FakeScaleAttention(-0.1)}),
+            ]
+        )
+
+
+def _gates(model):
+    return [
+        layer["scalealign_attention"].gate.item()
+        for layer in model.transformer.decoder.layers
+    ]
+
+
+def test_saa_off_only_zeros_attention_gates():
+    model = FakeModel()
+
+    report = apply_scalealign_eval_ablation(model, "saa_off")
+
+    assert report["mode"] == "saa_off"
+    assert model.transformer.scalealign_coverage_weight == 0.25
+    assert model.transformer.scalealign_content_gate.item() == 0.5
+    assert _gates(model) == pytest.approx([0.2, -0.1])
+    assert all(
+        layer["scalealign_attention"].runtime_mode == "off"
+        for layer in model.transformer.decoder.layers
+    )
+
+
+def test_topk_only_disables_scale_coverage_selection():
+    model = FakeModel()
+
+    apply_scalealign_eval_ablation(model, "topk")
+
+    assert model.transformer.scalealign_coverage_weight == 0.0
+    assert model.transformer.scalealign_content_gate.item() == 0.5
+    assert _gates(model) == pytest.approx([0.2, -0.1])
+
+
+def test_content_off_only_zeros_esm_content_gate():
+    model = FakeModel()
+
+    apply_scalealign_eval_ablation(model, "content_off")
+
+    assert model.transformer.scalealign_coverage_weight == 0.25
+    assert model.transformer.scalealign_content_gate.item() == 0.5
+    assert model.transformer.scalealign_content_mode == "off"
+    assert _gates(model) == pytest.approx([0.2, -0.1])
+
+
+def test_all_off_restores_topk_and_removes_scalealign_contributions():
+    model = FakeModel()
+
+    apply_scalealign_eval_ablation(model, "all_off")
+
+    assert model.transformer.scalealign_coverage_weight == 0.0
+    assert model.transformer.scalealign_content_gate.item() == 0.5
+    assert model.transformer.scalealign_content_mode == "off"
+    assert all(
+        layer["scalealign_attention"].runtime_mode == "off"
+        for layer in model.transformer.decoder.layers
+    )
+
+
+def test_native_host_is_the_named_all_off_policy():
+    model = FakeModel()
+
+    report = apply_scalealign_eval_ablation(model, "native_host")
+
+    assert report["mode"] == "native_host"
+    assert model.transformer.scalealign_coverage_weight == 0.0
+    assert model.transformer.scalealign_content_gate.item() == 0.5
+    assert model.transformer.scalealign_content_mode == "off"
+    assert all(
+        layer["scalealign_attention"].runtime_mode == "off"
+        for layer in model.transformer.decoder.layers
+    )
+
+
+def test_separate_embeddings_copy_weights_without_sharing_module():
+    model = FakeModel()
+    original = model.transformer.scalealign_state
+
+    apply_scalealign_eval_ablation(model, "separate_scale_embeddings")
+
+    copied = model.transformer.decoder.scalealign_state
+    assert copied is not original
+    assert all(torch.equal(a, b) for a, b in zip(original.state_dict().values(), copied.state_dict().values()))
+
+
+def test_shuffled_embeddings_sets_deterministic_decoder_policy():
+    model = FakeModel()
+
+    apply_scalealign_eval_ablation(model, "shuffled_scale_embeddings", seed=17)
+
+    assert model.transformer.decoder.scale_embedding_mode == "shuffle"
+    assert model.transformer.decoder.scale_embedding_seed == 17
+    assert model.transformer.scalealign_content_mode == "shuffle"
+    assert model.transformer.scale_embedding_seed == 17
+
+
+def test_fixed_gate_preserves_gates_and_removes_query_conditioning():
+    model = FakeModel()
+
+    apply_scalealign_eval_ablation(model, "fixed_scale_gate")
+
+    assert _gates(model) == pytest.approx([0.2, -0.1])
+    assert all(
+        layer["scalealign_attention"].runtime_mode == "fixed"
+        for layer in model.transformer.decoder.layers
+    )
+
+
+def test_full_restores_attention_runtime_mode_after_an_ablation():
+    model = FakeModel()
+    apply_scalealign_eval_ablation(model, "saa_off")
+
+    apply_scalealign_eval_ablation(model, "full")
+
+    assert all(
+        layer["scalealign_attention"].runtime_mode == "full"
+        for layer in model.transformer.decoder.layers
+    )
+
+
+def test_objectness_and_content_location_selectors_are_named_policies():
+    objectness = FakeModel()
+    diverse = FakeModel()
+
+    apply_scalealign_eval_ablation(objectness, "objectness_only_queries")
+    apply_scalealign_eval_ablation(diverse, "content_location_diversity")
+
+    assert objectness.transformer.scalealign_coverage_weight == 0.0
+    assert objectness.transformer.scalealign_selector.runtime_mode == "scale"
+    assert diverse.transformer.scalealign_selector.runtime_mode == "content_location"
+
+
+def test_content_location_selector_prefers_nonredundant_candidate():
+    selector = ScaleGuidedQueryGenerator(num_bins=4, temperature=0.25, min_pool_size=3)
+    selector.runtime_mode = "content_location"
+    scores = torch.tensor([[3.0, 2.9, 2.8]])
+    boxes = torch.tensor(
+        [[[0.10, 0.10, 0.2, 0.2], [0.11, 0.11, 0.2, 0.2], [0.90, 0.90, 0.2, 0.2]]]
+    )
+    contents = torch.tensor([[[1.0, 0.0], [1.0, 0.0], [0.0, 1.0]]])
+
+    selected = selector(scores, boxes, 2, 0.25, contents=contents)
+
+    assert selected.tolist() == [[0, 2]]
+
+
+def test_selector_capture_retains_detached_query_diagnostics():
+    selector = ScaleGuidedQueryGenerator(num_bins=4, temperature=0.25, min_pool_size=3)
+    selector.capture_diagnostics = True
+    scores = torch.tensor([[3.0, 2.9, 2.8]], requires_grad=True)
+    boxes = torch.tensor(
+        [[[0.10, 0.10, 0.1, 0.1], [0.50, 0.50, 0.2, 0.2], [0.90, 0.90, 0.3, 0.3]]],
+        requires_grad=True,
+    )
+
+    selected = selector(scores, boxes, 2, 0.0)
+
+    captured = selector.last_diagnostics
+    assert torch.equal(captured["indices"], selected)
+    assert captured["scores"].requires_grad is False
+    assert captured["boxes"].requires_grad is False
+
+
+def test_unknown_mode_is_rejected():
+    with pytest.raises(ValueError, match="unknown ScaleAlign evaluation ablation"):
+        apply_scalealign_eval_ablation(FakeModel(), "invalid")
