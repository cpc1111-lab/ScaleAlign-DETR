+import sys
+from pathlib import Path
+
+import pytest
+import torch
+
+sys.path.insert(0, str(Path(__file__).parents[2]))
+
+from util.scalealign_diagnostics import (
+    AttentionStatistics,
+    CorrelationMoments,
+    RecallStatistics,
+    attention_statistics,
+    proposal_recall_statistics,
+    query_coverage_divergence,
+)
+
+
+def test_query_coverage_divergence_is_zero_for_matching_distributions():
+    scores = torch.tensor([[0.0, 0.0]])
+    boxes = torch.tensor([[[0.5, 0.5, 0.1, 0.1], [0.5, 0.5, 0.8, 0.8]]])
+    anchors = torch.tensor([torch.log(torch.tensor(0.1)), torch.log(torch.tensor(0.8))])
+
+    qcd = query_coverage_divergence(scores, boxes, torch.tensor([[0, 1]]), anchors, temperature=0.01)
+
+    assert qcd.item() == pytest.approx(0.0, abs=1e-5)
+
+
+def test_recall_statistics_use_coco_area_bands_and_merge_counts():
+    proposals = torch.tensor(
+        [[[0.10, 0.10, 0.02, 0.02], [0.50, 0.50, 0.10, 0.10], [0.80, 0.80, 0.30, 0.30]]]
+    )
+    targets = [torch.tensor([[0.10, 0.10, 0.02, 0.02], [0.50, 0.50, 0.10, 0.10], [0.20, 0.80, 0.30, 0.30]])]
+
+    stats = proposal_recall_statistics(proposals, targets, [(800, 800)])
+    doubled = stats + stats
+
+    assert stats.matched == (2, 1, 1, 0)
+    assert stats.total == (3, 1, 1, 1)
+    assert stats.rates == pytest.approx((2 / 3, 1.0, 1.0, 0.0))
+    assert doubled.matched == (4, 2, 2, 0)
+    assert doubled.total == (6, 2, 2, 2)
+
+
+def test_attention_statistics_measure_smr_bam_and_correlation():
+    query_scale = torch.tensor([[0.0, 1.0, 2.0]])
+    expected_stride = torch.tensor([[[2.0], [1.0], [0.0]]])
+    boxes = torch.tensor([[[0.5, 0.5, 0.4, 0.4]] * 3])
+    samples = torch.tensor(
+        [[[[[[0.5, 0.5], [0.9, 0.9]]]], [[[[0.5, 0.5], [0.9, 0.9]]]], [[[[0.5, 0.5], [0.9, 0.9]]]]]]
+    )
+    weights = torch.tensor([[[[[0.25, 0.75]]], [[[0.25, 0.75]]], [[[0.25, 0.75]]]]])
+
+    stats = attention_statistics(query_scale, expected_stride, boxes, samples, weights)
+    merged = stats + stats
+
+    assert stats.smr_count == 3
+    assert stats.smr_support == 3
+    assert stats.smr == pytest.approx(1.0)
+    assert stats.bam == pytest.approx(0.75)
+    assert stats.correlation == pytest.approx(-1.0)
+    assert merged.smr_count == 6
+    assert merged.bam == pytest.approx(0.75)
+
+
+def test_empty_statistics_have_explicit_undefined_ratios():
+    recall = RecallStatistics()
+    attention = AttentionStatistics()
+    moments = CorrelationMoments()
+
+    assert recall.rates == (None, None, None, None)
+    assert attention.smr is None
+    assert attention.bam is None
+    assert moments.correlation is None
