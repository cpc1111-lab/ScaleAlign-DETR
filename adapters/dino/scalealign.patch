+#!/usr/bin/env python3
+"""Sweep inference-only geometric SAA biases over COCO validation images."""
+
+import argparse
+import csv
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+import torch
+from tqdm.auto import tqdm
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+from datasets import build_dataset
+from tools.evaluate_scalealign_ablations import AttentionCollector, _build_model
+from util.geometric_saa_simulation import GeometricSAASimulator
+
+
+DEFAULT_GAMMAS = [0.0, 0.5, 1.0, 2.0, 4.0]
+
+
+def _positive_int(value):
+    parsed = int(value)
+    if parsed <= 0:
+        raise argparse.ArgumentTypeError("value must be positive")
+    return parsed
+
+
+def _positive_float(value):
+    parsed = float(value)
+    if parsed <= 0.0:
+        raise argparse.ArgumentTypeError("value must be positive")
+    return parsed
+
+
+def _nonnegative_float(value):
+    parsed = float(value)
+    if parsed < 0.0:
+        raise argparse.ArgumentTypeError("value must be nonnegative")
+    return parsed
+
+
+def parse_args(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--config", default="outputs/scalealign_coco_s/config_cfg.py"
+    )
+    parser.add_argument(
+        "--checkpoint", default="outputs/scalealign_coco_s/checkpoint_best_regular.pth"
+    )
+    parser.add_argument("--coco-path", default="data/coco")
+    parser.add_argument(
+        "--output-dir",
+        default="outputs/scalealign_coco_s/diagnostics/geometric_saa_sweep",
+    )
+    parser.add_argument("--images", type=_positive_int, default=100)
+    parser.add_argument(
+        "--gammas", nargs="+", type=_nonnegative_float, default=DEFAULT_GAMMAS
+    )
+    parser.add_argument("--temperature", type=_positive_float, default=0.25)
+    parser.add_argument("--scale-min", type=float, default=-7.0)
+    parser.add_argument("--scale-max", type=float, default=0.0)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--device", default="cuda")
+    return parser.parse_args(argv)
+
+
+def _sha256(path):
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def write_results(output_dir, metadata, rows, stem="geometric_saa_sweep"):
+    output_dir = Path(output_dir)
+    output_dir.mkdir(parents=True, exist_ok=True)
+    json_path = output_dir / f"{stem}.json"
+    csv_path = output_dir / f"{stem}.csv"
+    json_tmp = json_path.with_suffix(".json.tmp")
+    csv_tmp = csv_path.with_suffix(".csv.tmp")
+    json_tmp.write_text(
+        json.dumps({"metadata": metadata, "results": rows}, indent=2) + "\n"
+    )
+    fieldnames = list(rows[0]) if rows else ["gamma"]
+    with csv_tmp.open("w", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=fieldnames)
+        writer.writeheader()
+        writer.writerows(rows)
+    json_tmp.replace(json_path)
+    csv_tmp.replace(csv_path)
+    return json_path, csv_path
+
+
+def _statistics_row(gamma, images, statistics):
+    return {
+        "gamma": gamma,
+        "images": images,
+        "smr": statistics.smr,
+        "smr_mismatch_count": statistics.smr_count,
+        "smr_support": statistics.smr_support,
+        "bam": statistics.bam,
+        "bam_outside_mass": statistics.outside_mass,
+        "bam_total_mass": statistics.total_mass,
+        "scale_stride_correlation": statistics.correlation,
+        "correlation_support": statistics.correlation_moments.count,
+    }
+
+
+def evaluate_gamma(
+    model,
+    dataset,
+    device,
+    gamma,
+    temperature,
+    scale_min,
+    scale_max,
+    images,
+    seed,
+    anchor_mode="uniform",
+    cells_per_object=4.0,
+):
+    torch.manual_seed(seed)
+    simulator = GeometricSAASimulator(
+        model,
+        gamma=gamma,
+        temperature=temperature,
+        scale_min=scale_min,
+        scale_max=scale_max,
+        anchor_mode=anchor_mode,
+        cells_per_object=cells_per_object,
+    )
+    collector = AttentionCollector(model)
+    evaluated = min(images, len(dataset))
+    try:
+        with torch.inference_mode():
+            for index in tqdm(
+                range(evaluated),
+                desc=f"Geometric SAA gamma={gamma:g}",
+                unit="image",
+                dynamic_ncols=True,
+            ):
+                image, _ = dataset[index]
+                model([image.to(device)])
+    finally:
+        collector.close()
+        simulator.close()
+    return _statistics_row(gamma, evaluated, collector.statistics)
+
+
+def main(argv=None):
+    cli = parse_args(argv)
+    if cli.scale_min >= cli.scale_max:
+        raise ValueError("scale_min must be less than scale_max")
+    torch.manual_seed(cli.seed)
+    model, model_args = _build_model(
+        cli.config,
+        cli.checkpoint,
+        cli.coco_path,
+        cli.device,
+        variant="full",
+        seed=cli.seed,
+    )
+    dataset = build_dataset("val", model_args)
+    level_count = model.transformer.decoder.layers[0].cross_attn.n_levels
+    anchors = torch.linspace(cli.scale_min, cli.scale_max, level_count).tolist()
+    metadata = {
+        "simulation": "geometric_saa_counterfactual",
+        "checkpoint": str(Path(cli.checkpoint).resolve()),
+        "checkpoint_sha256": _sha256(cli.checkpoint),
+        "config": str(Path(cli.config).resolve()),
+        "coco_path": str(Path(cli.coco_path).resolve()),
+        "requested_images": cli.images,
+        "seed": cli.seed,
+        "device": cli.device,
+        "temperature": cli.temperature,
+        "scale_min": cli.scale_min,
+        "scale_max": cli.scale_max,
+        "level_anchors": anchors,
+        "gammas": cli.gammas,
+        "ap_evaluation": False,
+    }
+    rows = []
+    for gamma in cli.gammas:
+        row = evaluate_gamma(
+            model,
+            dataset,
+            cli.device,
+            gamma,
+            cli.temperature,
+            cli.scale_min,
+            cli.scale_max,
+            cli.images,
+            cli.seed,
+        )
+        rows.append(row)
+        json_path, csv_path = write_results(cli.output_dir, metadata, rows)
+        print(json.dumps(row, sort_keys=True), flush=True)
+    print(f"JSON: {json_path}", flush=True)
+    print(f"CSV: {csv_path}", flush=True)
+
+
+if __name__ == "__main__":
+    main()
