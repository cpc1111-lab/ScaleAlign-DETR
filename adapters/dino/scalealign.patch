+#!/usr/bin/env python3
+"""Evaluate ScaleAlign routing ablations without training or COCO AP."""
+
+import argparse
+import csv
+import hashlib
+import json
+import sys
+from dataclasses import dataclass, field
+from pathlib import Path
+
+import torch
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+from datasets import build_dataset
+from main import build_model_main, get_args_parser
+from util.scalealign_ablation import apply_scalealign_eval_ablation
+from util.scalealign_diagnostics import (
+    AttentionStatistics,
+    RecallStatistics,
+    attention_statistics,
+    proposal_recall_statistics,
+    query_coverage_divergence,
+)
+from util.slconfig import SLConfig
+
+
+VARIANTS = (
+    "full",
+    "native_host",
+    "separate_scale_embeddings",
+    "shuffled_scale_embeddings",
+    "fixed_scale_gate",
+    "objectness_only_queries",
+    "content_location_diversity",
+)
+
+
+@dataclass
+class VariantAccumulator:
+    qcd_sum: float = 0.0
+    qcd_count: int = 0
+    recall: RecallStatistics = field(default_factory=RecallStatistics)
+    attention: AttentionStatistics = field(default_factory=AttentionStatistics)
+    images: int = 0
+
+    def to_row(self, variant):
+        recall = self.recall.rates
+        return {
+            "variant": variant,
+            "images": self.images,
+            "qcd": self.qcd_sum / self.qcd_count if self.qcd_count else None,
+            "qcd_support": self.qcd_count,
+            "recall_at_k": recall[0],
+            "recall_at_k_small": recall[1],
+            "recall_at_k_medium": recall[2],
+            "recall_at_k_large": recall[3],
+            "recall_matched": self.recall.matched[0],
+            "recall_support": self.recall.total[0],
+            "smr": self.attention.smr,
+            "smr_mismatch_count": self.attention.smr_count,
+            "smr_support": self.attention.smr_support,
+            "bam": self.attention.bam,
+            "bam_outside_mass": self.attention.outside_mass,
+            "bam_total_mass": self.attention.total_mass,
+            "scale_stride_correlation": self.attention.correlation,
+            "correlation_support": self.attention.correlation_moments.count,
+        }
+
+
+def write_results(output_dir, metadata, rows):
+    output_dir = Path(output_dir)
+    output_dir.mkdir(parents=True, exist_ok=True)
+    json_path = output_dir / "inference_ablations.json"
+    csv_path = output_dir / "inference_ablations.csv"
+    json_tmp = json_path.with_suffix(".json.tmp")
+    csv_tmp = csv_path.with_suffix(".csv.tmp")
+    json_tmp.write_text(json.dumps({"metadata": metadata, "results": rows}, indent=2) + "\n")
+    with csv_tmp.open("w", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=list(rows[0]) if rows else ["variant"])
+        writer.writeheader()
+        writer.writerows(rows)
+    json_tmp.replace(json_path)
+    csv_tmp.replace(csv_path)
+    return json_path, csv_path
+
+
+class AttentionCollector:
+    def __init__(self, model):
+        self.statistics = AttentionStatistics()
+        self.handles = []
+        for layer in model.transformer.decoder.layers:
+            self.handles.append(
+                layer.cross_attn.register_forward_pre_hook(
+                    self._make_hook(layer), with_kwargs=True
+                )
+            )
+
+    def _make_hook(self, layer):
+        def capture(module, args, kwargs):
+            query, reference_points = args[:2]
+            offsets = module.sampling_offsets(query).view(
+                query.shape[0], query.shape[1], module.n_heads,
+                module.n_levels, module.n_points, 2,
+            )
+            logits = module.attention_weights(query).view(
+                query.shape[0], query.shape[1], module.n_heads,
+                module.n_levels, module.n_points,
+            )
+            level_bias = kwargs.get("level_bias")
+            if level_bias is not None:
+                logits = logits + level_bias.unsqueeze(-1)
+            weights = logits.flatten(-2).softmax(-1).view_as(logits)
+            if reference_points.shape[-1] != 4:
+                raise ValueError("ScaleAlign BAM requires four-dimensional reference boxes")
+            locations = (
+                reference_points[:, :, None, :, None, :2]
+                + offsets / module.n_points
+                * reference_points[:, :, None, :, None, 2:] * 0.5
+            )
+            boxes = reference_points[:, :, 0, :]
+            query_scale = boxes[..., 2:].clamp_min(1e-12).log().mean(dim=-1)
+            log_strides = layer.scalealign_attention.log_strides.to(
+                device=weights.device, dtype=torch.float64
+            )
+            level_mass = weights.to(torch.float64).sum(dim=-1)
+            expected_stride = (
+                level_mass * log_strides[None, None, None, :]
+            ).sum(dim=-1)
+            self.statistics = self.statistics + attention_statistics(
+                query_scale, expected_stride, boxes, locations, weights
+            )
+
+        return capture
+
+    def close(self):
+        for handle in self.handles:
+            handle.remove()
+
+
+def _model_args(config_path, coco_path, device):
+    args = get_args_parser().parse_args(
+        ["-c", str(config_path), "--coco_path", str(coco_path), "--device", device]
+    )
+    config = SLConfig.fromfile(str(config_path))._cfg_dict.to_dict()
+    for key, value in config.items():
+        setattr(args, key, value)
+    return args
+
+
+def _build_model(config_path, checkpoint_path, coco_path, device, variant, seed):
+    args = _model_args(config_path, coco_path, device)
+    model, _, _ = build_model_main(args)
+    checkpoint = torch.load(checkpoint_path, map_location="cpu", weights_only=False)
+    model.load_state_dict(checkpoint["model"], strict=True)
+    apply_scalealign_eval_ablation(model, variant, seed=seed)
+    model.transformer.scalealign_selector.capture_diagnostics = True
+    return model.to(device).eval(), args
+
+
+def _sha256(path):
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def evaluate_variant(config_path, checkpoint_path, coco_path, device, variant, seed, images):
+    torch.manual_seed(seed)
+    model, args = _build_model(
+        config_path, checkpoint_path, coco_path, device, variant, seed
+    )
+    dataset = build_dataset("val", args)
+    selector = model.transformer.scalealign_selector
+    collector = AttentionCollector(model)
+    accumulator = VariantAccumulator()
+    try:
+        with torch.inference_mode():
+            for index in range(min(images, len(dataset))):
+                image, target = dataset[index]
+                model([image.to(device)])
+                captured = selector.last_diagnostics
+                if captured is None:
+                    raise RuntimeError("query selector did not capture diagnostics")
+                indices = captured["indices"]
+                qcd = query_coverage_divergence(
+                    captured["scores"], captured["boxes"], indices,
+                    selector.anchors, selector.temperature, selector.epsilon,
+                )
+                selected_boxes = captured["boxes"].gather(
+                    1, indices.unsqueeze(-1).expand(-1, -1, 4)
+                )
+                size = tuple(int(value) for value in target["size"].tolist())
+                recall = proposal_recall_statistics(
+                    selected_boxes, [target["boxes"].to(device)], [size]
+                )
+                accumulator.qcd_sum += float(qcd.sum())
+                accumulator.qcd_count += int(qcd.numel())
+                accumulator.recall = accumulator.recall + recall
+                accumulator.images += 1
+                print(f"[{variant}] {index + 1}/{min(images, len(dataset))}", flush=True)
+        accumulator.attention = collector.statistics
+    finally:
+        collector.close()
+    return accumulator
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--config", default="outputs/scalealign_coco_s/config_cfg.py"
+    )
+    parser.add_argument(
+        "--checkpoint", default="outputs/scalealign_coco_s/checkpoint_best_regular.pth"
+    )
+    parser.add_argument("--coco-path", default="data/coco")
+    parser.add_argument(
+        "--output-dir", default="outputs/scalealign_coco_s/diagnostics"
+    )
+    parser.add_argument("--images", type=int, default=100)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--device", default="cuda")
+    parser.add_argument("--variants", nargs="+", choices=VARIANTS, default=list(VARIANTS))
+    return parser.parse_args()
+
+
+def main():
+    cli = parse_args()
+    if cli.images <= 0:
+        raise ValueError("--images must be positive")
+    rows = []
+    metadata = {
+        "checkpoint": str(Path(cli.checkpoint).resolve()),
+        "checkpoint_sha256": _sha256(cli.checkpoint),
+        "config": str(Path(cli.config).resolve()),
+        "coco_path": str(Path(cli.coco_path).resolve()),
+        "requested_images": cli.images,
+        "seed": cli.seed,
+        "device": cli.device,
+        "iou_threshold": 0.5,
+    }
+    for variant in cli.variants:
+        accumulator = evaluate_variant(
+            cli.config, cli.checkpoint, cli.coco_path, cli.device,
+            variant, cli.seed, cli.images,
+        )
+        rows.append(accumulator.to_row(variant))
+        json_path, csv_path = write_results(cli.output_dir, metadata, rows)
+        print(json.dumps(rows[-1], sort_keys=True), flush=True)
+    print(f"JSON: {json_path}", flush=True)
+    print(f"CSV: {csv_path}", flush=True)
+
+
+if __name__ == "__main__":
+    main()
