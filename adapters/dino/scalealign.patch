+    rows = [
+        {
+            "candidate": "baseline",
+            "smr": 0.20,
+            "bam": 0.30,
+            "scale_stride_correlation": 0.70,
+        },
+        {
+            "candidate": "all_better",
+            "smr": 0.15,
+            "bam": 0.25,
+            "scale_stride_correlation": 0.80,
+        },
+        {
