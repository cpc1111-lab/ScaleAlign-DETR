+#!/usr/bin/env python3
+"""Search stride-calibrated geometric SAA policies for Pareto improvements."""
+
+import argparse
+import json
+from pathlib import Path
+
+import torch
+
+from datasets import build_dataset
+from tools.evaluate_scalealign_ablations import _build_model
+from tools.simulate_geometric_saa import (
+    _positive_float,
+    _positive_int,
+    _sha256,
+    evaluate_gamma,
+    write_results,
+)
+
+
+DEFAULT_CELLS_PER_OBJECT = [2.0, 4.0, 8.0, 16.0]
+DEFAULT_GAMMAS = [0.25, 0.5, 1.0, 2.0]
+
+
+def parse_args(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--config", default="outputs/scalealign_coco_s/config_cfg.py"
+    )
+    parser.add_argument(
+        "--checkpoint", default="outputs/scalealign_coco_s/checkpoint_best_regular.pth"
+    )
+    parser.add_argument("--coco-path", default="data/coco")
+    parser.add_argument(
+        "--output-dir",
+        default="outputs/scalealign_coco_s/diagnostics/stride_calibrated_saa",
+    )
+    parser.add_argument("--images", type=_positive_int, default=100)
+    parser.add_argument(
+        "--cells-per-object",
+        nargs="+",
+        type=_positive_float,
+        default=DEFAULT_CELLS_PER_OBJECT,
+    )
+    parser.add_argument(
+        "--gammas", nargs="+", type=_positive_float, default=DEFAULT_GAMMAS
+    )
+    parser.add_argument("--temperature", type=_positive_float, default=0.25)
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--device", default="cuda")
+    return parser.parse_args(argv)
+
+
+def candidate_grid(cells_per_object, gammas):
+    return [
+        (float(cells), float(gamma))
+        for cells in cells_per_object
+        for gamma in gammas
+    ]
+
+
+def annotate_pareto(rows):
+    if not rows:
+        return []
+    baseline = rows[0]
+    annotated = []
+    for index, row in enumerate(rows):
+        item = dict(row)
+        item["baseline"] = index == 0
+        item["improves_smr"] = index > 0 and row["smr"] < baseline["smr"]
+        item["improves_bam"] = index > 0 and row["bam"] < baseline["bam"]
+        item["improves_scale_stride_correlation"] = (
+            index > 0
+            and row["scale_stride_correlation"]
+            > baseline["scale_stride_correlation"]
+        )
+        item["pareto_all"] = (
+            item["improves_smr"]
+            and item["improves_bam"]
+            and item["improves_scale_stride_correlation"]
+        )
+        annotated.append(item)
+    return annotated
+
+
+def _evaluate(model, dataset, cli, gamma, cells_per_object):
+    statistics = evaluate_gamma(
+        model,
+        dataset,
+        cli.device,
+        gamma,
+        cli.temperature,
+        scale_min=-7.0,
+        scale_max=0.0,
+        images=cli.images,
+        seed=cli.seed,
+        anchor_mode="stride_calibrated",
+        cells_per_object=cells_per_object,
+    )
+    return {
+        "candidate": (
+            "baseline"
+            if gamma == 0.0
+            else f"cells={cells_per_object:g},gamma={gamma:g}"
+        ),
+        "cells_per_object": None if gamma == 0.0 else cells_per_object,
+        **statistics,
+    }
+
+
+def main(argv=None):
+    cli = parse_args(argv)
+    torch.manual_seed(cli.seed)
+    model, model_args = _build_model(
+        cli.config,
+        cli.checkpoint,
+        cli.coco_path,
+        cli.device,
+        variant="full",
+        seed=cli.seed,
+    )
+    dataset = build_dataset("val", model_args)
+    metadata = {
+        "simulation": "stride_calibrated_saa_counterfactual",
+        "checkpoint": str(Path(cli.checkpoint).resolve()),
+        "checkpoint_sha256": _sha256(cli.checkpoint),
+        "config": str(Path(cli.config).resolve()),
+        "coco_path": str(Path(cli.coco_path).resolve()),
+        "requested_images": cli.images,
+        "seed": cli.seed,
+        "device": cli.device,
+        "temperature": cli.temperature,
+        "cells_per_object": cli.cells_per_object,
+        "gammas": cli.gammas,
+        "anchor_formula": "log(cells_per_object * stride / sqrt(input_h * input_w))",
+        "ap_evaluation": False,
+    }
+
+    rows = [_evaluate(model, dataset, cli, gamma=0.0, cells_per_object=1.0)]
+    annotated = annotate_pareto(rows)
+    json_path, csv_path = write_results(
+        cli.output_dir, metadata, annotated, stem="stride_calibrated_saa"
+    )
+    print(json.dumps(annotated[-1], sort_keys=True), flush=True)
+
+    for cells_per_object, gamma in candidate_grid(
+        cli.cells_per_object, cli.gammas
+    ):
+        rows.append(_evaluate(model, dataset, cli, gamma, cells_per_object))
+        annotated = annotate_pareto(rows)
+        json_path, csv_path = write_results(
+            cli.output_dir, metadata, annotated, stem="stride_calibrated_saa"
+        )
+        print(json.dumps(annotated[-1], sort_keys=True), flush=True)
+    print(f"JSON: {json_path}", flush=True)
+    print(f"CSV: {csv_path}", flush=True)
+
+
+if __name__ == "__main__":
+    main()
