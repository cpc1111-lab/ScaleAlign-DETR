+#!/usr/bin/env python3
+"""Prepare COCO, VOC 07+12, and VisDrone for ScaleAlign experiments."""
+
+import argparse
+import subprocess
+import tarfile
+import zipfile
+from pathlib import Path
+
+from datasets.scalealign_convert import convert_visdrone, convert_voc
+
+
+VOC_ARCHIVES = {
+    "VOCtrainval_06-Nov-2007.tar": "https://pjreddie.com/media/files/VOCtrainval_06-Nov-2007.tar",
+    "VOCtest_06-Nov-2007.tar": "https://pjreddie.com/media/files/VOCtest_06-Nov-2007.tar",
+}
+VISDRONE_ARCHIVES = {
+    "VisDrone2019-DET-train.zip": "https://github.com/ultralytics/yolov5/releases/download/v1.0/VisDrone2019-DET-train.zip",
+    "VisDrone2019-DET-val.zip": "https://github.com/ultralytics/yolov5/releases/download/v1.0/VisDrone2019-DET-val.zip",
+}
+
+
+def download(url, destination):
+    if destination.exists():
+        print(f"[reuse] {destination}")
+    command = [
+        "curl", "-L", "--fail", "--retry", "5", "-C", "-", "--progress-bar",
+        "-o", str(destination), url,
+    ]
+    subprocess.run(command, check=True)
+
+
+def extract_tar(archive, destination):
+    marker = destination / ".voc2007-extracted"
+    if marker.exists():
+        return
+    print(f"[extract] {archive.name}")
+    try:
+        with tarfile.open(archive) as handle:
+            handle.extractall(destination, filter="data")
+    except tarfile.TarError as error:
+        raise RuntimeError(f"incomplete or invalid archive: {archive}") from error
+
+
+def extract_zip(archive, destination):
+    expected = destination / archive.stem
+    if expected.exists():
+        return
+    print(f"[extract] {archive.name}")
+    try:
+        with zipfile.ZipFile(archive) as handle:
+            handle.extractall(destination)
+    except zipfile.BadZipFile as error:
+        raise RuntimeError(f"incomplete or invalid archive: {archive}") from error
+
+
+def validate_coco(root):
+    required = (
+        root / "train2017",
+        root / "val2017",
+        root / "annotations" / "instances_train2017.json",
+        root / "annotations" / "instances_val2017.json",
+    )
+    missing = [str(path) for path in required if not path.exists()]
+    if missing:
+        raise FileNotFoundError("COCO is incomplete:\n" + "\n".join(missing))
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--data-dir", type=Path, default=Path("data"))
+    parser.add_argument(
+        "--coco-source",
+        type=Path,
+        default=Path("data/coco"),
+    )
+    parser.add_argument(
+        "--voc2012",
+        type=Path,
+        default=Path("data/VOCdevkit/VOC2012"),
+    )
+    parser.add_argument("--skip-download", action="store_true")
+    args = parser.parse_args()
+
+    data = args.data_dir.resolve()
+    downloads = data / "downloads"
+    downloads.mkdir(parents=True, exist_ok=True)
+    validate_coco(args.coco_source)
+    coco_link = data / "coco"
+    if not coco_link.exists():
+        coco_link.symlink_to(args.coco_source.resolve(), target_is_directory=True)
+
+    archives = {**VOC_ARCHIVES, **VISDRONE_ARCHIVES}
+    if not args.skip_download:
+        for name, url in archives.items():
+            download(url, downloads / name)
+    for name in archives:
+        if not (downloads / name).exists():
+            raise FileNotFoundError(downloads / name)
+
+    voc_dir = data / "voc"
+    voc_dir.mkdir(exist_ok=True)
+    for name in VOC_ARCHIVES:
+        extract_tar(downloads / name, voc_dir)
+    (voc_dir / ".voc2007-extracted").touch()
+    voc2007 = voc_dir / "VOCdevkit" / "VOC2007"
+    voc_annotations = voc_dir / "annotations"
+    print("[convert] VOC 2007+2012 trainval")
+    convert_voc(
+        [voc2007, args.voc2012],
+        [
+            voc2007 / "ImageSets" / "Main" / "trainval.txt",
+            args.voc2012 / "ImageSets" / "Main" / "trainval.txt",
+        ],
+        voc_annotations / "voc0712_trainval.json",
+    )
+    print("[convert] VOC 2007 test")
+    convert_voc(
+        [voc2007],
+        [voc2007 / "ImageSets" / "Main" / "test.txt"],
+        voc_annotations / "voc2007_test.json",
+    )
+
+    visdrone_dir = data / "visdrone"
+    visdrone_dir.mkdir(exist_ok=True)
+    for name in VISDRONE_ARCHIVES:
+        extract_zip(downloads / name, visdrone_dir)
+    visdrone_annotations = visdrone_dir / "annotations"
+    for split in ("train", "val"):
+        source = visdrone_dir / f"VisDrone2019-DET-{split}"
+        print(f"[convert] VisDrone {split}")
+        convert_visdrone(
+            source / "images",
+            source / "annotations",
+            visdrone_annotations / f"visdrone_{split}.json",
+        )
+    print(f"[ready] datasets prepared under {data}")
+
+
+if __name__ == "__main__":
+    main()
