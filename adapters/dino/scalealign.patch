@@ -0,0 +1,236 @@
+"""ScaleAlign geometry state and resource allocation modules."""
+
+from dataclasses import dataclass
+
+import torch
+from torch import Tensor, nn
+
+
+@dataclass(frozen=True)
+class ScaleState:
+    log_scale: Tensor
+    log_aspect: Tensor
+    embedding: Tensor
+
+
+class ExplicitScaleModel(nn.Module):
+    """Encode detached predicted box geometry as a continuous scale state."""
+
+    def __init__(self, scale_dim=64, epsilon=1e-6):
+        super().__init__()
+        self.epsilon = epsilon
+        self.projection = nn.Sequential(
+            nn.Linear(2, scale_dim),
+            nn.GELU(),
+            nn.Linear(scale_dim, scale_dim),
+        )
+        self.norm = nn.LayerNorm(scale_dim)
+
+    def forward(self, boxes):
+        wh = boxes.detach()[..., 2:].clamp(self.epsilon, 1.0)
+        log_wh = wh.log()
+        descriptor = torch.stack(
+            (log_wh.mean(dim=-1), log_wh[..., 0] - log_wh[..., 1]), dim=-1
+        )
+        embedding = self.norm(self.projection(descriptor))
+        return ScaleState(descriptor[..., 0], descriptor[..., 1], embedding)
+
+
+class ScaleGuidedQueryGenerator(nn.Module):
+    """Allocate a finite query budget while covering proposal scale modes."""
+
+    def __init__(
+        self,
+        num_bins=8,
+        temperature=0.25,
+        epsilon=1e-6,
+        pool_factor=2,
+        min_pool_size=2048,
+    ):
+        super().__init__()
+        if num_bins < 2:
+            raise ValueError("num_bins must be at least two")
+        self.num_bins = num_bins
+        self.temperature = temperature
+        self.epsilon = epsilon
+        self.pool_factor = pool_factor
+        self.min_pool_size = min_pool_size
+        self.runtime_mode = "scale"
+        self.capture_diagnostics = False
+        self.last_diagnostics = None
+        self.register_buffer("anchors", torch.linspace(-7.0, 0.0, num_bins))
+
+    def memberships(self, boxes):
+        wh = boxes.detach()[..., 2:].clamp(self.epsilon, 1.0)
+        log_scale = wh.log().mean(dim=-1)
+        distances = (log_scale.unsqueeze(-1) - self.anchors) ** 2
+        return (-distances / self.temperature).softmax(dim=-1)
+
+    @staticmethod
+    def quality(scores):
+        """Map arbitrary foreground logits to a bounded coverage utility."""
+        return scores.sigmoid()
+
+    def forward(self, scores, boxes, query_count, coverage_weight, contents=None):
+        if scores.ndim != 2 or boxes.shape[:2] != scores.shape:
+            raise ValueError("scores and boxes must share [batch, proposals]")
+        if not 0 < query_count <= scores.shape[1]:
+            raise ValueError("query_count must be within the proposal count")
+        original_scores = scores
+        original_boxes = boxes
+        if self.runtime_mode == "content_location":
+            if contents is None or contents.shape[:2] != scores.shape:
+                raise ValueError("content/location selection requires matching contents")
+            indices = self._content_location_indices(
+                scores, boxes, contents, query_count, coverage_weight
+            )
+            return self._return_with_diagnostics(original_scores, original_boxes, indices)
+        if coverage_weight == 0:
+            indices = scores.topk(query_count, dim=1).indices
+            return self._return_with_diagnostics(original_scores, original_boxes, indices)
+
+        pool_size = min(
+            scores.shape[1], max(query_count * self.pool_factor, self.min_pool_size)
+        )
+        pool_indices = scores.topk(pool_size, dim=1).indices
+        scores = scores.gather(1, pool_indices)
+        boxes = boxes.gather(
+            1, pool_indices.unsqueeze(-1).expand(-1, -1, boxes.shape[-1])
+        )
+
+        memberships = self.memberships(boxes)
+        quality = self.quality(scores)
+        confidence = quality
+        target = (confidence.unsqueeze(-1) * memberships).sum(dim=1)
+        target = (target / (confidence.sum(dim=1, keepdim=True) + self.epsilon)).detach()
+        selected_counts = torch.zeros_like(target)
+        available = torch.ones_like(scores, dtype=torch.bool)
+        selections = []
+
+        for step in range(query_count):
+            candidate_counts = selected_counts[:, None, :] + memberships
+            candidate_dist = (candidate_counts + self.epsilon) / (
+                step + 1 + self.num_bins * self.epsilon
+            )
+            kl = (target[:, None, :] * (target[:, None, :] + self.epsilon).log()).sum(-1)
+            kl = kl - (target[:, None, :] * candidate_dist.log()).sum(-1)
+            utility = quality - coverage_weight * kl
+            utility = utility.masked_fill(~available, float("-inf"))
+            chosen = utility.argmax(dim=1)
+            selections.append(chosen)
+            available.scatter_(
+                1,
+                chosen[:, None],
+                torch.zeros_like(chosen[:, None], dtype=torch.bool),
+            )
+            chosen_membership = memberships.gather(
+                1, chosen[:, None, None].expand(-1, 1, self.num_bins)
+            ).squeeze(1)
+            selected_counts = selected_counts + chosen_membership
+
+        selected_in_pool = torch.stack(selections, dim=1)
+        indices = pool_indices.gather(1, selected_in_pool)
+        return self._return_with_diagnostics(original_scores, original_boxes, indices)
+
+    def _return_with_diagnostics(self, scores, boxes, indices):
+        if self.capture_diagnostics:
+            self.last_diagnostics = {
+                "scores": scores.detach(),
+                "boxes": boxes.detach(),
+                "indices": indices.detach(),
+            }
+        return indices
+
+    def _content_location_indices(self, scores, boxes, contents, query_count, diversity_weight):
+        pool_size = min(
+            scores.shape[1], max(query_count * self.pool_factor, self.min_pool_size)
+        )
+        pool_indices = scores.topk(pool_size, dim=1).indices
+        pool_scores = scores.gather(1, pool_indices)
+        pool_quality = self.quality(pool_scores)
+        pool_boxes = boxes.gather(1, pool_indices.unsqueeze(-1).expand(-1, -1, 4))
+        pool_contents = contents.gather(
+            1, pool_indices.unsqueeze(-1).expand(-1, -1, contents.shape[-1])
+        )
+        normalized_contents = torch.nn.functional.normalize(pool_contents.detach(), dim=-1)
+        centers = pool_boxes.detach()[..., :2]
+        available = torch.ones_like(pool_scores, dtype=torch.bool)
+        max_similarity = torch.full_like(pool_scores, -1.0)
+        min_distance = torch.full_like(pool_scores, 2.0**0.5)
+        selections = []
+        for step in range(query_count):
+            if step == 0:
+                utility = pool_quality
+            else:
+                content_diversity = (1.0 - max_similarity) * 0.5
+                location_diversity = min_distance / (2.0**0.5)
+                utility = pool_quality + diversity_weight * (
+                    content_diversity + location_diversity
+                )
+            utility = utility.masked_fill(~available, float("-inf"))
+            chosen = utility.argmax(dim=1)
+            selections.append(chosen)
+            available.scatter_(1, chosen[:, None], False)
+            chosen_content = normalized_contents.gather(
+                1, chosen[:, None, None].expand(-1, 1, normalized_contents.shape[-1])
+            )
+            similarity = (normalized_contents * chosen_content).sum(dim=-1)
+            max_similarity = torch.maximum(max_similarity, similarity)
+            chosen_center = centers.gather(1, chosen[:, None, None].expand(-1, 1, 2))
+            distance = torch.linalg.vector_norm(centers - chosen_center, dim=-1)
+            min_distance = torch.minimum(min_distance, distance)
+        return pool_indices.gather(1, torch.stack(selections, dim=1))
+
+
+def add_level_bias(logits, level_bias):
+    """Add a level-constant bias to [..., heads, levels, points] logits."""
+
+    if logits.ndim != 5 or level_bias.shape != logits.shape[:-2] + (logits.shape[-2],):
+        raise ValueError("level_bias must match [batch, queries, heads, levels]")
+    return logits + level_bias.unsqueeze(-1)
+
+
+class ScaleAlignedAttention(nn.Module):
+    """Generate query-dependent, per-head feature-level compatibility biases."""
+
+    def __init__(self, scale_dim, num_heads, strides=(8, 16, 32, 64, 128)):
+        super().__init__()
+        self.num_heads = num_heads
+        self.register_buffer("log_strides", torch.tensor(strides, dtype=torch.float32).log())
+        self.query_projection = nn.Linear(scale_dim, scale_dim, bias=False)
+        self.level_projection = nn.Sequential(
+            nn.Linear(1, scale_dim), nn.GELU(), nn.Linear(scale_dim, scale_dim)
+        )
+        self.head_strength = nn.Parameter(torch.zeros(num_heads))
+        # Kept only so legacy optimizer/checkpoint parameter groups remain loadable.
+        self.gate = nn.Parameter(torch.ones(()))
+        self.runtime_mode = "full"
+        nn.init.zeros_(self.query_projection.weight)
+
+    def _load_from_state_dict(
+        self, state_dict, prefix, local_metadata, strict, missing_keys,
+        unexpected_keys, error_msgs,
+    ):
+        gate_key = prefix + "gate"
+        projection_key = prefix + "query_projection.weight"
+        legacy_gate = state_dict.get(gate_key)
+        if legacy_gate is not None and projection_key in state_dict:
+            if not torch.equal(legacy_gate, torch.ones_like(legacy_gate)):
+                state_dict[projection_key] = state_dict[projection_key] * legacy_gate
+                state_dict[gate_key] = torch.ones_like(legacy_gate)
+        super()._load_from_state_dict(
+            state_dict, prefix, local_metadata, strict, missing_keys,
+            unexpected_keys, error_msgs,
+        )
+
+    def forward(self, scale_embedding):
+        query = self.query_projection(scale_embedding)
+        levels = self.level_projection(self.log_strides[:, None])
+        compatibility = torch.einsum("bqd,ld->bql", query, levels) / query.shape[-1] ** 0.5
+        strength = torch.nn.functional.softplus(self.head_strength)
+        bias = compatibility[:, :, None, :] * strength[None, None, :, None]
+        if self.runtime_mode == "off":
+            return torch.zeros_like(bias)
+        if self.runtime_mode == "fixed":
+            bias = bias.mean(dim=1, keepdim=True).expand_as(bias)
+        return bias
