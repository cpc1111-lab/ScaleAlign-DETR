+++ b/util/geometric_saa_simulation.py
@@ -0,0 +1,152 @@
+"""Inference-only geometric counterfactuals for ScaleAlign attention."""
+
+import torch
+
+
+def stride_calibrated_level_anchors(
+    spatial_shapes, strides, cells_per_object, epsilon=1e-6
+):
+    """Map feature strides to normalized object scales for the current input."""
+
+    if spatial_shapes.ndim != 2 or spatial_shapes.shape[-1] != 2:
+        raise ValueError("spatial_shapes must have shape [levels, 2]")
+    if strides.ndim != 1 or strides.shape[0] != spatial_shapes.shape[0]:
+        raise ValueError("strides must contain one value per feature level")
+    if cells_per_object <= 0.0:
+        raise ValueError("cells_per_object must be positive")
+    if (spatial_shapes <= 0).any() or (strides <= 0).any():
+        raise ValueError("spatial shapes and strides must be positive")
+
+    spatial_shapes = spatial_shapes.to(device=strides.device, dtype=strides.dtype)
+    input_hw = spatial_shapes[0] * strides[0]
+    input_geometric_size = input_hw.prod().clamp_min(epsilon).sqrt()
+    return (cells_per_object * strides / input_geometric_size).clamp_min(epsilon).log()
+
+
+def geometric_level_bias(
+    reference_points,
+    num_heads,
+    gamma,
+    temperature,
+    scale_min=-7.0,
+    scale_max=0.0,
+    epsilon=1e-6,
+    level_anchors=None,
+):
+    """Construct a standardized scale-to-level bias from predicted boxes."""
+
+    if reference_points.ndim != 4 or reference_points.shape[-1] != 4:
+        raise ValueError("reference_points must have shape [batch, queries, levels, 4]")
+    if reference_points.shape[2] < 2:
+        raise ValueError("geometric SAA simulation requires at least two levels")
+    if num_heads <= 0:
+        raise ValueError("num_heads must be positive")
+    if temperature <= 0.0:
+        raise ValueError("temperature must be positive")
+    if gamma < 0.0:
+        raise ValueError("gamma must be nonnegative")
+    if level_anchors is None and scale_min >= scale_max:
+        raise ValueError("scale_min must be less than scale_max")
+
+    boxes = reference_points[:, :, 0]
+    log_scale = boxes[..., 2:].detach().clamp(epsilon, 1.0).log().mean(dim=-1)
+    if level_anchors is None:
+        anchors = torch.linspace(
+            scale_min,
+            scale_max,
+            reference_points.shape[2],
+            device=reference_points.device,
+            dtype=reference_points.dtype,
+        )
+    else:
+        if level_anchors.ndim != 1 or level_anchors.shape[0] != reference_points.shape[2]:
+            raise ValueError("level_anchors must contain one value per feature level")
+        anchors = level_anchors.to(reference_points)
+    compatibility = -(log_scale.unsqueeze(-1) - anchors) ** 2 / temperature
+    compatibility = compatibility - compatibility.mean(dim=-1, keepdim=True)
+    compatibility = compatibility / compatibility.std(
+        dim=-1, keepdim=True, unbiased=False
+    ).clamp_min(epsilon)
+    bias = compatibility[:, :, None, :].expand(-1, -1, num_heads, -1)
+    return bias * gamma
+
+
+class GeometricSAASimulator:
+    """Temporarily replace learned SAA biases with geometric counterfactuals."""
+
+    def __init__(
+        self,
+        model,
+        gamma,
+        temperature=0.25,
+        scale_min=-7.0,
+        scale_max=0.0,
+        anchor_mode="uniform",
+        cells_per_object=4.0,
+        query_mode="full",
+    ):
+        self.gamma = float(gamma)
+        self.temperature = float(temperature)
+        self.scale_min = float(scale_min)
+        self.scale_max = float(scale_max)
+        if anchor_mode not in ("uniform", "stride_calibrated"):
+            raise ValueError("anchor_mode must be uniform or stride_calibrated")
+        if cells_per_object <= 0.0:
+            raise ValueError("cells_per_object must be positive")
+        self.anchor_mode = anchor_mode
+        self.cells_per_object = float(cells_per_object)
+        if query_mode not in ("full", "fixed"):
+            raise ValueError("query_mode must be full or fixed")
+        self.query_mode = query_mode
+        self.handles = []
+        layers = model.transformer.decoder.layers
+        for layer in layers:
+            attention = getattr(layer, "scalealign_attention", None)
+            strides = None
+            if self.anchor_mode == "stride_calibrated":
+                if attention is None or not hasattr(attention, "log_strides"):
+                    raise ValueError("stride-calibrated simulation requires SAA strides")
+                strides = attention.log_strides.detach().exp()
+            self.handles.append(
+                layer.cross_attn.register_forward_pre_hook(
+                    self._make_level_bias_hook(strides), with_kwargs=True
+                )
+            )
+
+    def _make_level_bias_hook(self, strides):
+        def replace_level_bias(module, args, kwargs):
+            if len(args) < 2:
+                raise ValueError("cross-attention hook requires reference points")
+            anchors = None
+            if self.anchor_mode == "stride_calibrated":
+                if len(args) < 4:
+                    raise ValueError("stride-calibrated hook requires spatial shapes")
+                anchors = stride_calibrated_level_anchors(
+                    args[3], strides.to(args[1]), self.cells_per_object
+                )
+            bias = geometric_level_bias(
+                args[1],
+                num_heads=module.n_heads,
+                gamma=self.gamma,
+                temperature=self.temperature,
+                scale_min=self.scale_min,
+                scale_max=self.scale_max,
+                level_anchors=anchors,
+            )
+            if self.query_mode == "fixed":
+                bias = bias.mean(dim=1, keepdim=True).expand_as(bias)
+            kwargs["level_bias"] = bias
+            return args, kwargs
+
+        return replace_level_bias
+
+    def close(self):
+        for handle in self.handles:
+            handle.remove()
+        self.handles.clear()
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        self.close()
